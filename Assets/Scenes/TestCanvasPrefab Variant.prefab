  m_Script: {fileID: 11500000, guid: d55f5c518853ddf46b250b913986e217, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  questions:
  - question: "\u041A\u0430\u043A\u0430\u044F \u0438\u0437 \u0441\u0438\u0441\u0442\u0435\u043C
      \u043D\u0430\u043B\u043E\u0433\u043E\u043E\u0431\u043B\u043E\u0436\u0435\u043D\u0438\u044F
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0434\u043B\u044F \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u044B\u0445
      \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u0435\u0439?"
    answers:
    - "A. \u0423\u0421\u041D"
    - "B. \u041E\u0421\u041D"
    - "C. \u041F\u0421\u041D"
    - "D. \u0415\u0421\u0425\u041D"
    comment: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
      C\\n\u041F\u0421\u041D (\u043F\u0430\u0442\u0435\u043D\u0442\u043D\u0430\u044F
      \u0441\u0438\u0441\u0442\u0435\u043C\u0430) \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430
      \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043B\u044F \u0418\u041F \u0438
