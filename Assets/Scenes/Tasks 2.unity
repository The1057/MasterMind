      propertyPath: 'questions.Array.data[0].answers.Array.data[0]'
      value: "A. \u0417\u0430\u043D\u044F\u0442\u0438\u0435 \u0431\u0438\u0437\u043D\u0435\u0441\u043E\u043C
        \u0440\u0430\u0434\u0438 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F
        \u0434\u043E\u0445\u043E\u0434\u0430"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: 'questions.Array.data[0].answers.Array.data[1]'
      value: "B. \u0421\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u0430\u044F
        \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C,
        \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u0430\u044F \u0441 \u043F\u0440\u0438\u043D\u044F\u0442\u0438\u0435\u043C
        \u0440\u0438\u0441\u043A\u043E\u0432 \u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u0430\u044F
        \u043D\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435
        \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0435 \u043F\u0440\u0438\u0431\u044B\u043B\u0438"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: 'questions.Array.data[0].answers.Array.data[2]'
      value: "C. \u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043A\u0440\u0443\u043F\u043D\u043E\u0439
