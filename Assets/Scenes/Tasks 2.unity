    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[0].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n\u0412 \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0435 \u0430\u0440\u0435\u043D\u0434\u044B
        \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442\u0441\u044F
        \u0430\u0434\u0440\u0435\u0441, \u043F\u043B\u043E\u0449\u0430\u0434\u044C
        \u0438 \u0441\u0440\u043E\u043A \u0430\u0440\u0435\u043D\u0434\u044B, \u0438\u043D\u0430\u0447\u0435
        \u0434\u043E\u0433\u043E\u0432\u043E\u0440 \u043D\u0435 \u0437\u0430\u043A\u043B\u044E\u0447\u0451\u043D.
        \u0423\u0441\u043B\u043E\u0432\u0438\u044F \u043E\u043F\u043B\u0430\u0442\u044B
        \u0442\u0430\u043A\u0436\u0435 \u0432\u0430\u0436\u043D\u044B"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[1].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        A \\n\u0414\u043E\u0433\u043E\u0432\u043E\u0440 \u0431\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440\u0441\u043A\u043E\u0433\u043E
        \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F
        \u0434\u043E\u043B\u0436\u0435\u043D \u0432\u043A\u043B\u044E\u0447\u0430\u0442\u044C
        \u043F\u0435\u0440\u0435\u0447\u0435\u043D\u044C \u0443\u0441\u043B\u0443\u0433
        (\u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u0443\u0447\u0451\u0442\u0430,
        \u0441\u0434\u0430\u0447\u0430 \u043E\u0442\u0447\u0451\u0442\u043D\u043E\u0441\u0442\u0438)
        \u0438 \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C
        \u0437\u0430 \u043E\u0448\u0438\u0431\u043A\u0438"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[2].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        C \\n\u0414\u043E\u0433\u043E\u0432\u043E\u0440 \u0430\u0440\u0435\u043D\u0434\u044B
        \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F \u043D\u0430 \u0441\u0440\u043E\u043A
        \u0431\u043E\u043B\u0435\u0435 1 \u0433\u043E\u0434\u0430 \u043F\u043E\u0434\u043B\u0435\u0436\u0438\u0442
        \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438 \u0432
