      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: 'questions.Array.data[0].answers.Array.data[3]'
      value: "D. \u041E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u0430\u044F
        \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044F \u0431\u0438\u0437\u043D\u0435\u0441\u0430"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: 'questions.Array.data[1].answers.Array.data[0]'
      value: "A. \u0427\u0435\u043B\u043E\u0432\u0435\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
        \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442 \u043A\u0440\u0443\u043F\u043D\u044B\u043C
        \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u0435\u043C"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: 'questions.Array.data[1].answers.Array.data[1]'
      value: "B. \u041B\u0438\u0446\u043E, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
        \u0432\u0435\u0434\u0435\u0442 \u0431\u0438\u0437\u043D\u0435\u0441 \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E,
        \u043E\u0442\u0432\u0435\u0447\u0430\u044F \u0441\u0432\u043E\u0438\u043C
        \u043B\u0438\u0447\u043D\u044B\u043C \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u043C"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: 'questions.Array.data[1].answers.Array.data[2]'
      value: "C. \u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u044F,
        \u0438\u043C\u0435\u044E\u0449\u0430\u044F \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
