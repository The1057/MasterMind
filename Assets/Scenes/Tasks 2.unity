  m_text: "\u041D\u0430\u043B\u043E\u0433\u0438 \u2014 \u0432\u0430\u0436\u043D\u0430\u044F
    \u0447\u0430\u0441\u0442\u044C \u0431\u0438\u0437\u043D\u0435\u0441\u0430. \u0423\u0421\u041D,
