--- !u!114 &770922542
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 770922540}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\n\n> \u041F\u0440\u0435\u0434\u043C\u0435\u0442: \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435
    \u0430\u0440\u0435\u043D\u0434\u0443\u0435\u043C\u043E\u0433\u043E \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F
    \n(\u0430\u0434\u0440\u0435\u0441, \u043F\u043B\u043E\u0449\u0430\u0434\u044C).\r\n\r\n>
    \u0421\u0440\u043E\u043A \u0430\u0440\u0435\u043D\u0434\u044B: \u043A\u0440\u0430\u0442\u043A\u043E\u0441\u0440\u043E\u0447\u043D\u044B\u0439
    (\u0434\u043E 1 \u0433\u043E\u0434\u0430) \u0438\u043B\u0438 \u0434\u043E\u043B\u0433\u043E\u0441\u0440\u043E\u0447\u043D\u044B\u0439
    (\u043E\u0442 1 \u0433\u043E\u0434\u0430).\r\n\r\n> \u0410\u0440\u0435\u043D\u0434\u043D\u0430\u044F
    \u043F\u043B\u0430\u0442\u0430: \u0441\u0443\u043C\u043C\u0430, \u0441\u0440\u043E\u043A\u0438
    \u043E\u043F\u043B\u0430\u0442\u044B, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
    \u043F\u0435\u0440\u0435\u0441\u043C\u043E\u0442\u0440\u0430.\r\n\r\n> \u041E\u0431\u044F\u0437\u0430\u043D\u043D\u043E\u0441\u0442\u0438
    \u0441\u0442\u043E\u0440\u043E\u043D: \u043A\u0442\u043E \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442
    \u0437\u0430 \u0440\u0435\u043C\u043E\u043D\u0442, \u043A\u043E\u043C\u043C\u0443\u043D\u0430\u043B\u044C\u043D\u044B\u0435
    \u043F\u043B\u0430\u0442\u0435\u0436\u0438.\n\n> \u0423\u0441\u043B\u043E\u0432\u0438\u044F
    \u0440\u0430\u0441\u0442\u043E\u0440\u0436\u0435\u043D\u0438\u044F: \u0448\u0442\u0440\u0430\u0444\u044B,
    \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u044F.\n\n> \u041E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
    \u043F\u043B\u0430\u0442\u0435\u0436: \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u044F
    \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432.\r\n\u0414\u043E\u0433\u043E\u0432\u043E\u0440
    \u0430\u0440\u0435\u043D\u0434\u044B \u0431\u043E\u043B\u0435\u0435 1 \u0433\u043E\u0434\u0430
    \u043F\u043E\u0434\u043B\u0435\u0436\u0438\u0442 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438
    \u0432 \u0420\u043E\u0441\u0440\u0435\u0435\u0441\u0442\u0440\u0435."
