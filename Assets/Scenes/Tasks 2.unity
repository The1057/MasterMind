  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\r\r\n\n> \u041B\u0435\u0433\u0430\u043B\u044C\u043D\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430,
    \u0434\u043E\u0432\u0435\u0440\u0438\u0435 \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432,
    \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \u0442\u0435\u043D\u0434\u0435\u0440\u0430\u0445.\r\n\u0412\u044B\u0441\u043E\u043A\u0438\u0435
    \u0440\u0430\u0441\u0445\u043E\u0434\u044B, \u0440\u0438\u0441\u043A \u0430\u043D\u043D\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
    \u043F\u0440\u0438 \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u044F\u0445.\r\r\n\n>
    \u0412\u044B\u0431\u043E\u0440 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0445
    \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0439 \u0438 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0439
    \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044C
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C \u0441 \u0437\u0430\u043A\u043E\u043D\u043E\u043C
    \u0438 \u0432\u0435\u0441\u0442\u0438 \u0431\u0438\u0437\u043D\u0435\u0441 \u0437\u0430\u043A\u043E\u043D\u043D\u043E.\n\n"
  m_isRightToLeft: 0
