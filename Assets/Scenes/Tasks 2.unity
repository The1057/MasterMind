  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \u041C\u0430\u0440\u043A\u0435\u0442\u0438\u043D\u0433 \u2014 \u044D\u0442\u043E
    \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441 \u043C\u0435\u0440\u043E\u043F\u0440\u0438\u044F\u0442\u0438\u0439,
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0445 \n\u043D\u0430
    \u0438\u0437\u0443\u0447\u0435\u043D\u0438\u0435 \u043F\u043E\u0442\u0440\u0435\u0431\u043D\u043E\u0441\u0442\u0435\u0439
    \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432, \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435
    \u0438 \u043F\u0440\u043E\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u0442\u043E\u0432\u0430\u0440\u0430.
    \u042D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0430\u044F \u043C\u0430\u0440\u043A\u0435\u0442\u0438\u043D\u0433\u043E\u0432\u0430\u044F
    \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044F \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442
    \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0442\u044C \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432,
    \u043F\u043E\u0432\u044B\u0448\u0430\u0442\u044C \u043F\u0440\u043E\u0434\u0430\u0436\u0438
    \u0438 \u0443\u043A\u0440\u0435\u043F\u043B\u044F\u0442\u044C \u043F\u043E\u0437\u0438\u0446\u0438\u0438
    \u043D\u0430 \u0440\u044B\u043D\u043A\u0435. \n\n   \u0420\u0435\u043A\u043B\u0430\u043C\u0430
    \u2014 \u044D\u0442\u043E \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442
    \u043C\u0430\u0440\u043A\u0435\u0442\u0438\u043D\u0433\u0430 \u0434\u043B\u044F
    \u0438\u043D\u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
    \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u0435\u0439."
