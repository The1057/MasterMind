    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[2].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n\u041E\u041E\u041E, \u043A\u0430\u043A \u044E\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043A\u043E\u0435
        \u043B\u0438\u0446\u043E, \u0443\u0434\u043E\u0431\u043D\u043E \u0434\u043B\u044F
        \u043F\u0440\u043E\u0434\u0430\u0436\u0438 \u0434\u043E\u043B\u0435\u0439
        \u0438 \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u043E\u0432.
        \u0418\u041F \u043C\u043E\u0436\u0435\u0442 \u0437\u0430\u043A\u043B\u044E\u0447\u0430\u0442\u044C
        \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u044B, \u043D\u043E \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D
        \u0432 \u0438\u043D\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u044F\u0445."
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[4].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        A, C \u0423\u0421\u041D (\u0443\u043F\u0440\u043E\u0449\u0435\u043D\u043D\u0430\u044F
        \u0441\u0438\u0441\u0442\u0435\u043C\u0430) \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
        \u0434\u043B\u044F \u043C\u0430\u043B\u043E\u0433\u043E \u0431\u0438\u0437\u043D\u0435\u0441\u0430,
        \u0442\u0430\u043A \u043A\u0430\u043A \u043E\u043D\u0438 \u0441\u043D\u0438\u0436\u0430\u0435\u0442
        \u043D\u0430\u043B\u043E\u0433\u043E\u0432\u0443\u044E \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0443 
        \u0438 \u0443\u043F\u0440\u043E\u0449\u0430\u0435\u0442 \u043E\u0442\u0447\u0435\u0442\u043D\u043E\u0441\u0442\u044C. 
        \u041E\u0421\u041D\u041E \u2014 \u0441\u043B\u043E\u0436\u043D\u0430\u044F
        \u0441\u0438\u0441\u0442\u0435\u043C\u0430, \u0442\u0440\u0435\u0431\u0443\u044E\u0449\u0430\u044F
        \u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0431\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440\u0438\u0438. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[6].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        D \\n\u0414\u043B\u044F \u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0439,
        \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u043E\u0439 \u0438
        \u043E\u0445\u0440\u0430\u043D\u043D\u043E\u0439 \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
        \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u044F, 
        \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0432\u044B\u0434\u0430\u0435\u0442\u0441\u044F
        \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u043C\u0438 
        \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C\u0438
        \u043E\u0440\u0433\u0430\u043D\u0430\u043C\u0438. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[7].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        A \\n\u0420\u0430\u0441\u0447\u0451\u0442\u043D\u044B\u0439 \u0441\u0447\u0451\u0442
        \u043D\u0443\u0436\u0435\u043D \u0434\u043B\u044F \u0431\u0435\u0437\u043D\u0430\u043B\u0438\u0447\u043D\u044B\u0445
        \u0440\u0430\u0441\u0447\u0451\u0442\u043E\u0432 \u0438 \u0443\u043F\u043B\u0430\u0442\u044B
        \u043D\u0430\u043B\u043E\u0433\u043E\u0432. \u0414\u043B\u044F \u041E\u041E\u041E
        \u043E\u043D \u0444\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438
        \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C, \u0434\u043B\u044F
        \u0418\u041F \u2014 \u0436\u0435\u043B\u0430\u0442\u0435\u043B\u0435\u043D."
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[8].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n\u0423\u0441\u0442\u0430\u0432 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442
        \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
        \u041E\u041E\u041E \u0438 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u0435\u043D
        \u0434\u043B\u044F \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438
        (\u0441\u0442. 12 \u0424\u0435\u0434\u0435\u0440\u0430\u043B\u044C\u043D\u043E\u0433\u043E
        \u0437\u0430\u043A\u043E\u043D\u0430 \u2116 14-\u0424\u0417), \u0442\u0430\u043A\u0436\u0435
        \u043D\u0443\u0436\u043D\u044B \u0437\u0430\u044F\u0432\u043B\u0435\u043D\u0438\u0435
        (P11001) \u0438 \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u043E \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0438."
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[9].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        D \\n\u041F\u0440\u0438 \u043D\u0430\u0439\u043C\u0435 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432
        \u0418\u041F \u0438\u043B\u0438 \u041E\u041E\u041E \u043E\u0431\u044F\u0437\u0430\u043D\u044B
        \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C\u0441\u044F
        \u0432 \u0421\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u043C \u0444\u043E\u043D\u0434\u0435
        \u0420\u0424 (\u0421\u0424\u0420, \u0441\u0442. 6 \u2116 167-\u0424\u0417)
        \u0438 \u043F\u043E\u0434\u0430\u0442\u044C \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F
        \u043E \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430\u0445
        \u0434\u043B\u044F \u0443\u043F\u043B\u0430\u0442\u044B \u0441\u0442\u0440\u0430\u0445\u043E\u0432\u044B\u0445
        \u0432\u0437\u043D\u043E\u0441\u043E\u0432"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[2].question
      value: "\u041A\u0430\u043A\u0430\u044F \u0444\u043E\u0440\u043C\u0430 \u0431\u0438\u0437\u043D\u0435\u0441\u0430
        \u043D\u0430\u0438\u0431\u043E\u043B\u0435\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
        \u0434\u043B\u044F \u043F\u0440\u0438\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u044F
        \u0438\u043D\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u0439 (\u0447\u0435\u0440\u0435\u0437
        \u043F\u0440\u043E\u0434\u0430\u0436\u0443 \u0434\u043E\u043B\u0435\u0439)
        \u0438 \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u043E\u0432?"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[4].question
      value: "\u041A\u0430\u043A\u0438\u0435 \u0438\u0437 \u043F\u0435\u0440\u0435\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u044B\u0445
        \u0441\u0438\u0441\u0442\u0435\u043C \u043D\u0430\u043B\u043E\u0433\u043E\u043E\u0431\u043B\u043E\u0436\u0435\u043D\u0438\u044F
        \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0434\u043B\u044F \u043C\u0430\u043B\u043E\u0433\u043E
        \u0431\u0438\u0437\u043D\u0435\u0441\u0430? "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[5].question
      value: "\u041A\u0430\u043A\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430
        \u043D\u0430\u043B\u043E\u0433\u043E\u043E\u0431\u043B\u043E\u0436\u0435\u043D\u0438\u044F
        \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u0430
        \u0434\u043B\u044F \u0431\u0438\u0437\u043D\u0435\u0441\u0430 \u0441 \u0431\u043E\u043B\u044C\u0448\u0438\u043C\u0438
        \u0440\u0430\u0441\u0445\u043E\u0434\u0430\u043C\u0438?"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[8].question
      value: "\u041A\u0430\u043A\u043E\u0439 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442
        \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u0435\u043D \u0434\u043B\u044F
        \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438 \u041E\u041E\u041E?"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[9].question
      value: "\u041A\u0430\u043A\u0438\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
        \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B \u0434\u043B\u044F
        \u0443\u043F\u043B\u0430\u0442\u044B \u0441\u0442\u0440\u0430\u0445\u043E\u0432\u044B\u0445
        \u0432\u0437\u043D\u043E\u0441\u043E\u0432 \u043F\u0440\u0438 \u043D\u0430\u0439\u043C\u0435
        \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432?"
