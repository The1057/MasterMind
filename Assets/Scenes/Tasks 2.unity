  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u042E\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u043B\u0438\u0446\u043E
    \u2014 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u044F \u0441
    \u043E\u0431\u043E\u0441\u043E\u0431\u043B\u0435\u043D\u043D\u044B\u043C \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u043C,
    \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u043C
    \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u043E\u043C \u0438 \u043F\u0440\u0430\u0432\u043E\u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C\u044E,
    \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0430\u044F \u043E\u0442
    \u0441\u0432\u043E\u0435\u0433\u043E \u0438\u043C\u0435\u043D\u0438 (\u0441\u0442.
    48 \u0413\u041A \u0420\u0424). \n\n\u041E\u041E\u041E \u2014 \u044E\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u043B\u0438\u0446\u043E, \u0432 \u043E\u0442\u043B\u0438\u0447\u0438\u0435 \u043E\u0442
    \u0418\u041F, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043B\u0438\u0446\u043E\u043C
    \u0441 \u043E\u0441\u043E\u0431\u044B\u043C \u0441\u0442\u0430\u0442\u0443\u0441\u043E\u043C"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6d9ad1c49cfdf504faddd7afd3ceae86, type: 2}
  m_sharedMaterial: {fileID: 7286569816844298882, guid: 6d9ad1c49cfdf504faddd7afd3ceae86, type: 2}
