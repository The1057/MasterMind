    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: 'questions.Array.data[2].answers.Array.data[2]'
      value: "C. \u0418\u041F \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u0441\u0432\u043E\u0438\u043C
