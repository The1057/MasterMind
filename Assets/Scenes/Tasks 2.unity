    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[8].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n\u0414\u043E\u0433\u043E\u0432\u043E\u0440 \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u0438
        \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u0435\u0442 \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0443
        \u0442\u043E\u0432\u0430\u0440\u043E\u0432, \u0430 \u0430\u0440\u0435\u043D\u0434\u0430
        \u2014 \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0435 \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
        \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u043C"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[9].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n\u0414\u043E\u0433\u043E\u0432\u043E\u0440 \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u0438
        \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442 \u0430\u0441\u0441\u043E\u0440\u0442\u0438\u043C\u0435\u043D\u0442,
        \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E, \u0441\u0440\u043E\u043A\u0438
        \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u0438 \u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u044F
        \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u0430 \u0431\u0440\u0430\u043A\u0430"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[0].question
      value: "\u0427\u0442\u043E \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
        \u0443\u043A\u0430\u0437\u0430\u0442\u044C \u0432 \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0435
        \u0430\u0440\u0435\u043D\u0434\u044B \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F?"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[1].question
      value: "\u041A\u0430\u043A\u043E\u0439 \u0438\u0437 \u044D\u0442\u0438\u0445
        \u043F\u0443\u043D\u043A\u0442\u043E\u0432 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E
        \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u0442\u044C \u0432 \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0435
        \u0431\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440\u0441\u043A\u043E\u0433\u043E
        \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F?"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[2].question
      value: "\u041A\u0430\u043A\u043E\u0439 \u0441\u0440\u043E\u043A \u0430\u0440\u0435\u043D\u0434\u044B
        \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F \u0442\u0440\u0435\u0431\u0443\u0435\u0442
        \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
        \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438 \u0432
        \u0420\u043E\u0441\u0440\u0435\u0435\u0441\u0442\u0440\u0435?"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[3].question
      value: "\u041A\u0430\u043A\u0438\u0435 \u0443\u0441\u043B\u043E\u0432\u0438\u044F
        \u0432\u043A\u043B\u044E\u0447\u0430\u044E\u0442\u0441\u044F \u0432 \u0434\u043E\u0433\u043E\u0432\u043E\u0440
        \u0441 \u043E\u0445\u0440\u0430\u043D\u043D\u043E\u0439 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0435\u0439?"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[4].question
      value: "\u0412 \u043A\u0430\u043A\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u0435
