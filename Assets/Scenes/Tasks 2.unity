    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: 'questions.Array.data[2].answers.Array.data[1]'
      value: "B. \u0418\u041F \u0438 \u041E\u041E\u041E \u043D\u0435\u0441\u0443\u0442
        \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u0443\u044E \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C
        \u0437\u0430 \u0434\u043E\u043B\u0433\u0438 \u0438 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
