      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: 'questions.Array.data[1].answers.Array.data[3]'
      value: "D. \u0420\u0430\u0431\u043E\u0442\u043D\u0438\u043A, \u043D\u0430\u043D\u044F\u0442\u044B\u0439
        \u0434\u0440\u0443\u0433\u0438\u043C \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u0435\u043C"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: 'questions.Array.data[2].answers.Array.data[0]'
      value: "A. \u0418\u041F \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
        \u0443\u0441\u0442\u0430\u0432\u043D\u044B\u043C \u043A\u0430\u043F\u0438\u0442\u0430\u043B\u043E\u043C,
        \u0430 \u041E\u041E\u041E - \u0441\u0432\u043E\u0438\u043C \u043B\u0438\u0447\u043D\u044B\u043C
        \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u043C"
