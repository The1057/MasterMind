  m_text: "    \u041F\u0440\u043E\u0432\u0435\u0440\u044F\u044F \u043F\u043E\u0447\u0442\u0443,
    \u0432\u044B \u043D\u0430\u0442\u043A\u043D\u0443\u043B\u0438\u0441\u044C \u043D\u0430
    \u043E\u0447\u0435\u043D\u044C \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u0435
    \u043F\u0438\u0441\u044C\u043C\u043E. \u0422\u0430\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u043C\u0438\u0441\u0442\u0435\u0440 Neo \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442
    \u0432\u0430\u043C \u043A\u0440\u0443\u043F\u043D\u0443\u044E \u0441\u0443\u043C\u043C\u0443,
    \u0436\u0435\u043B\u0430\u044F \u0438\u043D\u0432\u0435\u0441\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0432 \u0432\u0430\u0448 \u0431\u0438\u0437\u043D\u0435\u0441.\n\n   \u041A\u0442\u043E
    \u043C\u043E\u0433 \u0443\u0437\u043D\u0430\u0442\u044C \u043E \u0432\u0430\u0448\u0435\u0439
    \u0434\u0430\u0432\u043D\u0435\u0439 \u043C\u0435\u0447\u0442\u0435? \u0412\u0434\u0440\u0443\u0433
    \u0438\u0437 \u043A\u043E\u043D\u0432\u0435\u0440\u0442\u0430 \u0432\u044B\u043F\u0430\u043B\u0430 
    \u0431\u0430\u043D\u043A\u043E\u0432\u0441\u043A\u0430\u044F \u043A\u0430\u0440\u0442\u0430."
