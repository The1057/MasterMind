  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0414\u0432\u0435 \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0435 \u043E\u0431\u043B\u0430\u0441\u0442\u0438
    \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0438:\n\r\n   \u041C\u0430\u043A\u0440\u043E\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0430
    \u0438\u0437\u0443\u0447\u0430\u0435\u0442 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0443
    \u0441\u0442\u0440\u0430\u043D\u044B \u0432 \u0446\u0435\u043B\u043E\u043C, \u0430\u043D\u0430\u043B\u0438\u0437\u0438\u0440\u0443\u044F
    \u0438\u043D\u0444\u043B\u044F\u0446\u0438\u044E, \u0431\u0435\u0437\u0440\u0430\u0431\u043E\u0442\u0438\u0446\u0443,
    \u0412\u0412\u041F \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u0433\u043B\u043E\u0431\u0430\u043B\u044C\u043D\u044B\u0435
    \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0438.\r\n   \u041C\u0438\u043A\u0440\u043E\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0430
    \u0444\u043E\u043A\u0443\u0441\u0438\u0440\u0443\u0435\u0442\u0441\u044F \u043D\u0430
    \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0438 \u043F\u043E\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043B\u0435\u0439
    \u0438 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0439, \u0438\u0441\u0441\u043B\u0435\u0434\u0443\u044F
    \u0446\u0435\u043D\u043E\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435,
    \u0441\u043F\u0440\u043E\u0441 \n\u0438 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435.\r\n\r\n"
