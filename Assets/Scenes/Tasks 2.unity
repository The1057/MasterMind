    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[1].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n\u0412 \u0423\u0421\u041D 15% \u043D\u0430\u043B\u043E\u0433 \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F
        \u0441 \u0440\u0430\u0437\u043D\u0438\u0446\u044B \u043C\u0435\u0436\u0434\u0443
        \u0434\u043E\u0445\u043E\u0434\u0430\u043C\u0438 \u0438 \u0440\u0430\u0441\u0445\u043E\u0434\u0430\u043C\u0438,
        \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0443\u0447\u0435\u0442 \u0440\u0430\u0441\u0445\u043E\u0434\u043E\u0432
        \u0438\u0433\u0440\u0430\u0435\u0442 \u0432\u0430\u0436\u043D\u0443\u044E
        \u0440\u043E\u043B\u044C"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[2].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        C \\n\u0432 2024 \u0433\u043E\u0434\u0443 \u043B\u0438\u043C\u0438\u0442
        \u0434\u043B\u044F \u041F\u0421\u041D \u0431\u044B\u043B \u043F\u0440\u043E\u0438\u043D\u0434\u0435\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D
        \u0434\u043E 81,39 \u043C\u043B\u043D \u0440\u0443\u0431\u043B\u0435\u0439
        (\u0441 \u0443\u0447\u0451\u0442\u043E\u043C \u043A\u043E\u044D\u0444\u0444\u0438\u0446\u0438\u0435\u043D\u0442\u0430-\u0434\u0435\u0444\u043B\u044F\u0442\u043E\u0440\u0430).
        \u041F\u0440\u0438 \u043F\u0440\u0435\u0432\u044B\u0448\u0435\u043D\u0438\u0438
        \u043D\u0443\u0436\u043D\u043E \u0432\u044B\u0431\u0440\u0430\u0442\u044C
        \u0434\u0440\u0443\u0433\u043E\u0439 \u043D\u0430\u043B\u043E\u0433\u043E\u0432\u044B\u0439
        \u0440\u0435\u0436\u0438\u043C."
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[3].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        C\\n\u041D\u0430 \u041E\u0421\u041D \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438
        \u043F\u043B\u0430\u0442\u044F\u0442 \u041D\u0414\u0421 (10% \u0438\u043B\u0438
        20%), \u043D\u0430\u043B\u043E\u0433 \u043D\u0430 \u043F\u0440\u0438\u0431\u044B\u043B\u044C
        (20%) \u0438\u043B\u0438 \u041D\u0414\u0424\u041B (13%) \u0434\u043B\u044F
        \u0418\u041F, \u0430 \u0442\u0430\u043A\u0436\u0435 \u0434\u0440\u0443\u0433\u0438\u0435
        \u043D\u0430\u043B\u043E\u0433\u0438"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[4].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        A\\n\u041B\u0438\u043C\u0438\u0442 \u0447\u0438\u0441\u043B\u0435\u043D\u043D\u043E\u0441\u0442\u0438
        \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432 \u043F\u0440\u0438
        \u0423\u0421\u041D \u2014 130 \u0447\u0435\u043B\u043E\u0432\u0435\u043A.
        \u0415\u0441\u043B\u0438 \u0438\u0445 \u0431\u043E\u043B\u044C\u0448\u0435,
        \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u043F\u0435\u0440\u0435\u0439\u0442\u0438
        \u043D\u0430 \u041E\u0421\u041D"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[5].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n\u041F\u0440\u0438 \u0432\u044B\u0441\u043E\u043A\u0438\u0445 \u0440\u0430\u0441\u0445\u043E\u0434\u0430\u0445
        \u0432\u044B\u0433\u043E\u0434\u043D\u0435\u0435 \u0423\u0421\u041D 15%,
        \u0442\u0430\u043A \u043A\u0430\u043A \u043D\u0430\u043B\u043E\u0433 \u043D\u0430\u0447\u0438\u0441\u043B\u044F\u0435\u0442\u0441\u044F
        \u043D\u0430 \u0440\u0430\u0437\u043D\u0438\u0446\u0443 \u043C\u0435\u0436\u0434\u0443
        \u0434\u043E\u0445\u043E\u0434\u0430\u043C\u0438 \u0438 \u0440\u0430\u0441\u0445\u043E\u0434\u0430\u043C\u0438"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[6].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        D \\n\u0415\u0421\u0425\u041D \u2014 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439
        \u0440\u0435\u0436\u0438\u043C \u0434\u043B\u044F \u0441\u0435\u043B\u044C\u0441\u043A\u043E\u0433\u043E
        \u0445\u043E\u0437\u044F\u0439\u0441\u0442\u0432\u0430, \u0435\u0441\u043B\u0438
        \u043D\u0435 \u043C\u0435\u043D\u0435\u0435 70% \u0434\u043E\u0445\u043E\u0434\u043E\u0432
        \u0441\u0432\u044F\u0437\u0430\u043D\u044B \u0441 \u0430\u0433\u0440\u043E\u0431\u0438\u0437\u043D\u0435\u0441\u043E\u043C"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[7].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        A, D \\n\u041F\u0440\u0438 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0445
        \u0440\u0430\u0441\u0445\u043E\u0434\u0430\u0445 \u0443\u0434\u043E\u0431\u043D\u0435\u0435
        \u0423\u0421\u041D 6%, \u043D\u043E \u043A\u0430\u0444\u0435 \u043C\u043E\u0436\u0435\u0442
        \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0442\u044C \u0438 \u041F\u0421\u041D,
        \u0435\u0441\u043B\u0438 \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
        \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0430 \u0440\u0435\u0433\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u043C\u0438
        \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u043C\u0438"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[8].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        A \\n\u0423\u0421\u041D 6% \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
        \u0434\u043B\u044F \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442-\u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430
        \u0441 \u043D\u0438\u0437\u043A\u0438\u043C\u0438 \u0440\u0430\u0441\u0445\u043E\u0434\u0430\u043C\u0438
        (\u0441\u0442. 346.20 \u041D\u041A \u0420\u0424). \u041F\u0421\u041D \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u0430,
        \u0435\u0441\u043B\u0438 \u0440\u043E\u0437\u043D\u0438\u0446\u0430 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0430
        \u0440\u0435\u0433\u0438\u043E\u043D\u043E\u043C"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[9].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
