  m_text: "\n\n> \u0426\u0435\u043D\u044B \u0441 \"9\" \u0432 \u043A\u043E\u043D\u0446\u0435
    (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, 999 \u0440\u0443\u0431\u043B\u0435\u0439)
    \u0441\u043E\u0437\u0434\u0430\u044E\u0442 \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435
