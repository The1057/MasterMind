--- !u!114 &561746974
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 561746972}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\n\r1, 4P (Marketing Mix):\n\n> Product (\u041F\u0440\u043E\u0434\u0443\u043A\u0442):
    \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E, \u0443\u043F\u0430\u043A\u043E\u0432\u043A\u0430,
    \u0431\u0440\u0435\u043D\u0434.\r\n\r\n> Price (\u0426\u0435\u043D\u0430): \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0438
    \u0446\u0435\u043D\u043E\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044F,
    \u0441\u043A\u0438\u0434\u043A\u0438.\r\n\r\n> Place (\u041C\u0435\u0441\u0442\u043E
    \u043F\u0440\u043E\u0434\u0430\u0436): \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u044B,
    \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442.\r\n\r\n> Promotion (\u041F\u0440\u043E\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435):
    \u0440\u0435\u043A\u043B\u0430\u043C\u0430, \u0430\u043A\u0446\u0438\u0438.\r\n\n\n2.
    7P (\u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u0438\u0435)\n\n> People
    (\u041B\u044E\u0434\u0438): \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B
    \u0438 \u0441\u0435\u0440\u0432\u0438\u0441.\r\n\n> Process (\u041F\u0440\u043E\u0446\u0435\u0441\u0441):
    \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u0435 \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432.\r\n\n>
    Physical Evidence (\u0424\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u0435): \u043E\u0444\u043E\u0440\u043C\u043B\u0435\u043D\u0438\u0435
    \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430, \u0443\u043F\u0430\u043A\u043E\u0432\u043A\u0430."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6d9ad1c49cfdf504faddd7afd3ceae86, type: 2}
  m_sharedMaterial: {fileID: 7286569816844298882, guid: 6d9ad1c49cfdf504faddd7afd3ceae86, type: 2}
