  m_text: "   \n     \r\n>   \u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u043E\u0441\u0442\u044C
    \u0431\u0438\u0437\u043D\u0435\u0441\u0430 \u0438 \u043E\u0442\u0447\u0451\u0442\u043D\u043E\u0441\u0442\u044C;\r\n>  
    \u0446\u0435\u043B\u0435\u0432\u043E\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    \u0441\u0440\u0435\u0434\u0441\u0442\u0432;\r\n>   \u0441\u043E\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435
    \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445 \u0438 \u044D\u043A\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u0439;\r\n>   \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435
    \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u0439 (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u043D\u0435\u0443\u043F\u043B\u0430\u0442\u0430 \u043D\u0430\u043B\u043E\u0433\u043E\u0432).\n"
