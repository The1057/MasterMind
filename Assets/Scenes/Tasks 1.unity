  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n> \u0418\u043C\u043F\u043E\u0440\u0442\u043D\u044B\u0435 (\u0432\u0432\u043E\u0437\u043D\u044B\u0435)
    \u2013 \u0441\u0430\u043C\u044B\u0435 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u043D\u044B\u0435,
    \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F \u043A \u0442\u043E\u0432\u0430\u0440\u0430\u043C,
    \u0432\u0432\u043E\u0437\u0438\u043C\u044B\u043C \u0432 \u0441\u0442\u0440\u0430\u043D\u0443.\r\r\r\n>
    \u042D\u043A\u0441\u043F\u043E\u0440\u0442\u043D\u044B\u0435 (\u0432\u044B\u0432\u043E\u0437\u043D\u044B\u0435)
    \u2013 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0442\u0441\u044F \u0440\u0435\u0436\u0435,
    \u043E\u0431\u044B\u0447\u043D\u043E \u043D\u0430 \u0441\u044B\u0440\u044C\u0435
    (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u043D\u0435\u0444\u0442\u044C,
    \u0433\u0430\u0437, \u043B\u0435\u0441). \r\n\r\r> \u0422\u0440\u0430\u043D\u0437\u0438\u0442\u043D\u044B\u0435
    \u2013 \u0437\u0430 \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0435
    \u0442\u043E\u0432\u0430\u0440\u043E\u0432 \u0447\u0435\u0440\u0435\u0437 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u044E
    \u0441\u0442\u0440\u0430\u043D\u044B \n(\u0432 \u0420\u0424 \u0441\u0435\u0439\u0447\u0430\u0441
    \u043D\u0435 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F).\r\r\n"
  m_isRightToLeft: 0
