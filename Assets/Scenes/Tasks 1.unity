      m_Calls: []
  m_text: "   \n\n \u0426\u0438\u0444\u0440\u043E\u0432\u044B\u0435 \u0430\u043A\u0442\u0438\u0432\u044B
    (\u0431\u0438\u0442\u043A\u043E\u0439\u043D, \u044D\u0444\u0438\u0440 ).\r\n>
    \u041F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u2013
    \u0432\u044B\u0441\u043E\u043A\u0430\u044F \u0434\u043E\u0445\u043E\u0434\u043D\u043E\u0441\u0442\u044C
    \u0432 \u043F\u0435\u0440\u0438\u043E\u0434\u044B \u0440\u043E\u0441\u0442\u0430.\r\n>
    \u0420\u0438\u0441\u043A\u0438 \u2013 \u0441\u0438\u043B\u044C\u043D\u0430\u044F
    \u0432\u043E\u043B\u0430\u0442\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C
    \u0438 \u043D\u0435\u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E\u0441\u0442\u044C
    \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F.\r\n\r\n\r\n\n"
