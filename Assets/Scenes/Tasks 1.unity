  m_text: "\n\r\u0411\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E
    \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0439 \u0431\u0435\u0441\u0441\u0440\u043E\u0447\u043D\u044B\u0435,
