  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n> \u0420\u0438\u0441\u043A \u043F\u043E\u043A\u0430\u0437\u0443\u0445\u0438
    (virtue signaling). \u0415\u0441\u043B\u0438 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F
    \u0442\u0440\u0430\u0442\u0438\u0442 \u0434\u0435\u043D\u044C\u0433\u0438 \u043D\u0430
    \u043F\u0443\u0431\u043B\u0438\u0447\u043D\u044B\u0435 \u0430\u043A\u0446\u0438\u0438
    \u043F\u0440\u0438 \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
    \u044F\u0432\u043D\u044B\u0445 \u0432\u043D\u0443\u0442\u0440\u0438\u0444\u0438\u0440\u043C\u0435\u043D\u043D\u044B\u0445
    \u0438\u043B\u0438 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430\u0445 (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u043C\u0430\u0441\u0441\u043E\u0432\u044B\u0435 \u0443\u0432\u043E\u043B\u044C\u043D\u0435\u043D\u0438\u044F,
    \u0441\u043A\u0440\u044B\u0442\u044B\u0435 \u0434\u043E\u043B\u0433\u0438), \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C
    \u0438 \u0438\u0433\u0440\u043E\u043A\u0438 \u0432\u043E\u0441\u043F\u0440\u0438\u043C\u0443\u0442
    \u044D\u0442\u043E \u043A\u0430\u043A \xAB\u043F\u043E\u043A\u0430\u0437\u0443\u0445\u0443\xBB
    \u2013 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0439
    \u0443\u0449\u0435\u0440\u0431.\r\r\r\n> \u0410\u0443\u0442\u0435\u043D\u0442\u0438\u0447\u043D\u043E\u0441\u0442\u044C
    \u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C.
    \u0414\u043E\u043B\u0433\u043E\u0441\u0440\u043E\u0447\u043D\u044B\u0435, \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0435,
    \u043D\u043E \u0440\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u044B\u0435 \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435
    \u0438\u043D\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u044B \u043E\u0431\u044B\u0447\u043D\u043E
    \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442 \u043B\u0443\u0447\u0448\u0435
    \u043E\u0434\u043D\u043E\u0433\u043E \u0433\u0440\u043E\u043C\u043A\u043E\u0433\u043E
    \u0436\u0435\u0441\u0442\u0430.\r\n\r\r> \u041A\u0440\u0438\u0437\u0438\u0441\u043D\u0430\u044F
    \u043A\u043E\u043C\u043C\u0443\u043D\u0438\u043A\u0430\u0446\u0438\u044F. \u0412
    \u043A\u0440\u0438\u0437\u0438\u0441\u0435 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C:
    (1) \u0431\u044B\u0441\u0442\u0440\u043E\u0435 \u043F\u0440\u0438\u0437\u043D\u0430\u043D\u0438\u0435
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B; (2) \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0435
    \u043C\u0435\u0440 \u043F\u043E \u0435\u0451 \u0443\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u044E;
    (3) \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0438 \u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u044B\u0439
    \u043E\u0442\u0447\u0451\u0442; (4) \u043C\u043E\u043D\u0438\u0442\u043E\u0440\u0438\u043D\u0433
    \u0440\u0435\u0430\u043A\u0446\u0438\u0438. \u0417\u0430\u0442\u044F\u0433\u0438\u0432\u0430\u043D\u0438\u0435
    \u0438\u043B\u0438 \u043E\u0442\u0440\u0438\u0446\u0430\u043D\u0438\u0435 \u0443\u0441\u0443\u0433\u0443\u0431\u043B\u044F\u0435\u0442
    \u0443\u0449\u0435\u0440\u0431.\r\r\n\n"
