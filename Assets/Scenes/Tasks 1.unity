      m_Calls: []
  m_text: "      \n\n\n\u0421\u0442\u0430\u0432\u043A\u0430: 20% (\u0438\u0437 \u043D\u0438\u0445
    3% \u2013 \u0432 \u0444\u0435\u0434\u0435\u0440\u0430\u043B\u044C\u043D\u044B\u0439
    \u0431\u044E\u0434\u0436\u0435\u0442, 17% \u2013 \u0432 \u0440\u0435\u0433\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439)\n\n>
    \u042D\u0442\u043E\u0442 \u043D\u0430\u043B\u043E\u0433 \u0443\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \n\u0441 \u043F\u0440\u0438\u0431\u044B\u043B\u0438 \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u044F
    (\u0432\u044B\u0440\u0443\u0447\u043A\u0430 \u043C\u0438\u043D\u0443\u0441 \u0440\u0430\u0441\u0445\u043E\u0434\u044B).\r\n\r\n\u0424\u043E\u0440\u043C\u0443\u043B\u0430:\n\n>
    \u041D\u0430\u043B\u043E\u0433 = (\u0414\u043E\u0445\u043E\u0434\u044B \u2013
    \u0420\u0430\u0441\u0445\u043E\u0434\u044B) \xD7 20%\n\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6d9ad1c49cfdf504faddd7afd3ceae86, type: 2}
