  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n1. \u041A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E\u0441\u0442\u044C
    \u2014 \u043D\u0435 \"\u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0442\u044C
    \u043F\u0440\u043E\u0434\u0430\u0436\u0438\", \u0430 \"\u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0442\u044C
    \u043F\u0440\u043E\u0434\u0430\u0436\u0438 \u043D\u0430 15% \u0437\u0430 \u043A\u0432\u0430\u0440\u0442\u0430\u043B\". 
    \r\r\r\n2. \u0414\u043E\u0441\u0442\u0438\u0436\u0438\u043C\u043E\u0441\u0442\u044C
    \u2014 \u043D\u0435 \u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043D\u0435\u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0435
    \u0446\u0435\u043B\u0438.  \r\r\n3. \u041F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u043E\u0441\u0442\u044C
    \u2014 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A \u0434\u043E\u043B\u0436\u0435\u043D
    \u043F\u043E\u043D\u0438\u043C\u0430\u0442\u044C, \u043A\u0430\u043A \u0441\u0447\u0438\u0442\u0430\u044E\u0442\u0441\u044F
    \u0431\u0430\u043B\u043B\u044B.  \r\r\n\r\r4. \u0421\u0432\u044F\u0437\u044C
    \u0441 \u0432\u043E\u0437\u043D\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043D\u0438\u0435\u043C
    \u2014 \u043F\u0440\u0435\u043C\u0438\u0438, \u0431\u043E\u043D\u0443\u0441\u044B,
    \u043A\u0430\u0440\u044C\u0435\u0440\u043D\u044B\u0439 \u0440\u043E\u0441\u0442. 
    \r\n5. \u0413\u0438\u0431\u043A\u043E\u0441\u0442\u044C \u2014 \u043F\u0435\u0440\u0435\u0441\u043C\u043E\u0442\u0440
    KPI \u043F\u0440\u0438 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0438
    \u0431\u0438\u0437\u043D\u0435\u0441-\u0437\u0430\u0434\u0430\u0447.  \r"
