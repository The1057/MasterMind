  gameCanvas: {fileID: 1897335640}
  resultCanvas: {fileID: 207736291}
  resultText: {fileID: 1808289014}
  restartButton: {fileID: 1947849610}
  statements:
  - statement: "\u0411\u044B\u0441\u0442\u0440\u0430\u044F \u0438 \u043F\u0440\u043E\u0441\u0442\u0430\u044F
      \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044F"
    isTrue: 1
    correctForm: 1
    explanation: 
  - statement: "\u0414\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u043F\u043E\u0434\u0430\u0442\u044C
      \u0437\u0430\u044F\u0432\u043B\u0435\u043D\u0438\u0435"
    isTrue: 0
    correctForm: 1
    explanation: 
  - statement: "\u041C\u043E\u0436\u0435\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
      \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u0438\u043D \u0447\u0435\u043B\u043E\u0432\u0435\u043A"
    isTrue: 0
    correctForm: 1
    explanation: 
  - statement: "\u041E\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u043F\u043E \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430\u043C
      \u0441\u0432\u043E\u0438\u043C \u043B\u0438\u0447\u043D\u044B\u043C \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u043C"
    isTrue: 0
    correctForm: 1
    explanation: 
  - statement: "\u0414\u043E\u0441\u0442\u0443\u043F\u043D\u0430 \u0443\u043F\u0440\u043E\u0449\u0451\u043D\u043D\u0430\u044F
      \u0438 \u043F\u0430\u0442\u0435\u043D\u0442\u043D\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u044B
      \u043D\u0430\u043B\u043E\u0433\u043E\u043E\u0431\u043B\u043E\u0436\u0435\u043D\u0438\u044F"
    isTrue: 0
    correctForm: 1
    explanation: 
  - statement: "\u0421\u043B\u043E\u0436\u043D\u0435\u0435 \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0442\u044C
      \u0438\u043D\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u0438"
    isTrue: 0
    correctForm: 1
    explanation: 
  - statement: "\u041E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C
      \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0430 \u0443\u0441\u0442\u0430\u0432\u043D\u044B\u043C
      \u043A\u0430\u043F\u0438\u0442\u0430\u043B\u043E\u043C"
    isTrue: 0
    correctForm: 0
    explanation: 
  - statement: "\u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0434\u043E
      50 \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u043E\u0432"
    isTrue: 0
    correctForm: 0
    explanation: 
  - statement: "\u041D\u0443\u0436\u043D\u044B \u0443\u0447\u0440\u0435\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B"
    isTrue: 0
    correctForm: 0
    explanation: 
  - statement: "\u041E\u0431\u044F\u0437\u0430\u043D\u043D\u043E\u0441\u0442\u044C
      \u0432\u0435\u0441\u0442\u0438 \u0431\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440\u0438\u044E"
    isTrue: 0
    correctForm: 0
    explanation: 
  - statement: "\u041C\u043E\u0436\u0435\u0442 \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0442\u044C
      \u0438\u043D\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u0438 (\u0437\u0430\u0439\u043C\u044B,
      \u0433\u0440\u0430\u043D\u0442\u044B, \u043F\u0440\u043E\u0434\u0430\u0436\u0430
      \u0434\u043E\u043B\u0435\u0439)"
    isTrue: 0
    correctForm: 0
    explanation: 
  - statement: "\u042F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u044E\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043A\u0438\u043C
      \u043B\u0438\u0446\u043E\u043C"
    isTrue: 0
    correctForm: 0
    explanation: 
