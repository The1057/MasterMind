  m_text: "   \n\n\n\r> \u0420\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0442\u044C
    \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E (\u0433\u043E\u0434\u043E\u0432\u0430\u044F/\u043A\u0432\u0430\u0440\u0442\u0430\u043B\u044C\u043D\u0430\u044F
    \u043E\u0442\u0447\u0451\u0442\u043D\u043E\u0441\u0442\u044C, \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
    \u0444\u0430\u043A\u0442\u044B).\r\n> \u0421\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
    \u043C\u0435\u0436\u0434\u0443\u043D\u0430\u0440\u043E\u0434\u043D\u044B\u043C
    \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u0430\u043C \u043E\u0442\u0447\u0451\u0442\u043D\u043E\u0441\u0442\u0438
    (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, IFRS).\r\n> \u0421\u043E\u0437\u0434\u0430\u0442\u044C
    \u0441\u0438\u0441\u0442\u0435\u043C\u0443 \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u043E\u0433\u043E
    \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F (\u0441\u043E\u0432\u0435\u0442
    \u0434\u0438\u0440\u0435\u043A\u0442\u043E\u0440\u043E\u0432, \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u044B\u0435
    \u0434\u0438\u0440\u0435\u043A\u0442\u043E\u0440\u0430, \u043A\u043E\u043C\u0438\u0442\u0435\u0442\u044B).\r\n>
    \u0417\u0430\u0449\u0438\u0449\u0430\u0442\u044C \u043F\u0440\u0430\u0432\u0430
    \u0430\u043A\u0446\u0438\u043E\u043D\u0435\u0440\u043E\u0432 (\u0432 \u0442\u043E\u043C
    \u0447\u0438\u0441\u043B\u0435 \u043C\u0438\u043D\u043E\u0440\u0438\u0442\u0430\u0440\u0438\u0435\u0432).\r\n>
    \u041D\u0435\u0441\u0442\u0438 \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C
    \u0437\u0430 \u0434\u043E\u0441\u0442\u043E\u0432\u0435\u0440\u043D\u043E\u0441\u0442\u044C
    \u043E\u0442\u0447\u0451\u0442\u043D\u043E\u0441\u0442\u0438, \u0432\u043A\u043B\u044E\u0447\u0430\u044F
    \u0448\u0442\u0440\u0430\u0444\u044B \u0438 \u0441\u0443\u0434\u0435\u0431\u043D\u044B\u0435
    \u0438\u0441\u043A\u0438.\r\n\n\n"
