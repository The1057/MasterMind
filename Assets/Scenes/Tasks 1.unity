  m_text: "   \u042D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043A\u0440\u0438\u0437\u0438\u0441 \u2013 \u044D\u0442\u043E \u043F\u0435\u0440\u0438\u043E\u0434
    \u0440\u0435\u0437\u043A\u043E\u0433\u043E \u0441\u043F\u0430\u0434\u0430 \u0434\u0435\u043B\u043E\u0432\u043E\u0439
    \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438, \u0441\u043E\u043F\u0440\u043E\u0432\u043E\u0436\u0434\u0430\u044E\u0449\u0438\u0439\u0441\u044F
    \u043F\u0430\u0434\u0435\u043D\u0438\u0435\u043C \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430,
    \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u0435\u043C \u0434\u043E\u0445\u043E\u0434\u043E\u0432,
    \u0440\u043E\u0441\u0442\u043E\u043C \u0431\u0435\u0437\u0440\u0430\u0431\u043E\u0442\u0438\u0446\u044B
    \u0438 \u043D\u0435\u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E
    \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u044B\u0445 \u0440\u044B\u043D\u043A\u043E\u0432.\n\r\n\r\n"
