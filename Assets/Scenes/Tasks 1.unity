      m_Calls: []
  m_text: "    \u041D\u0435\u0434\u0432\u0438\u0436\u0438\u043C\u043E\u0441\u0442\u044C
    \u2013 \u044D\u0442\u043E \u0437\u0434\u0430\u043D\u0438\u044F, \u0441\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u044F
    \u0438 \u0437\u0435\u043C\u0435\u043B\u044C\u043D\u044B\u0435 \u0443\u0447\u0430\u0441\u0442\u043A\u0438,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043C\u043E\u0433\u0443\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
    \u0434\u043B\u044F \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F \u0434\u043E\u0445\u043E\u0434\u0430.
    \u0412 \u0438\u043D\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u044F\u0445 \u043D\u0435\u0434\u0432\u0438\u0436\u0438\u043C\u043E\u0441\u0442\u044C
    \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u043E\u0434\u043D\u0438\u043C
    \u0438\u0437 \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0445 \u0430\u043A\u0442\u0438\u0432\u043E\u0432,
    \u043F\u0440\u0438\u043D\u043E\u0441\u044F\u0449\u0438\u0445 \u043F\u0430\u0441\u0441\u0438\u0432\u043D\u044B\u0439
    \u0434\u043E\u0445\u043E\u0434."
  m_isRightToLeft: 0
