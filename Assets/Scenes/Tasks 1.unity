  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \u041A\u0430\u043A \u0432\u043D\u0435\u0434\u0440\u0438\u0442\u044C
    \u043D\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435 \u0431\u0435\u0437
    \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u044F?
    \n\n>  \u041E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430\u043C
    \u0432\u044B\u0433\u043E\u0434\u044B (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u043F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u043E\u043A). 
    \r\n> \u041D\u0430\u0447\u0430\u0442\u044C \u0441 \u043F\u0438\u043B\u043E\u0442\u043D\u043E\u0433\u043E
    \u043F\u0440\u043E\u0435\u043A\u0442\u0430 \n\u0432 \u043E\u0434\u043D\u043E\u043C
    \u043E\u0442\u0434\u0435\u043B\u0435.\n> \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u0434\u0430\u043D\u043D\u044B\u0435, \u0430 \u043D\u0435 \u0441\u0443\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0435
    \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u044F. \n> \u0420\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u043E
    \u043F\u0435\u0440\u0435\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044C
    \u043D\u043E\u0440\u043C\u0430\u0442\u0438\u0432\u044B.  "
