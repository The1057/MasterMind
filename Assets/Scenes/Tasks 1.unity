--- !u!114 &1856885148
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1856885146}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\r\n> ETF (Exchange Traded Fund) \u2013 \u0431\u0438\u0440\u0436\u0435\u0432\u043E\u0439
    \u0444\u043E\u043D\u0434, \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u044F\u044E\u0449\u0438\u0439
    \u043D\u0430\u0431\u043E\u0440 \u0430\u043A\u0446\u0438\u0439 \u0438\u043B\u0438
    \u043E\u0431\u043B\u0438\u0433\u0430\u0446\u0438\u0439. \u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    ETF \u043D\u0430 IT-\u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
    \u0438\u043D\u0432\u0435\u0441\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0441\u0440\u0430\u0437\u0443 \u0432 \u0434\u0435\u0441\u044F\u0442\u043A\u0438
    \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0444\u0438\u0440\u043C. \u0414\u043E\u0445\u043E\u0434\u043D\u043E\u0441\u0442\u044C
    \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u0434\u0438\u043D\u0430\u043C\u0438\u043A\u0438
    \u0441\u0435\u043A\u0442\u043E\u0440\u0430.\r\r\n> REIT (Real Estate Investment
    Trust) \u2013 \u0444\u043E\u043D\u0434 \u043D\u0435\u0434\u0432\u0438\u0436\u0438\u043C\u043E\u0441\u0442\u0438,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432\u043B\u0430\u0434\u0435\u0435\u0442
    \u043E\u0431\u044A\u0435\u043A\u0442\u0430\u043C\u0438 (\u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0435
    \u0446\u0435\u043D\u0442\u0440\u044B, \u0441\u043A\u043B\u0430\u0434\u044B, \u0436\u0438\u043B\u044C\u0451)
    \u0438 \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442
    \u0434\u043E\u0445\u043E\u0434 \u0441\u0440\u0435\u0434\u0438 \u0438\u043D\u0432\u0435\u0441\u0442\u043E\u0440\u043E\u0432.
    \u042D\u0442\u043E \u0441\u043F\u043E\u0441\u043E\u0431 \u0438\u043D\u0432\u0435\u0441\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0432 \u043D\u0435\u0434\u0432\u0438\u0436\u0438\u043C\u043E\u0441\u0442\u044C
    \u0431\u0435\u0437 \u043F\u043E\u043A\u0443\u043F\u043A\u0438 \u0437\u0434\u0430\u043D\u0438\u044F
    \u0446\u0435\u043B\u0438\u043A\u043E\u043C.\r\n\r\n\r\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6d9ad1c49cfdf504faddd7afd3ceae86, type: 2}
