  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n1. \u0421\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u0438\u0435
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u0430.\r\n>  \u0423\u0432\u043E\u043B\u044C\u043D\u0435\u043D\u0438\u0435
    \u0447\u0430\u0441\u0442\u0438 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432
    \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442 \u0440\u0430\u0441\u0445\u043E\u0434\u044B
    \u043D\u0430 \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u043D\u0443\u044E \u043F\u043B\u0430\u0442\u0443
    \u0438 \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435 \u0432\u044B\u043F\u043B\u0430\u0442\u044B,
    \u043D\u043E \u0441\u043D\u0438\u0436\u0430\u0435\u0442 \u043C\u043E\u0440\u0430\u043B\u044C
    \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0445\u0441\u044F \u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A\u043E\u0432
    \u0438 \u043C\u043E\u0436\u0435\u0442 \u0443\u0445\u0443\u0434\u0448\u0438\u0442\u044C
    \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044E \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438.\r\n2.
    \u041F\u0435\u0440\u0435\u0445\u043E\u0434 \u043D\u0430 \u0443\u0434\u0430\u043B\u0451\u043D\u043D\u0443\u044E
    \u0440\u0430\u0431\u043E\u0442\u0443.\r\n>  \u041F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
    \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0442\u044C \u043D\u0430 \u0430\u0440\u0435\u043D\u0434\u0435
    \u043E\u0444\u0438\u0441\u043E\u0432 \u0438 \u0434\u0440\u0443\u0433\u0438\u0445
    \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0445
    \u0440\u0430\u0441\u0445\u043E\u0434\u0430\u0445. \u041C\u043E\u0440\u0430\u043B\u044C
    \u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A\u043E\u0432 \u043C\u043E\u0436\u0435\u0442
    \u043F\u0430\u0434\u0430\u0442\u044C \u0438\u0437-\u0437\u0430 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043A\u0430
    \u043E\u0431\u0449\u0435\u043D\u0438\u044F \u0438 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F,
    \u043D\u043E \u0431\u0438\u0437\u043D\u0435\u0441 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442
    \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C.\r\n\n"
