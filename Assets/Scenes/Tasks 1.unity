    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[0].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        C\\n\u041B\u043E\u0433\u0438\u0441\u0442\u0438\u043A\u0430 - \u044D\u0442\u043E
        \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0432
        \u043F\u043E \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u044E
        \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u044F \u0432\u0441\u0435\u043C
        \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B\u043C \u0438
        \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0435 \u043F\u0440\u043E\u0434\u0443\u043A\u0446\u0438\u0438
        \u0434\u043E \u043F\u043E\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043B\u044F."
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[1].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n\u0426\u0435\u043F\u043E\u0447\u043A\u0430 \u043F\u043E\u0441\u0442\u0430\u0432\u043E\u043A
        \u2014 \u044D\u0442\u043E \u043F\u043E\u043B\u043D\u044B\u0439 \u043F\u0443\u0442\u044C
        \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0430: \u043E\u0442 \u0441\u044B\u0440\u044C\u044F
        \u0434\u043E \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0433\u043E \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044F. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[2].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        C \\n\u0417\u0430\u043A\u0443\u043F\u043A\u0430 \u0441\u044B\u0440\u044C\u044F
        \u2014 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u044B\u0439 \u044D\u0442\u0430\u043F
        \u0446\u0435\u043F\u0438 \u043F\u043E\u0441\u0442\u0430\u0432\u043E\u043A.
