  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n   \u0414\u043E\u043B\u0433\u043E\u0432\u0430\u044F \u0446\u0435\u043D\u043D\u0430\u044F
    \u0431\u0443\u043C\u0430\u0433\u0430, \u043F\u043E \u043A\u043E\u0442\u043E\u0440\u043E\u0439
    \u044D\u043C\u0438\u0442\u0435\u043D\u0442 (\u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u043E
    \u0438\u043B\u0438 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F) \u043E\u0431\u044F\u0437\u0443\u0435\u0442\u0441\u044F
    \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0438\u043D\u0432\u0435\u0441\u0442\u043E\u0440\u0443
    \u043D\u043E\u043C\u0438\u043D\u0430\u043B \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043C
    \u0438 \u0440\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u043E \u0432\u044B\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u0442\u044C
    \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u044B (\u043A\u0443\u043F\u043E\u043D\u044B).\r\n  
    \u041E\u0431\u043B\u0438\u0433\u0430\u0446\u0438\u0438 \u043D\u0435 \u0434\u0430\u044E\u0442
    \u043F\u0440\u0430\u0432\u0430 \u0433\u043E\u043B\u043E\u0441\u0430, \u043D\u043E
    \u0441\u0447\u0438\u0442\u0430\u044E\u0442\u0441\u044F \u0431\u043E\u043B\u0435\u0435
    \u043D\u0430\u0434\u0451\u0436\u043D\u044B\u043C\u0438 \u0438 \u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0443\u0435\u043C\u044B\u043C\u0438
    \u0430\u043A\u0442\u0438\u0432\u0430\u043C\u0438, \u0447\u0435\u043C \u0430\u043A\u0446\u0438\u0438.\r\n\r\n"
