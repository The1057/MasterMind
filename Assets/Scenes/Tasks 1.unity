      m_Calls: []
  m_text: "   \n\n\n1. \u041E\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u0434\u043E \u0432\u044B\u043F\u0443\u0441\u043A\u0430 \u0442\u043E\u0432\u0430\u0440\u0430,
    \u043D\u043E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u0430 \u0440\u0430\u0441\u0441\u0440\u043E\u0447\u043A\u0430
    \n(\u043F\u043E \u0440\u0435\u0448\u0435\u043D\u0438\u044E \u0442\u0430\u043C\u043E\u0436\u043D\u0438). 
    \r\r\r\n2. \u041F\u043B\u0430\u0442\u0435\u043B\u044C\u0449\u0438\u043A\u0438:
    \u0414\u0435\u043A\u043B\u0430\u0440\u0430\u043D\u0442, \u0432\u043B\u0430\u0434\u0435\u043B\u0435\u0446
    \u0441\u043A\u043B\u0430\u0434\u0430, \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u0447\u0438\u043A. 
    \r\n3. \u041D\u0435\u0443\u043F\u043B\u0430\u0442\u0430 \u0432\u043B\u0435\u0447\u0435\u0442
    \u0448\u0442\u0440\u0430\u0444\u044B, \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0443
    \u0433\u0440\u0443\u0437\u0430 \u0438\u043B\u0438 \u043A\u043E\u043D\u0444\u0438\u0441\u043A\u0430\u0446\u0438\u044E.  
    \r\n\r\r"
  m_isRightToLeft: 0
