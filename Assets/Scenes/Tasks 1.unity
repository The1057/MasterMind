--- !u!114 &1807879107
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1807879105}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n\n1.  \u0412 \u0415\u0421 \u0441 2024 \u0433\u043E\u0434\u0430
    \u0432\u0441\u0442\u0443\u043F\u0430\u0435\u0442 \u0432 \u0441\u0438\u043B\u0443
    \u0414\u0438\u0440\u0435\u043A\u0442\u0438\u0432\u0430 \u043E \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u043E\u0439
    \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0439 \u043E\u0442\u0447\u0451\u0442\u043D\u043E\u0441\u0442\u0438
    (CSRD) \u2013 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 \u043E\u0431\u044F\u0437\u0430\u043D\u044B
    \u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u0442\u044C ESG-\u043E\u0442\u0447\u0451\u0442\u043D\u043E\u0441\u0442\u044C.\r\n2.
    \u0412 \u0420\u043E\u0441\u0441\u0438\u0438 \u0411\u0430\u043D\u043A \u0420\u043E\u0441\u0441\u0438\u0438
    \u0432 2021 \u0433\u043E\u0434\u0443 \u0443\u0442\u0432\u0435\u0440\u0434\u0438\u043B
    \u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0430\u0446\u0438\u0438 \u043F\u043E
    \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u0438\u044E \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438
    \u043E\u0431 \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u043C \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438,
    \u0430 \u0441 2022 \u0433\u043E\u0434\u0430 \u0431\u0438\u0440\u0436\u0435\u0432\u044B\u0435
    \u044D\u043C\u0438\u0442\u0435\u043D\u0442\u044B \u043D\u0430\u0447\u0430\u043B\u0438
    \u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u0442\u044C \u043D\u0435\u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u0443\u044E
    \u043E\u0442\u0447\u0451\u0442\u043D\u043E\u0441\u0442\u044C.\r\n3. \u0412\u0430\u0436\u043D\u044B\u0439
    \u043C\u0435\u0436\u0434\u0443\u043D\u0430\u0440\u043E\u0434\u043D\u044B\u0439
    \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442 \u2013 \u041F\u0440\u0438\u043D\u0446\u0438\u043F\u044B
    \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
    \u0438\u043D\u0432\u0435\u0441\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
    (PRI) \u0438 \u0426\u0435\u043B\u0438 \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0433\u043E
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F \u041E\u041E\u041D (SDGs).\r\n4.
    \u0418\u0433\u043D\u043E\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
    ESG-\u0444\u0430\u043A\u0442\u043E\u0440\u043E\u0432 \u043C\u043E\u0436\u0435\u0442
    \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
    \u043A \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u043C
    \u043F\u043E\u0442\u0435\u0440\u044F\u043C, \u043D\u043E \u0438 \u043A \u0448\u0442\u0440\u0430\u0444\u0430\u043C,
    \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u044E \u0434\u043E\u0441\u0442\u0443\u043F\u0430
    \u043A \u0444\u0438\u043D\u0430\u043D\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044E
    \u0438 \u0440\u044B\u043D\u043A\u0430\u043C.\r\n5. \u0414\u043B\u044F \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0439
    ESG \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u043D\u044B\u043C
    \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u043C:
    \u0438\u043D\u0432\u0435\u0441\u0442\u043E\u0440\u044B \u0438 \u043A\u043B\u0438\u0435\u043D\u0442\u044B
    \u0432\u0441\u0451 \u0447\u0430\u0449\u0435 \u0432\u044B\u0431\u0438\u0440\u0430\u044E\u0442
    \u0442\u0435\u0445, \u043A\u0442\u043E \u0441\u043B\u0435\u0434\u0443\u0435\u0442
    \xAB\u0437\u0435\u043B\u0451\u043D\u044B\u043C\xBB \u0438 \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u043E
    \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
    \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0430\u043C.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6d9ad1c49cfdf504faddd7afd3ceae86, type: 2}
