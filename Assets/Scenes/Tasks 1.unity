  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n1. \u042D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043A\u0440\u0438\u0437\u0438\u0441 (\u0441\u043D\u0438\u0436\u0435\u043D\u0438\u0435
    \u044D\u043A\u0441\u043F\u043E\u0440\u0442\u0430, \u043F\u0430\u0434\u0435\u043D\u0438\u0435
    \u0446\u0435\u043D \u043D\u0430 \u043D\u0435\u0444\u0442\u044C/\u0433\u0430\u0437,
    \u0441\u0430\u043D\u043A\u0446\u0438\u0438).\r\r\n2. \u0418\u043D\u0444\u043B\u044F\u0446\u0438\u044F
    \u2013 \u0440\u043E\u0441\u0442 \u0446\u0435\u043D \u0432\u043D\u0443\u0442\u0440\u0438
    \u0441\u0442\u0440\u0430\u043D\u044B \u0441\u043D\u0438\u0436\u0430\u0435\u0442
    \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044C\u043D\u0443\u044E
    \r\n3. \u0414\u0435\u0444\u0438\u0446\u0438\u0442 \u0431\u044E\u0434\u0436\u0435\u0442\u0430
    \u0438 \u0440\u043E\u0441\u0442 \u0433\u043E\u0441\u0434\u043E\u043B\u0433\u0430.\r\n4.
    \u041D\u0435\u0433\u0430\u0442\u0438\u0432\u043D\u044B\u0435 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u044F
    \u0438\u043D\u0432\u0435\u0441\u0442\u043E\u0440\u043E\u0432 (\u043E\u0442\u0442\u043E\u043A
    \u043A\u0430\u043F\u0438\u0442\u0430\u043B\u0430, \u043F\u0430\u043D\u0438\u043A\u0430
    \u043D\u0430 \u0440\u044B\u043D\u043A\u0430\u0445).\n"
  m_isRightToLeft: 0
