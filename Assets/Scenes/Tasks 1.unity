  m_text: "    \u0424\u043E\u043D\u0434\u043E\u0432\u044B\u0439 \u0440\u044B\u043D\u043E\u043A
    \u2013 \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E, \u0433\u0434\u0435
    \u043F\u043E\u043A\u0443\u043F\u0430\u044E\u0442 \u0438 \u043F\u0440\u043E\u0434\u0430\u044E\u0442
    \u0446\u0435\u043D\u043D\u044B\u0435 \u0431\u0443\u043C\u0430\u0433\u0438, \u0442\u0430\u043A\u0438\u0435
    \u043A\u0430\u043A \u0430\u043A\u0446\u0438\u0438, \u043E\u0431\u043B\u0438\u0433\u0430\u0446\u0438\u0438,
    ETF \u0438 \u0434\u0440. \u041E\u043D \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442
    \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F\u043C \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0442\u044C
    \u0434\u0435\u043D\u044C\u0433\u0438, \u0430 \u0438\u043D\u0432\u0435\u0441\u0442\u043E\u0440\u0430\u043C
    \u2013 \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u044C \u0434\u043E\u0445\u043E\u0434.\r\n\r\n\r\n"
