  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n1. \u0410\u043D\u0430\u043B\u0438\u0437 \u0442\u0435\u043A\u0443\u0449\u0438\u0445
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0432 \u2013 \u0433\u0434\u0435
    \u0435\u0441\u0442\u044C \u043F\u043E\u0442\u0435\u0440\u0438 \u0432\u0440\u0435\u043C\u0435\u043D\u0438,
    \u0440\u0435\u0441\u0443\u0440\u0441\u0430, \u043E\u0448\u0438\u0431\u043E\u043A.\r\r\r\n2.
    \u041F\u043E\u0438\u0441\u043A \u0446\u0438\u0444\u0440\u043E\u0432\u044B\u0445
    \u0440\u0435\u0448\u0435\u043D\u0438\u0439 (\u0440\u043E\u0431\u043E\u0442\u044B,
    CRM, ERP, MES, \u0441\u0435\u043D\u0441\u043E\u0440\u044B \u0438 \u0442.\u0434.).\r\n\r\r3.
    \u041E\u0431\u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0435 \u0438\u043D\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u0439
    (\u043E\u043A\u0443\u043F\u0430\u0435\u043C\u043E\u0441\u0442\u044C, \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u0435
    \u043F\u0440\u0438\u0431\u044B\u043B\u0438).\r\r\n4. \u041F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E\u0435
    \u0432\u043D\u0435\u0434\u0440\u0435\u043D\u0438\u0435: \u0441\u043D\u0430\u0447\u0430\u043B\u0430
    \n\u043D\u0430 \u043F\u0438\u043B\u043E\u0442\u043D\u043E\u043C \u0443\u0447\u0430\u0441\u0442\u043A\u0435.\n5.
    \u041E\u0431\u0443\u0447\u0435\u043D\u0438\u0435 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u0430.\n\n"
