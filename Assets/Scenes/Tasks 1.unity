  m_text: "   \n\n\n> \u0411\u0438\u0437\u043D\u0435\u0441 \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0442
    \u0432 \u043C\u0435\u0441\u0442\u043D\u044B\u0445 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430\u0445,
    \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
    \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F, \u0444\u0438\u043D\u0430\u043D\u0441\u0438\u0440\u0443\u0435\u0442
    \u043C\u0435\u0441\u0442\u043D\u044B\u0435 \u041D\u041A\u041E.\r\r\r\n> \u0421\u043E\u0437\u0434\u0430\u043D\u0438\u0435
    \u0440\u0435\u0441\u0443\u0440\u0441\u043D\u044B\u0445 \u0446\u0435\u043D\u0442\u0440\u043E\u0432,
