      m_Calls: []
  m_text: "   \n\n> \u0411\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440\u0441\u043A\u0438\u0439
    \u0431\u0430\u043B\u0430\u043D\u0441 (\u0424\u043E\u0440\u043C\u0430 \u21161)
    \u2013 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0430\u043A\u0442\u0438\u0432\u044B,
    \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
    \u0438 \u043A\u0430\u043F\u0438\u0442\u0430\u043B \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438
    \u043D\u0430 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u0443\u044E \u0434\u0430\u0442\u0443.
    \r\r\r\n> \u041E\u0442\u0447\u0435\u0442 \u043E \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u044B\u0445
    \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0430\u0445 (\u0424\u043E\u0440\u043C\u0430
    \u21162) \u2013 \u043E\u0442\u0440\u0430\u0436\u0430\u0435\u0442 \u0434\u043E\u0445\u043E\u0434\u044B,
    \u0440\u0430\u0441\u0445\u043E\u0434\u044B \u0438 \u043F\u0440\u0438\u0431\u044B\u043B\u044C/\u0443\u0431\u044B\u0442\u043E\u043A
    \u0437\u0430 \u043F\u0435\u0440\u0438\u043E\u0434.\r\n\r\r> \u041E\u0442\u0447\u0435\u0442
    \u043E\u0431 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F\u0445 \u043A\u0430\u043F\u0438\u0442\u0430\u043B\u0430
    (\u0424\u043E\u0440\u043C\u0430 \u21163) \u2013 \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0438\u0440\u0443\u0435\u0442
    \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u0443\u0441\u0442\u0430\u0432\u043D\u043E\u0433\u043E,
    \u0440\u0435\u0437\u0435\u0440\u0432\u043D\u043E\u0433\u043E \u0438 \u0434\u043E\u0431\u0430\u0432\u043E\u0447\u043D\u043E\u0433\u043E
    \u043A\u0430\u043F\u0438\u0442\u0430\u043B\u0430.    \r\r\n> \u041E\u0442\u0447\u0435\u0442
    \u043E \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0438 \u0434\u0435\u043D\u0435\u0436\u043D\u044B\u0445
    \u0441\u0440\u0435\u0434\u0441\u0442\u0432 (\u0424\u043E\u0440\u043C\u0430 \u21164)
    \u2013 \u0430\u043D\u0430\u043B\u0438\u0437\u0438\u0440\u0443\u0435\u0442 \u043F\u043E\u0442\u043E\u043A\u0438
    \u0434\u0435\u043D\u0435\u0433 \u043F\u043E \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0439,
    \u0438\u043D\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u043E\u043D\u043D\u043E\u0439
    \u0438 \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u043E\u0439 \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438. 
    \n> \u041F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u043A \u0431\u0430\u043B\u0430\u043D\u0441\u0443
    (\u043F\u043E\u044F\u0441\u043D\u0435\u043D\u0438\u044F) \u2013 \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u044E\u0442
    \u0434\u0435\u0442\u0430\u043B\u0438 \u0443\u0447\u0435\u0442\u043D\u043E\u0439
    \u043F\u043E\u043B\u0438\u0442\u0438\u043A\u0438, \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0435
    \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0438 \u0438 \u043F\u0440. 
    \n\n    \u0414\u043B\u044F \u043C\u0430\u043B\u044B\u0445 \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u0439
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u0430 \u0443\u043F\u0440\u043E\u0449\u0435\u043D\u043D\u0430\u044F
    \u043E\u0442\u0447\u0435\u0442\u043D\u043E\u0441\u0442\u044C(\u0442\u043E\u043B\u044C\u043A\u043E
    \u0431\u0430\u043B\u0430\u043D\u0441 \u0438 \u043E\u0442\u0447\u0435\u0442 \u043E
    \u0444\u0438\u043D\u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0430\u0445). "
  m_isRightToLeft: 0
