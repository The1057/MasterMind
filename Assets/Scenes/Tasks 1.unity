--- !u!114 &37654769
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 37654767}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n3. \u041F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u044F
    \u0434\u0435\u0432\u0430\u043B\u044C\u0432\u0430\u0446\u0438\u0438:\n     \u041F\u043B\u044E\u0441\u044B:\r\n>
    \u0420\u043E\u0441\u0442 \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u043E\u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438
    \u044D\u043A\u0441\u043F\u043E\u0440\u0442\u0430 (\u0440\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0435
    \u0442\u043E\u0432\u0430\u0440\u044B \u0434\u0435\u0448\u0435\u0432\u0435\u044E\u0442
    \u0434\u043B\u044F \u0438\u043D\u043E\u0441\u0442\u0440\u0430\u043D\u0446\u0435\u0432).\r\n>
    \u0420\u043E\u0441\u0442 \u0434\u043E\u0445\u043E\u0434\u043E\u0432 \u0443 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0439-\u044D\u043A\u0441\u043F\u043E\u0440\u0442\u0451\u0440\u043E\u0432
    (\u0441\u044B\u0440\u044C\u0451, \u043C\u0435\u0442\u0430\u043B\u043B, IT-\u0443\u0441\u043B\u0443\u0433\u0438
    \u0437\u0430 \u0440\u0443\u0431\u0435\u0436).\r\r\n     \u041C\u0438\u043D\u0443\u0441\u044B:\r\n> 
    \u0415\u0441\u043B\u0438 \u0431\u0438\u0437\u043D\u0435\u0441 \u0437\u0430\u0432\u0438\u0441\u0438\u0442
    \u043E\u0442 \u0438\u043C\u043F\u043E\u0440\u0442\u0430 \u2013 \u0438\u0437\u0434\u0435\u0440\u0436\u043A\u0438
    \u0440\u0435\u0437\u043A\u043E \u0440\u0430\u0441\u0442\u0443\u0442.\r\n>  \u0415\u0441\u043B\u0438
    \u0431\u0438\u0437\u043D\u0435\u0441 \u044D\u043A\u0441\u043F\u043E\u0440\u0442\u043D\u043E-\u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D
    \u2013 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0448\u0430\u043D\u0441
    \u043D\u0430 \u0440\u043E\u0441\u0442.\r\n>  \u0414\u043B\u044F \u0433\u0440\u0430\u0436\u0434\u0430\u043D
    \u0438 \u0438\u043D\u0432\u0435\u0441\u0442\u043E\u0440\u043E\u0432: \u0445\u0440\u0430\u043D\u0438\u0442\u044C
    \u0441\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u0438\u044F \u0432 \u0432\u0430\u043B\u044E\u0442\u0435
    \u0432\u044B\u0433\u043E\u0434\u043D\u043E \u043F\u0440\u0438 \u0434\u0435\u0432\u0430\u043B\u044C\u0432\u0430\u0446\u0438\u0438,
    \u043D\u043E \u0434\u043E\u043B\u0433\u0438 \u0432 \u0432\u0430\u043B\u044E\u0442\u0435
    \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F \u043E\u043F\u0430\u0441\u043D\u044B\u043C\u0438.\r\n\n"
  m_isRightToLeft: 0
