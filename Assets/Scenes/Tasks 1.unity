    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[2].question
      value: "\u041A\u0430\u043A \u0438\u0437\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
        \u0446\u0435\u043D\u0430, \u0435\u0441\u043B\u0438 \u0441\u043F\u0440\u043E\u0441
