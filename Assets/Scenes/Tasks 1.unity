--- !u!114 &1428082922
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1428082920}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "> \u041F\u0435\u0440\u0435\u0445\u043E\u0434 \u043D\u0430 \u0431\u043E\u043B\u0435\u0435
    \u0434\u0435\u0448\u0451\u0432\u044B\u0445 \u043F\u043E\u0441\u0442\u0430\u0432\u0449\u0438\u043A\u043E\u0432
    (\u0435\u0441\u043B\u0438 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
    \u043F\u0440\u0438\u0435\u043C\u043B\u0435\u043C\u044B\u043C).\r\r\r\n\r\n> \u041E\u043F\u0442\u0438\u043C\u0438\u0437\u0430\u0446\u0438\u044F
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0432: \u0443\u043C\u0435\u043D\u044C\u0448\u0435\u043D\u0438\u0435
    \u0431\u0440\u0430\u043A\u0430, \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u044F.\r\n\r\n\r\r>
    \u042D\u043A\u043E\u043D\u043E\u043C\u0438\u044F \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432:
    \u0432\u043E\u0434\u044B, \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u044D\u043D\u0435\u0440\u0433\u0438\u0438,
    \u0443\u043F\u0430\u043A\u043E\u0432\u043A\u0438.\r\n\n>  \u0410\u0443\u0442\u0441\u043E\u0440\u0441\u0438\u043D\u0433
    \u043D\u0435\u043F\u0440\u043E\u0444\u0438\u043B\u044C\u043D\u044B\u0445 \u0437\u0430\u0434\u0430\u0447
    (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u0443\u0431\u043E\u0440\u043A\u0430,
    \u0431\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440\u0438\u044F).\n\r\n> \u041A\u043E\u043D\u0442\u0440\u043E\u043B\u044C
    \u043E\u0441\u0442\u0430\u0442\u043A\u043E\u0432 \u2013 \u0447\u0442\u043E\u0431\u044B
    \u043D\u0435 \u0437\u0430\u043A\u0443\u043F\u0430\u0442\u044C \u043B\u0438\u0448\u043D\u0435\u0435
    \u0438 \u043D\u0435 \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0442\u043E\u0432\u0430\u0440
    \u043D\u0430 \u0441\u043A\u043B\u0430\u0434\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
    \u0434\u043E\u043B\u0433\u043E.\r\n\n> \u0410\u043D\u0430\u043B\u0438\u0437 \u0437\u0430\u0442\u0440\u0430\u0442
    \u2013 \u043A\u0430\u043A\u0438\u0435 \u0441\u0442\u0430\u0442\u044C\u0438 \u0434\u0430\u044E\u0442
    \u043D\u0430\u0438\u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u0440\u0430\u0441\u0445\u043E\u0434\u044B,
    \n\u0433\u0434\u0435 \u0435\u0441\u0442\u044C \u043F\u043E\u0442\u0435\u0440\u0438.\r\n\n>
    \u041E\u0431\u0443\u0447\u0435\u043D\u0438\u0435 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u0430
    \u2013 \u0441\u043D\u0438\u0436\u0430\u0435\u0442 \u043E\u0448\u0438\u0431\u043A\u0438
    \u0438 \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C.\r\n\n"
