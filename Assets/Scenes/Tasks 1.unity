    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[0].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B\\n \u041D\u0414\u0421 (\u043D\u0430\u043B\u043E\u0433 \u043D\u0430 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u043D\u0443\u044E
        \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C) -  \u043A\u043E\u0441\u0432\u0435\u043D\u043D\u044B\u0439
        \u043D\u0430\u043B\u043E\u0433, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
        \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u0435 \u043F\u043B\u0430\u0442\u0438\u0442
        \u043F\u0440\u0438 \u0440\u0435\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438
        \u043F\u0440\u043E\u0434\u0443\u043A\u0446\u0438\u0438. \u041E\u043D \u0432\u043A\u043B\u044E\u0447\u0451\u043D
        \u0432 \u0446\u0435\u043D\u0443 \u0442\u043E\u0432\u0430\u0440\u0430. \u043A\u0438:
        \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0435 \u0432\u0441\u0435\u0445
        \u043A\u0440\u0435\u0434\u0438\u0442\u043D\u044B\u0445 \u043F\u043B\u0430\u0442\u0435\u0436\u0435\u0439
        \u043A \u0434\u043E\u0445\u043E\u0434\u0443 \u0437\u0430 \u043C\u0435\u0441\u044F\u0446."
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[1].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        C \\n \u0421 2019 \u0433\u043E\u0434\u0430 \u0432 \u0420\u0424 \u0431\u0430\u0437\u043E\u0432\u0430\u044F
        \u0441\u0442\u0430\u0432\u043A\u0430 \u041D\u0414\u0421 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
        20%."
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[2].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        C \\n \u041D\u0430\u043B\u043E\u0433 \u043D\u0430 \u043F\u0440\u0438\u0431\u044B\u043B\u044C
        \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F
        \u0441 \u0440\u0430\u0437\u043D\u0438\u0446\u044B \u043C\u0435\u0436\u0434\u0443
        \u0434\u043E\u0445\u043E\u0434\u0430\u043C\u0438 \u0438 \u0440\u0430\u0441\u0445\u043E\u0434\u0430\u043C\u0438
        \u2014 \u044D\u0442\u043E \u0438 \u0435\u0441\u0442\u044C \u043D\u0430\u043B\u043E\u0433\u043E\u043E\u0431\u043B\u0430\u0433\u0430\u0435\u043C\u0430\u044F
        \u043F\u0440\u0438\u0431\u044B\u043B\u044C. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[3].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        C\\n \u0412 \u0420\u0424 \u0441\u0442\u0430\u0432\u043A\u0430 \u043D\u0430\u043B\u043E\u0433\u0430
        \u043D\u0430 \u043F\u0440\u0438\u0431\u044B\u043B\u044C \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0439
        \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 20% (3% - \u0444\u0435\u0434\u0435\u0440\u0430\u043B\u044C\u043D\u044B\u0439,
        17% - \u0440\u0435\u0433\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439
        \u0443\u0440\u043E\u0432\u0435\u043D\u044C). ."
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[4].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
