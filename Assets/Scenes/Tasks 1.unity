    \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
    \u0431\u0435\u0437 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E\u0433\u043E
    \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0433\u043E \u0443\u0447\u0430\u0441\u0442\u0438\u044F
    \u0432 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0435. \u0412 \u043E\u0442\u043B\u0438\u0447\u0438\u0435
    \u043E\u0442 \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u043D\u043E\u0439 \u043F\u043B\u0430\u0442\u044B
    \u0438\u043B\u0438 \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430,
    \u043F\u0430\u0441\u0441\u0438\u0432\u043D\u044B\u0439 \u0434\u043E\u0445\u043E\u0434
    \u043F\u043E\u0441\u0442\u0443\u043F\u0430\u0435\u0442 \u0440\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u043E
    \u043E\u0442 \u0432\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432
    \u0438\u043B\u0438 \u0440\u0430\u043D\u0435\u0435 \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u044B\u0445
    \u0430\u043A\u0442\u0438\u0432\u043E\u0432."
