  m_text: "   \n\n\u041F\u0435\u0440\u0435\u0434\u0430\u0447\u0430 \u0434\u0435\u043D\u0435\u0436\u043D\u044B\u0445
    \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u043C
    \u043B\u0438\u0446\u0430\u043C, \u0441\u0435\u043C\u044C\u044F\u043C, \u0444\u043E\u043D\u0434\u0430\u043C
    \u0438\u043B\u0438 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u044F\u043C
    \u0434\u043B\u044F \u0440\u0435\u0448\u0435\u043D\u0438\u044F \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445,
    \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u0438\u0445, \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0438\u043B\u0438 \u0438\u043D\u044B\u0445 \u0437\u0430\u0434\u0430\u0447.\r\n
    \u041F\u0440\u0438\u043C\u0435\u0440\u044B: \u043F\u043E\u0436\u0435\u0440\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044F
    \u0444\u043E\u043D\u0434\u0430\u043C, \u043E\u043F\u043B\u0430\u0442\u0430 \u043B\u0435\u0447\u0435\u043D\u0438\u044F,
    \u043F\u043E\u043C\u043E\u0449\u044C \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u0432\u0448\u0438\u043C
    \u043E\u0442 \u0441\u0442\u0438\u0445\u0438\u0439\u043D\u044B\u0445 \u0431\u0435\u0434\u0441\u0442\u0432\u0438\u0439.\r\r\n"
