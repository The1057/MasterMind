  m_text: "   \n\n  \u0413\u043E\u0442\u043E\u0432\u044B\u0435 \u043F\u043E\u0440\u0442\u0444\u0435\u043B\u0438
    \u0430\u043A\u0442\u0438\u0432\u043E\u0432 \u043F\u043E\u0434 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C
    \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0445
    \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0449\u0438\u0445.\r\n> \u041F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0430
    \u2013 \u0434\u0438\u0432\u0435\u0440\u0441\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u044F
    \u0438 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E\u0441\u0442\u044C.\r\n>
    \u041D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043A\u0438 \u2013 \u043A\u043E\u043C\u0438\u0441\u0441\u0438\u0438,
    \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u044C \u043E\u0442
    \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F.\r\n\r\n\r\n\n"
