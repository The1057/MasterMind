  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n3. \u0418\u043D\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u043D\u0430\u044F
    \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430\r\n>   \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0435
    \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0439, \u0437\u0435\u043C\u043B\u0438
    \u043D\u0430 \u043B\u044C\u0433\u043E\u0442\u043D\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445;\r\n>  
    \u0434\u043E\u0441\u0442\u0443\u043F \u043A \u0442\u0435\u0445\u043D\u043E\u043F\u0430\u0440\u043A\u0430\u043C,
    \u0431\u0438\u0437\u043D\u0435\u0441-\u0438\u043D\u043A\u0443\u0431\u0430\u0442\u043E\u0440\u0430\u043C,
    \u0430\u043A\u0441\u0435\u043B\u0435\u0440\u0430\u0442\u043E\u0440\u0430\u043C.\r\r\n4. 
    \u0421\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430\r\n>  
    \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u0440\u0430\u0431\u043E\u0447\u0438\u0445
    \u043C\u0435\u0441\u0442;\r\n>   \u0438\u043D\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u0438
    \u0432 \u044D\u043A\u043E\u043B\u043E\u0433\u0438\u044E \u0438 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0435
    \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0438;\r\n>    \u0443\u0447\u0430\u0441\u0442\u0438\u0435
    \u0432 \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445 \u0438 \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u043F\u0440\u043E\u0435\u043A\u0442\u0430\u0445.\r\n\n"
