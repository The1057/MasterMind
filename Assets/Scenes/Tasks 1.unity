  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u043E\u043C,
    \u043D\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435 \u0442\u0440\u0443\u0434\u0430
    \u0438 KPI, \u0442\u0440\u0443\u0434\u043E\u0432\u044B\u0435 \u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442\u044B
    \n\r\n\r    \u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u043E\u043C
    \u2014 \u044D\u0442\u043E \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u043A\u0430\u0434\u0440\u043E\u0432\u044B\u0439
    \u0443\u0447\u0435\u0442 \u0438 \u0432\u044B\u043F\u043B\u0430\u0442\u0430 \u0437\u0430\u0440\u043F\u043B\u0430\u0442.
    \u042D\u0442\u043E \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u043D\u0430\u044F
    \u0441\u0438\u0441\u0442\u0435\u043C\u0430, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442 \u0432 \u0441\u0435\u0431\u044F:\n\n>
    \u041D\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435 \u0442\u0440\u0443\u0434\u0430
    \u2014 \u0447\u0442\u043E\u0431\u044B \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0438
    \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0438 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E,
    \n\u043D\u043E \u0431\u0435\u0437 \u043F\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u043E\u043A.\n\r\r>
    KPI (\u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0438
    \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438)
    \u2014 \u0447\u0442\u043E\u0431\u044B \u043C\u043E\u0442\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0438 \u043E\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043D\u043E \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0442\u044C
    \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B.\n> \u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
    \u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442\u0430\u043C\u0438 \u2014 \u0447\u0442\u043E\u0431\u044B
    \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0442\u044C \u0437\u0434\u043E\u0440\u043E\u0432\u0443\u044E
    \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0443 \n\u0432 \u043A\u043E\u043B\u043B\u0435\u043A\u0442\u0438\u0432\u0435.\n\r\n\r\n"
  m_isRightToLeft: 0
