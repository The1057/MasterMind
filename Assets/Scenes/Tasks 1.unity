  m_text: "   \u041F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430 \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u044B\u0445
    \u0441\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432 \u2013 \u044D\u0442\u043E
    \u043C\u0435\u0440\u044B \u0441\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u044B
    \u0431\u0438\u0437\u043D\u0435\u0441\u0430, \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0430
    \u0438\u043B\u0438 \u043D\u0435\u043A\u043E\u043C\u043C\u0435\u0440\u0447\u0435\u0441\u043A\u0438\u0445
    \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0439 (\u041D\u041A\u041E),
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u044B
    \u043D\u0430 \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u0435 \u0431\u043B\u0430\u0433\u043E\u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F,
    \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u043A\u0430\u043F\u0438\u0442\u0430\u043B\u0430
    \u0438 \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0433\u043E \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F
    \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E\u0439 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438
    (\u0440\u0430\u0439\u043E\u043D\u0430, \u0433\u043E\u0440\u043E\u0434\u0430,
    \u043C\u0438\u043A\u0440\u043E\u0440\u0430\u0439\u043E\u043D\u0430). \u0412 \u0440\u0430\u043C\u043A\u0430\u0445
    \u0431\u0438\u0437\u043D\u0435\u0441\u0430 \u044D\u0442\u043E \u043C\u043E\u0436\u0435\u0442
    \u0432\u044B\u0440\u0430\u0436\u0430\u0442\u044C\u0441\u044F \u0447\u0435\u0440\u0435\u0437
    \u043D\u0430\u0439\u043C \u0436\u0438\u0442\u0435\u043B\u0435\u0439 \u0438\u0437
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u043D\u044B\u0445 \u0440\u0430\u0439\u043E\u043D\u043E\u0432,
    \u0444\u0438\u043D\u0430\u043D\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
    \u043C\u0435\u0441\u0442\u043D\u044B\u0445 \u0438\u043D\u0438\u0446\u0438\u0430\u0442\u0438\u0432,
    \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
    \u0441 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0430\u043B\u044C\u043D\u044B\u043C\u0438
    \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C\u0438
    \u0441\u0430\u043C\u043E\u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F\u043C\u0438
    (\u0422\u041E\u0421) \u0438 \u043C\u0443\u043D\u0438\u0446\u0438\u043F\u0430\u043B\u0438\u0442\u0435\u0442\u0430\u043C\u0438.\r\n\r\n"
