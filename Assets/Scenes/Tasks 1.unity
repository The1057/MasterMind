  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \u0412\u044B - \u0441\u0430\u043C\u044B\u0439 \u043E\u0431\u044B\u0447\u043D\u044B\u0439
    \u043E\u0444\u0438\u0441\u043D\u044B\u0439 \u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A.
    \u041A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C \u043F\u043E\u0445\u043E\u0436
    \u043D\u0430 \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0438\u0439: \u0440\u0430\u0431\u043E\u0442\u0430,
    \u0434\u043E\u043C, \u0440\u0430\u0431\u043E\u0442\u0430... \n\n   \u0410 \u0432\u0435\u0434\u044C
    \u043A\u043E\u0433\u0434\u0430-\u0442\u043E \u0434\u0430\u0432\u043D\u043E \u0432\u044B
    \u043C\u0435\u0447\u0442\u0430\u043B\u0438 \u043E \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u043C
    \u0431\u0438\u0437\u043D\u0435\u0441\u0435, \u0432\u0435\u0434\u044C  \u0447\u0442\u043E
    \u0435\u0441\u043B\u0438 \u043B\u044E\u0431\u0438\u0448\u044C \u0441\u0432\u043E\u0435
    \u0434\u0435\u043B\u043E, \u0442\u043E \u0440\u0430\u0431\u043E\u0442\u0430 \u0432\u0441\u0435\u0433\u0434\u0430
    \u0431\u0443\u0434\u0435\u0442 \u0432 \u0440\u0430\u0434\u043E\u0441\u0442\u044C."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: aa753ce2b0132a54583ff08db0c4f8ac, type: 2}
