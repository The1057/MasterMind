  m_text: "\n\r\n  \u0418\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u044B\u0439
    \u043F\u0443\u0442\u044C \u2014 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435
    \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430, \u0432\u043D\u0435\u0434\u0440\u0435\u043D\u0438\u0435
    \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0439, \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u0435
    \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438.\n\r\n 
    \u042D\u043A\u0441\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u044B\u0439 \u043F\u0443\u0442\u044C
    \u2014 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430
    \u0437\u0430 \u0441\u0447\u0435\u0442 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432.\r\n\r\n"
