--- !u!114 &459685466
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 459685464}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n\n   \u041A\u043B\u044E\u0447\u0435\u0432\u044B\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0438
    \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438
    (KPI - Key Performance Indicator ) \u2014 \u044D\u0442\u043E \u0438\u0437\u043C\u0435\u0440\u0438\u043C\u044B\u0435
    \u0446\u0435\u043B\u0438, \u043F\u043E \u043A\u043E\u0442\u043E\u0440\u044B\u043C
    \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0440\u0430\u0431\u043E\u0442\u0430
    \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430 \u0438\u043B\u0438
    \u043E\u0442\u0434\u0435\u043B\u0430.  \n\n\u041F\u0440\u0438\u043C\u0435\u0440\u044B
    KPI \u0434\u043B\u044F \u0440\u0430\u0437\u043D\u044B\u0445 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u0439:\n
    \n1. \u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440 \u043F\u043E \u043F\u0440\u043E\u0434\u0430\u0436\u0430\u043C
    \u2192 \u0412\u044B\u0440\u0443\u0447\u043A\u0430, \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u0441\u0434\u0435\u043B\u043E\u043A, \u0441\u0440\u0435\u0434\u043D\u0438\u0439
    \u0447\u0435\u043A.  \r\r\r\n2. HR-\u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0441\u0442
    \u2192 \u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0437\u0430\u043A\u0440\u044B\u0442\u0438\u044F
    \u0432\u0430\u043A\u0430\u043D\u0441\u0438\u0439, \u0443\u0440\u043E\u0432\u0435\u043D\u044C
    \u0442\u0435\u043A\u0443\u0447\u0435\u0441\u0442\u0438 \u043A\u0430\u0434\u0440\u043E\u0432. 
    \r\n3. \u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442 \u2192
    \u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u044B\u0445
    \u0437\u0430\u0434\u0430\u0447, \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435
    \u0431\u0430\u0433\u043E\u0432.  \r\n\r\n\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6d9ad1c49cfdf504faddd7afd3ceae86, type: 2}
