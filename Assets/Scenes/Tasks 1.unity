  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "  \u0412\u044B\u0431\u043E\u0440 \u0444\u043E\u0440\u043C\u044B \u0431\u0438\u0437\u043D\u0435\u0441\u0430:\n\r\n 
    \u0418\u041F: \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0434\u043B\u044F
    \u043C\u0430\u043B\u043E\u0433\u043E \u0431\u0438\u0437\u043D\u0435\u0441\u0430
    \n\u0438 \u0441\u0430\u043C\u043E\u0437\u0430\u043D\u044F\u0442\u043E\u0441\u0442\u0438.
    \u0420\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044F \u043F\u0440\u043E\u0441\u0442\u0430\u044F,
    \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u044B \u043E\u0442\u0432\u0435\u0447\u0430\u044E\u0442
    \n\u043F\u043E \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430\u043C
    \u0432\u0441\u0435\u043C \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u043C.
    \u0423\u043F\u0440\u043E\u0449\u0451\u043D\u043D\u044B\u0439 \u0443\u0447\u0451\u0442.\n\r\n 
    \u041E\u041E\u041E: \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0434\u043B\u044F
    \u0431\u0438\u0437\u043D\u0435\u0441\u0430 \n\u0441 \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u0430\u043C\u0438.
    \u041E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C
    \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0430 \u0432\u043A\u043B\u0430\u0434\u043E\u043C.
    \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u043F\u0440\u0438\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u044F
    \u0438\u043D\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u0439 \n\u0438 \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F
    \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u043E\u0432. \n\u041E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F
    \u0431\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440\u0438\u044F.\r\n"
