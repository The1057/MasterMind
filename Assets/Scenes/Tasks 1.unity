    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[0].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B\\n  \u0422\u0435\u0445\u043D\u043E\u0433\u0435\u043D\u043D\u044B\u0435
        \u0440\u0438\u0441\u043A\u0438 \u0441\u0432\u044F\u0437\u0430\u043D\u044B
        \u0441 \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E
        \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0438 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C\u0438
        \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0430\u043C\u0438, \u0432 \u043E\u0442\u043B\u0438\u0447\u0438\u0435
        \u043E\u0442 \u043F\u0440\u0438\u0440\u043E\u0434\u043D\u044B\u0445 \u0438\u043B\u0438
        \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0445
        \u0444\u0430\u043A\u0442\u043E\u0440\u043E\u0432."
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[1].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        A \\n  \u042D\u0442\u0430 \u0444\u043E\u0440\u043C\u0443\u043B\u0430 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
        \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E
        \u043E\u0446\u0435\u043D\u0438\u0442\u044C \u0440\u0438\u0441\u043A, \u0443\u0447\u0438\u0442\u044B\u0432\u0430\u044F
        \u043A\u0430\u043A \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u044C
        \u043D\u0430\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u044F \u0441\u043E\u0431\u044B\u0442\u0438\u044F,
        \u0442\u0430\u043A \u0438 \u043C\u0430\u0441\u0448\u0442\u0430\u0431 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0445
        \u043F\u043E\u0442\u0435\u0440\u044C. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[2].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n \u0421\u0442\u0440\u0430\u0445\u043E\u0432\u0430\u043D\u0438\u0435
        \u043E\u043F\u0430\u0441\u043D\u044B\u0445 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
        \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432 (\u041E\u041F\u041E) \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
        \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C
        \u0434\u043B\u044F \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u0439,
        \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0449\u0438\u0445 \u0441 \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0439
        \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C\u044E. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[3].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B\\n  \u0424\u0440\u0430\u043D\u0448\u0438\u0437\u0430 \u0443\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
        \u0434\u043B\u044F \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u044F \u0441\u0442\u0440\u0430\u0445\u043E\u0432\u044B\u0445
        \u043F\u0440\u0435\u043C\u0438\u0439 \u0438 \u043F\u0440\u0435\u0434\u043E\u0442\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F
        \u043C\u0435\u043B\u043A\u0438\u0445 \u0441\u0442\u0440\u0430\u0445\u043E\u0432\u044B\u0445
        \u0441\u043B\u0443\u0447\u0430\u0435\u0432. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[4].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        C\\n \u0425\u0435\u0434\u0436\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
        - \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u044B\u0439 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442
        \u0437\u0430\u0449\u0438\u0442\u044B \u043E\u0442 \u043A\u043E\u043B\u0435\u0431\u0430\u043D\u0438\u0439
        \u043A\u0443\u0440\u0441\u043E\u0432, \u043D\u0435 \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0439
        \u0441\u043E \u0441\u0442\u0440\u0430\u0445\u043E\u0432\u044B\u043C\u0438
        \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0430\u043C\u0438."
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[5].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n\u042D\u0442\u043E\u0442 \u0437\u0430\u043A\u043E\u043D \u0443\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
        \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F \u043A \u043F\u0440\u043E\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u043E\u0439
        \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438
        \u0438 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u043C\u0443
        \u0441\u0442\u0440\u0430\u0445\u043E\u0432\u0430\u043D\u0438\u044E \u041E\u041F\u041E. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[6].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\nD2C (Direct-to-Consumer) \u0438\u0441\u043A\u043B\u044E\u0447\u0430\u0435\u0442
        \u043F\u043E\u0441\u0440\u0435\u0434\u043D\u0438\u043A\u043E\u0432, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
        \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C \u0432\u0441\u0435\u0445
        \u044D\u0442\u0430\u043F\u043E\u0432 \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
        \u0441 \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u043C \u2014 \u043E\u0442
        \u0437\u0430\u043A\u0430\u0437\u0430 \u0434\u043E \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0438
        \u2014 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u043C. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[7].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n Lifetime Value (LTV) \u043E\u0442\u0440\u0430\u0436\u0430\u0435\u0442
        \u043E\u0431\u0449\u0443\u044E \u043F\u0440\u0438\u0431\u044B\u043B\u044C
        \u043E\u0442 \u043A\u043B\u0438\u0435\u043D\u0442\u0430 \u0437\u0430 \u0432\u0441\u0435
        \u0432\u0440\u0435\u043C\u044F \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u0430. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[8].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        C \\n\u0412 \u043E\u0442\u043B\u0438\u0447\u0438\u0435 \u043E\u0442 \u041E\u041F\u041E
        \u0438 \u041E\u0421\u0410\u0413\u041E, \u0441\u0442\u0440\u0430\u0445\u043E\u0432\u0430\u043D\u0438\u0435
        \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
        \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u043D\u044B\u043C,
        \u0445\u043E\u0442\u044F \u0438 \u043A\u0440\u0430\u0439\u043D\u0435 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u043C\u044B\u043C.  "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[9].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n \u0412 2024 \u0433\u043E\u0434\u0443 \u0430\u043A\u0442\u0443\u0430\u043B\u044C\u043D\u044B
        \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u044F
        \u0438 data-driven \u043F\u043E\u0434\u0445\u043E\u0434\u044B, \u0442\u043E\u0433\u0434\u0430
        \u043A\u0430\u043A \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0435 \u0437\u0432\u043E\u043D\u043A\u0438
        \u0443\u0441\u0442\u0443\u043F\u0430\u044E\u0442 \u043F\u043E \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438
        \u043B\u0438\u0434-\u0433\u0435\u043D\u0435\u0440\u0430\u0446\u0438\u0438
        \u0447\u0435\u0440\u0435\u0437 LinkedIn \u0438 email-\u043C\u0430\u0440\u043A\u0435\u0442\u0438\u043D\u0433. "
      objectReference: {fileID: 0}
