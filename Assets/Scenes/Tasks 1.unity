      m_Calls: []
  m_text: "   \u041C\u0435\u0440\u044B \u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0435\u043D\u0438\u044F
    \u043A\u0440\u0438\u0437\u0438\u0441\u0430:\n>  \u041F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430
    \u0431\u0438\u0437\u043D\u0435\u0441\u0430 \u0438 \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u044F
    (\u0441\u0443\u0431\u0441\u0438\u0434\u0438\u0438, \u043B\u044C\u0433\u043E\u0442\u043D\u044B\u0435
    \u043A\u0440\u0435\u0434\u0438\u0442\u044B, \u0433\u043E\u0441\u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B
    \u0437\u0430\u043D\u044F\u0442\u043E\u0441\u0442\u0438);\r\r\r\r\n>  \u0421\u0442\u0438\u043C\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
    \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0433\u043E \u0441\u043F\u0440\u043E\u0441\u0430
    \u0438 \u0438\u043D\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u0439;\r\n\r\r> 
    \u0421\u0442\u0430\u0431\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u044F \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u043E\u0439
    \u0441\u0438\u0441\u0442\u0435\u043C\u044B.\n\n"
