  m_text: "   \n\n\u0411\u0435\u0437\u0432\u043E\u0437\u043C\u0435\u0437\u0434\u043D\u043E\u0435
    \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435 \u0440\u0430\u0431\u043E\u0442
    \u0438\u043B\u0438 \u043E\u043A\u0430\u0437\u0430\u043D\u0438\u0435 \u0443\u0441\u043B\u0443\u0433
    \u0432 \u043F\u043E\u043B\u044C\u0437\u0443 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430.\r\n
    \u041F\u0440\u0438\u043C\u0435\u0440\u044B: \u0443\u0447\u0430\u0441\u0442\u0438\u0435
    \u0432 \u0443\u0431\u043E\u0440\u043A\u0435 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438,
    \u0440\u0430\u0431\u043E\u0442\u0430 \u0432 \u043F\u0440\u0438\u044E\u0442\u0430\u0445
    \u0434\u043B\u044F \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445, \u043F\u043E\u043C\u043E\u0449\u044C
    \u043D\u0430 \u043C\u0435\u0440\u043E\u043F\u0440\u0438\u044F\u0442\u0438\u044F\u0445.\n\n"
