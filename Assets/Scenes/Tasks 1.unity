  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n1. \u041F\u0440\u0438\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0435
    \u043A\u0430\u043F\u0438\u0442\u0430\u043B\u0430 \u2013 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F
    \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430
    \u043E\u0442 \u0438\u043D\u0432\u0435\u0441\u0442\u043E\u0440\u043E\u0432.\r\n\r2.
    \u041F\u0443\u0431\u043B\u0438\u0447\u043D\u044B\u0439 \u0441\u0442\u0430\u0442\u0443\u0441
    \u2013 \u0432\u043E\u0437\u043D\u0438\u043A\u0430\u0435\u0442 \u043E\u0431\u044F\u0437\u0430\u043D\u043D\u043E\u0441\u0442\u044C
    \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0442\u044C \u043E\u0442\u0447\u0451\u0442\u043D\u043E\u0441\u0442\u044C
    \u0438 \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u043C
    \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u0430\u043C.\n3. \u041B\u0438\u043A\u0432\u0438\u0434\u043D\u043E\u0441\u0442\u044C
    \u0430\u043A\u0446\u0438\u0439 \u2013 \u0430\u043A\u0446\u0438\u0438 \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F
    \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u043C\u0438 \u0434\u043B\u044F
    \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0438 \u043D\u0430 \u0431\u0438\u0440\u0436\u0435.\n4.
    \u0420\u0438\u0441\u043A\u0438 \u0438\u043D\u0432\u0435\u0441\u0442\u043E\u0440\u043E\u0432
    \u2013 \u0446\u0435\u043D\u0430 \u0430\u043A\u0446\u0438\u0439 \u043C\u043E\u0436\u0435\u0442
    \u0441\u0438\u043B\u044C\u043D\u043E \u043A\u043E\u043B\u0435\u0431\u0430\u0442\u044C\u0441\u044F.\n"
