  m_text: "   \u0411\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440\u0441\u043A\u0430\u044F
    \u043E\u0442\u0447\u0435\u0442\u043D\u043E\u0441\u0442\u044C \u2013 \u043A\u043B\u044E\u0447\u0435\u0432\u043E\u0439
    \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442 \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u043E\u0439
    \u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u043E\u0441\u0442\u0438 \u0431\u0438\u0437\u043D\u0435\u0441\u0430.
    \u0413\u0440\u0430\u043C\u043E\u0442\u043D\u043E\u0435 \u0435\u0435 \u0432\u0435\u0434\u0435\u043D\u0438\u0435
    \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044C
    \u0448\u0442\u0440\u0430\u0444\u043E\u0432, \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0442\u044C
    \u0438\u043D\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u0438 \u0438 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E
    \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439. 
    \r\n\n\r\r\n\r\n"
