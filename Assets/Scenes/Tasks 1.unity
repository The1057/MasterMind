  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n> \u0413\u0438\u0431\u0440\u0438\u0434\u043D\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430
    (\u043E\u0444\u0438\u0441 + \u0443\u0434\u0430\u043B\u0435\u043D\u043A\u0430).\r\r\r\n>
    \u0413\u0435\u0439\u043C\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u044F \u2014
    \u0432\u043D\u0435\u0434\u0440\u0435\u043D\u0438\u0435 \u0438\u0433\u0440\u043E\u0432\u044B\u0445
    \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432 \u0432 \u043C\u043E\u0442\u0438\u0432\u0430\u0446\u0438\u044E
    (\u0431\u0430\u043B\u043B\u044B, \u0440\u0435\u0439\u0442\u0438\u043D\u0433\u0438,
    \u0431\u043E\u043D\u0443\u0441\u044B).  \r\n\r\r> \u0418\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442 \u0432 HR \u2014 \u0430\u043D\u0430\u043B\u0438\u0437
    \u0434\u0430\u043D\u043D\u044B\u0445, \u0447\u0430\u0442-\u0431\u043E\u0442\u044B
    \u0434\u043B\u044F \u0440\u0435\u043A\u0440\u0443\u0442\u0438\u043D\u0433\u0430,
    \u043F\u0440\u043E\u0433\u043D\u043E\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
    \u0442\u0435\u043A\u0443\u0447\u0435\u0441\u0442\u0438 \u043A\u0430\u0434\u0440\u043E\u0432.  
    \r\r\n> \u041F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u043F\u043E\u0434\u0445\u043E\u0434 \u2014 \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u044B\u0435
    \u043F\u043B\u0430\u043D\u044B \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F
    \u0434\u043B\u044F \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0445 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432.\n"
