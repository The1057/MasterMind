    \u0441\u0440\u043E\u043A.\r\n\r\r> \u042D\u043A\u0441\u043F\u0435\u0440\u0442\u0438\u0437\u0430
    \u2013 \u043A\u043E\u043C\u0438\u0441\u0441\u0438\u044F \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0435\u0442
    \u0437\u0430\u044F\u0432\u043A\u0438 \u043F\u043E \u043A\u0440\u0438\u0442\u0435\u0440\u0438\u044F\u043C
    (\u0437\u043D\u0430\u0447\u0438\u043C\u043E\u0441\u0442\u044C, \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435
    \u0446\u0435\u043B\u044F\u043C, \u0440\u0435\u0430\u043B\u0438\u0441\u0442\u0438\u0447\u043D\u043E\u0441\u0442\u044C
    \u0431\u044E\u0434\u0436\u0435\u0442\u0430, \u043E\u043F\u044B\u0442 \u043A\u043E\u043C\u0430\u043D\u0434\u044B).\r\r\n>
    \u041E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u0435 \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u0435\u0439
    \u2013 \u043B\u0443\u0447\u0448\u0438\u0435 \u043F\u0440\u043E\u0435\u043A\u0442\u044B
    \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 \u0444\u0438\u043D\u0430\u043D\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435.\n>
    \u0420\u0435\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044F \u0438 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C
    \u2013 \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u044E\u0442
    \u043F\u0440\u043E\u0435\u043A\u0442\u044B \u0438 \u043E\u0442\u0447\u0438\u0442\u044B\u0432\u0430\u044E\u0442\u0441\u044F
    \u0437\u0430 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430.\n"
