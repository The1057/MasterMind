      m_Calls: []
  m_text: "\u0414\u043B\u044F \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445
    \u0432\u0438\u0434\u043E\u0432 \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \n\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u044F:\n\n>
    \u041E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435 (\u0420\u043E\u0441\u043E\u0431\u0440\u043D\u0430\u0434\u0437\u043E\u0440)\n\r\n>
    \u041C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u0430\u044F \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
    (\u0420\u043E\u0441\u0437\u0434\u0440\u0430\u0432\u043D\u0430\u0434\u0437\u043E\u0440)\r\n\n>
    \u0422\u043E\u0440\u0433\u043E\u0432\u043B\u044F \u0430\u043B\u043A\u043E\u0433\u043E\u043B\u0435\u043C
    (\u043C\u0435\u0441\u0442\u043D\u044B\u0435 \n\u043E\u0440\u0433\u0430\u043D\u044B
    \u0432\u043B\u0430\u0441\u0442\u0438)\n\n> \u041E\u0445\u0440\u0430\u043D\u043D\u044B\u0435
    \u0443\u0441\u043B\u0443\u0433\u0438 (\u041C\u0412\u0414)\n"
