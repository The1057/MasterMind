    \u0437\u0430\u0432\u043E\u0434 \u043F\u043E \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0435
    \u041E\u041F\u041E. \u041F\u0440\u0438 \u0430\u0432\u0430\u0440\u0438\u0438 \u0432
    2023 \u0433\u043E\u0434\u0443:  \r\n> \u0423\u0449\u0435\u0440\u0431: 1.2 \u043C\u043B\u0440\u0434
    \u0440\u0443\u0431.  \r\n> \u0412\u044B\u043F\u043B\u0430\u0442\u0430: 950 \u043C\u043B\u043D
    \u0440\u0443\u0431.  \r\n> \u0421\u0440\u043E\u043A \u0443\u0440\u0435\u0433\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F:
    14 \u0434\u043D\u0435\u0439 \n\n\u041E\u0448\u0438\u0431\u043A\u0438 \u043F\u0440\u0438
    \u0441\u0442\u0440\u0430\u0445\u043E\u0432\u0430\u043D\u0438\u0438:  \r\n\u041C\u0430\u043B\u043E\u0435
    \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u0435 \u043D\u0435
    \u0437\u0430\u0441\u0442\u0440\u0430\u0445\u043E\u0432\u0430\u043B\u043E \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C
    \u0437\u0430 \u044D\u043A\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0443\u0449\u0435\u0440\u0431. \u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442: 
    \r\n> \u0428\u0442\u0440\u0430\u0444 \u0420\u043E\u0441\u043F\u0440\u0438\u0440\u043E\u0434\u043D\u0430\u0434\u0437\u043E\u0440\u0430:
    45 \u043C\u043B\u043D \u0440\u0443\u0431.  \r\n> \u0421\u0443\u0434\u0435\u0431\u043D\u044B\u0435
    \u0438\u0437\u0434\u0435\u0440\u0436\u043A\u0438: 7 \u043C\u043B\u043D \u0440\u0443\u0431. 
    \r\n> \u0411\u0430\u043D\u043A\u0440\u043E\u0442\u0441\u0442\u0432\u043E \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 
    \r\n\r\n"
