  m_text: "> \u0421\u043D\u0438\u0436\u0430\u0435\u0442 \u043F\u043E\u0442\u0435\u0440\u0438
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438,\n\n> \u0414\u0430\u0451\u0442 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u0438,\n\r\n>
    \u041F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0432\u044B\u044F\u0432\u0438\u0442\u044C
    \u0438 \u0443\u0441\u0442\u0440\u0430\u043D\u0438\u0442\u044C \u0443\u0437\u043A\u0438\u0435
    \u043C\u0435\u0441\u0442\u0430 (\u0423\u0437\u043A\u043E\u0435 \u043C\u0435\u0441\u0442\u043E
    -  \u044D\u0442\u043E \u044D\u0442\u0430\u043F, \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u044E\u0449\u0438\u0439
    \u0432\u0435\u0441\u044C \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441. \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u044B\u0439 \u0443\u0447\u0430\u0441\u0442\u043E\u043A
    \u0441\u0431\u043E\u0440\u043A\u0438),\n\r\n> \u0421\u043F\u043E\u0441\u043E\u0431\u0441\u0442\u0432\u0443\u0435\u0442
    \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438
    \u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A\u043E\u0432 \u0438 \u0440\u043E\u0441\u0442\u0443
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438\n\r\n\r\n\r\n"
  m_isRightToLeft: 0
