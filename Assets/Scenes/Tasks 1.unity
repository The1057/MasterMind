      objectReference: {fileID: 7626124932541472502, guid: 277161f2ea9598c40a5958cce85c5cbe, type: 3}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[0].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n\u041F\u0440\u043E\u0434\u0430\u0436\u0430 \u0430\u043B\u043A\u043E\u0433\u043E\u043B\u044F
        \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0438
        \u043E\u0442 \u0440\u0435\u0433\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0445
        \u043E\u0440\u0433\u0430\u043D\u043E\u0432 \u0438 \u0420\u0410\u0420 (\u2116
        171-\u0424\u0417). \u041E\u043F\u0442\u043E\u0432\u0430\u044F \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u044F,
        \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442-\u043C\u0430\u0433\u0430\u0437\u0438\u043D\u044B
        \u0438 \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
        \u0434\u0430\u0447\u043D\u044B\u0445 \u0434\u043E\u043C\u043E\u0432 \u043D\u0435
        \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0440\u0443\u044E\u0442\u0441\u044F,
        \u043D\u043E \u043C\u043E\u0433\u0443\u0442 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C
        \u0441\u0430\u043D\u0438\u0442\u0430\u0440\u043D\u044B\u0445 \u0438\u043B\u0438
        \u043F\u043E\u0436\u0430\u0440\u043D\u044B\u0445 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0439"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[1].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        C \\n\u0420\u043E\u0441\u043E\u0431\u0440\u043D\u0430\u0434\u0437\u043E\u0440
        \u0432\u044B\u0434\u0430\u0451\u0442 \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0438
        \u043D\u0430 \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u0443\u044E
        \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C,
        \u0437\u0430 \u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435\u043C
        \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u043E\u0433\u043E
        \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u044F \u0431\u0435\u0437 \u0432\u044B\u0434\u0430\u0447\u0438
        \u0434\u0438\u043F\u043B\u043E\u043C\u043E\u0432"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[2].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        C \\n\u0411\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0439
        \u0432 \u0420\u043E\u0441\u0441\u0438\u0438 \u0432\u044B\u0434\u0430\u044E\u0442\u0441\u044F
        \u0431\u0435\u0441\u0441\u0440\u043E\u0447\u043D\u043E, \u0437\u0430 \u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435\u043C
        \u0441\u043B\u0443\u0447\u0430\u0435\u0432, \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u043D\u044B\u0445
        \u0437\u0430\u043A\u043E\u043D\u043E\u043C (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
        \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u044F \u043D\u0430 \u0430\u043B\u043A\u043E\u0433\u043E\u043B\u044C
        \u2014 \u0434\u043E 5 \u043B\u0435\u0442)"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[3].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B\\n\u0420\u043E\u0441\u0437\u0434\u0440\u0430\u0432\u043D\u0430\u0434\u0437\u043E\u0440
        \u0432\u044B\u0434\u0430\u0451\u0442 \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0438
        \u043D\u0430 \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u044E \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0430\u043C\u0438
        \u0438 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u0435\u0442
        \u0444\u0430\u0440\u043C\u0430\u0446\u0435\u0432\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E
        \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[4].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        D\\n\u041C\u0438\u043D\u0438\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E
        \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0445 \u0434\u0435\u043B
        (\u041C\u0412\u0414) \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u0437\u0430
        \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
        \u043E\u0445\u0440\u0430\u043D\u043D\u043E\u0439 \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
        \u0438 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C \u0437\u0430 \u0441\u043E\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435\u043C
        \u0435\u0451 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u0439"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[5].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        A \\n\u041E\u043A\u0430\u0437\u0430\u043D\u0438\u0435 \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u0438\u0445
        \u0443\u0441\u043B\u0443\u0433, \u0432\u043A\u043B\u044E\u0447\u0430\u044F
        \u0441\u0442\u043E\u043C\u0430\u0442\u043E\u043B\u043E\u0433\u0438\u044E,
        \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0438,
        \u0432\u044B\u0434\u0430\u0432\u0430\u0435\u043C\u043E\u0439 \u0420\u043E\u0441\u0437\u0434\u0440\u0430\u0432\u043D\u0430\u0434\u0437\u043E\u0440\u043E\u043C"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[6].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        A\\n\u041F\u0435\u0440\u0435\u0432\u043E\u0437\u043A\u0430 \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u043E\u0432
        \u0430\u0432\u0442\u043E\u0431\u0443\u0441\u0430\u043C\u0438 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
        \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0438 \u043E\u0442 \u0420\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u043D\u0430\u0434\u0437\u043E\u0440\u0430.
        \u0414\u043B\u044F \u0442\u0430\u043A\u0441\u0438 \u043D\u0443\u0436\u043D\u043E
        \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435, \u0434\u043B\u044F
        \u0433\u0440\u0443\u0437\u043E\u0432 \u2014 \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u044F
        \u0432 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0445 \u0441\u043B\u0443\u0447\u0430\u044F\u0445"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[7].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n\u0422\u043E\u0440\u0433\u043E\u0432\u043B\u044F \u043E\u0440\u0443\u0436\u0438\u0435\u043C
        \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0438
        \u043E\u0442 \u041C\u0412\u0414"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[8].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n\u041F\u0440\u043E\u0434\u0430\u0436\u0430 \u0430\u043B\u043A\u043E\u0433\u043E\u043B\u044F
        \u0432 \u043A\u0430\u0444\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
        \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0438 \u043E\u0442 \u0440\u0435\u0433\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0445
        \u043E\u0440\u0433\u0430\u043D\u043E\u0432 \u0438 \u0420\u0410\u0420"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[9].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        A \\n\u0415\u0441\u043B\u0438 \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439
        \u0446\u0435\u043D\u0442\u0440 \u0432\u044B\u0434\u0430\u0451\u0442 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B
        \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
        \u043E\u0431\u0440\u0430\u0437\u0446\u0430, \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u044F
        \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u0430. \u0415\u0441\u043B\u0438
        \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435 \u0432\u0435\u0434\u0451\u0442\u0441\u044F
        \u0431\u0435\u0437 \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E
        \u0434\u0438\u043F\u043B\u043E\u043C\u0430, \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u044F
        \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[0].question
      value: "\u041A\u0430\u043A\u0438\u0435 \u0432\u0438\u0434\u044B \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
        \u0442\u0440\u0435\u0431\u0443\u044E\u0442 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
        \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F?"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[1].question
      value: "\u041A\u0430\u043A\u043E\u0439 \u043E\u0440\u0433\u0430\u043D \u0432\u044B\u0434\u0430\u0451\u0442
        \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0438 \u043D\u0430 \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u0443\u044E
        \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C?"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[2].question
      value: "\u041D\u0430 \u043A\u0430\u043A\u043E\u0439 \u0441\u0440\u043E\u043A
        \u043E\u0431\u044B\u0447\u043D\u043E \u0432\u044B\u0434\u0430\u0451\u0442\u0441\u044F
        \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u044F?"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[3].question
      value: "\u041A\u0442\u043E \u0432\u044B\u0434\u0430\u0451\u0442 \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u044E
        \u043D\u0430 \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u044E \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C\u0438
        \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\u043C\u0438?"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[4].question
      value: "\u041B\u0438\u0446\u0435\u043D\u0437\u0438\u044F \u043D\u0430 \u0447\u0430\u0441\u0442\u043D\u0443\u044E
        \u043E\u0445\u0440\u0430\u043D\u043D\u0443\u044E \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
        \u0432\u044B\u0434\u0430\u0451\u0442\u0441\u044F:"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[5].question
      value: "\u0412\u044B \u0445\u043E\u0442\u0438\u0442\u0435 \u043E\u0442\u043A\u0440\u044B\u0442\u044C
        \u0447\u0430\u0441\u0442\u043D\u0443\u044E \u0441\u0442\u043E\u043C\u0430\u0442\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0443\u044E
        \u043A\u043B\u0438\u043D\u0438\u043A\u0443. \u041A\u0430\u043A\u0443\u044E
        \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u044E \u043D\u0443\u0436\u043D\u043E
        \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C?"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[6].question
      value: "\u0412\u0430\u0448 \u0431\u0438\u0437\u043D\u0435\u0441 \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
        \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u043A\u043E\u0439 \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u043E\u0432
        \u043D\u0430 \u0430\u0432\u0442\u043E\u0431\u0443\u0441\u0430\u0445. \u0427\u0442\u043E
        \u0432\u0430\u043C \u043D\u0443\u0436\u043D\u043E \u0434\u043B\u044F \u043B\u0435\u0433\u0430\u043B\u044C\u043D\u043E\u0439
        \u0440\u0430\u0431\u043E\u0442\u044B?"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[7].question
      value: "\u0412\u044B \u0445\u043E\u0442\u0438\u0442\u0435 \u043E\u0442\u043A\u0440\u044B\u0442\u044C
        \u043C\u0430\u0433\u0430\u0437\u0438\u043D \u0438 \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u0442\u044C
        \u043E\u0440\u0443\u0436\u0438\u0435. \u041A\u0430\u043A\u0430\u044F \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u044F
        \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u0430?"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[8].question
      value: "\u0423 \u0432\u0430\u0441 \u043A\u0430\u0444\u0435, \u0433\u0434\u0435
        \u0432\u044B \u043F\u043B\u0430\u043D\u0438\u0440\u0443\u0435\u0442\u0435
        \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u0442\u044C \u0430\u043B\u043A\u043E\u0433\u043E\u043B\u044C.
        \u0427\u0442\u043E \u043D\u0443\u0436\u043D\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C?"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[9].question
      value: "\u041A\u0430\u043A\u0443\u044E \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u044E
        \u043D\u0443\u0436\u043D\u043E \u0434\u043B\u044F \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
        \u0446\u0435\u043D\u0442\u0440\u0430 \u0441 \u043A\u0443\u0440\u0441\u0430\u043C\u0438
        \u044F\u0437\u044B\u043A\u043E\u0432, \u0432\u044B\u0434\u0430\u044E\u0449\u0435\u0433\u043E
        \u0434\u0438\u043F\u043B\u043E\u043C\u044B?"
      objectReference: {fileID: 0}
