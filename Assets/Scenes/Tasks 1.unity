    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n  \u0417\u043E\u043B\u043E\u0442\u043E, \u0441\u0435\u0440\u0435\u0431\u0440\u043E,
    \u043F\u043B\u0430\u0442\u0438\u043D\u0430 \u0438 \u0434\u0440\u0443\u0433\u0438\u0435
    \u043C\u0435\u0442\u0430\u043B\u043B\u044B.\r\n> \u041F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0430
    \u2013 \u0437\u0430\u0449\u0438\u0442\u0430 \u043E\u0442 \u0438\u043D\u0444\u043B\u044F\u0446\u0438\u0438,
    \u0432\u044B\u0441\u043E\u043A\u0430\u044F \u043B\u0438\u043A\u0432\u0438\u0434\u043D\u043E\u0441\u0442\u044C.\r\n>
    \u041D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043A\u0438 \u2013 \u043D\u0435
    \u043F\u0440\u0438\u043D\u043E\u0441\u044F\u0442 \u0440\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u043E\u0433\u043E
    \u0434\u043E\u0445\u043E\u0434\u0430, \u0446\u0435\u043D\u0430 \u043C\u043E\u0436\u0435\u0442
    \u043A\u043E\u043B\u0435\u0431\u0430\u0442\u044C\u0441\u044F.\r\n\r\n\r\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6d9ad1c49cfdf504faddd7afd3ceae86, type: 2}
  m_sharedMaterial: {fileID: 7286569816844298882, guid: 6d9ad1c49cfdf504faddd7afd3ceae86, type: 2}
