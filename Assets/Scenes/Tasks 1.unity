    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[1].question
      value: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0443\u044E
        \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
        \u044D\u0442\u0430\u043F\u043E\u0432 \u043D\u0430 \u043C\u0435\u0431\u0435\u043B\u044C\u043D\u043E\u0439
        \u0444\u0430\u0431\u0440\u0438\u043A\u0435:"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[2].question
      value: "\u041A\u0430\u043A\u0430\u044F \u0438\u0437 \u0446\u0435\u043B\u0435\u0439
        \u043D\u0435 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u043A
        \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0430\u043C
        \u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u044F \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
        \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0430 \u043D\u0430 \u044D\u0442\u0430\u043F\u044B? "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[3].question
      value: " \u041D\u0430 \u0444\u0430\u0431\u0440\u0438\u043A\u0435 \u043F\u043E
        \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0443
        \u043E\u0434\u0435\u0436\u0434\u044B \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
        4 \u044D\u0442\u0430\u043F\u0430: \u0440\u0430\u0441\u043A\u0440\u043E\u0439,
        \u043F\u043E\u0448\u0438\u0432, \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430,
        \u0443\u043F\u0430\u043A\u043E\u0432\u043A\u0430. \u0427\u0442\u043E \u043F\u0440\u043E\u0438\u0437\u043E\u0439\u0434\u0451\u0442,
        \u0435\u0441\u043B\u0438 \u043E\u0434\u0438\u043D \u0438\u0437 \u044D\u0442\u0430\u043F\u043E\u0432
        \u0441\u0438\u043B\u044C\u043D\u043E \u043E\u0442\u0441\u0442\u0430\u0451\u0442
        \u043F\u043E \u0442\u0435\u043C\u043F\u0443? "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[4].question
      value: "\u0417\u0430\u0447\u0435\u043C \u043D\u0430 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435
