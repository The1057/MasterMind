  m_text: "   \n\n> \u0421\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C
    \u043D\u0430 \u0434\u043E\u043B\u0433\u043E\u0441\u0440\u043E\u0447\u043D\u043E\u043C
    \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0435.\r\n> \u0417\u0430\u0449\u0438\u0442\u0430
    \u043E\u0442 \u0438\u043D\u0444\u043B\u044F\u0446\u0438\u0438 (\u0430\u0440\u0435\u043D\u0434\u043D\u044B\u0435
    \u0441\u0442\u0430\u0432\u043A\u0438 \u0447\u0430\u0441\u0442\u043E \u0440\u0430\u0441\u0442\u0443\u0442
    \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u0446\u0435\u043D\u0430\u043C\u0438).\r\n>
    \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u044C
    \u043F\u0430\u0441\u0441\u0438\u0432\u043D\u044B\u0439 \u0434\u043E\u0445\u043E\u0434.\r\n"
