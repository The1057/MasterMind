  m_text: "\u041F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u043D\u0430\u0447\u0430\u0442\u044C,
    \u0432\u0430\u0436\u043D\u043E \u0438\u0437\u0443\u0447\u0438\u0442\u044C \u043E\u0441\u043D\u043E\u0432\u044B
