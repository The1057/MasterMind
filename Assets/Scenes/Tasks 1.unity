    \u043D\u0430\u043B\u043E\u0433\u043E\u0432\u044B\u0445 \u043B\u044C\u0433\u043E\u0442,
    \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0430\u0446\u0438\u0438 \u0432\u0437\u043D\u043E\u0441\u043E\u0432
    \u0432 \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435 \u0444\u043E\u043D\u0434\u044B
    \u0437\u0430 \u043D\u0430\u0439\u043C \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u044B\u0445
    \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u0439 \u0433\u0440\u0430\u0436\u0434\u0430\u043D.\r\r\r\n>
    \u0413\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
    \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0441\u0442\u0438\u043C\u0443\u043B\u0438\u0440\u0443\u044E\u0442 \u0440\u0430\u0431\u043E\u0442\u043E\u0434\u0430\u0442\u0435\u043B\u0435\u0439:
    \u0432\u044B\u043F\u043B\u0430\u0442\u044B \u0437\u0430 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435
    \u0440\u0430\u0431\u043E\u0447\u0438\u0445 \u043C\u0435\u0441\u0442, \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0430\u0446\u0438\u0438
    \xAB\u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445\xBB \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432.\r\n\r\r\n\n"
