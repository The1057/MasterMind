        \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\u043C\u0438?"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[4].question
      value: "\u041B\u0438\u0446\u0435\u043D\u0437\u0438\u044F \u043D\u0430 \u0447\u0430\u0441\u0442\u043D\u0443\u044E
        \u043E\u0445\u0440\u0430\u043D\u043D\u0443\u044E \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
        \u0432\u044B\u0434\u0430\u0451\u0442\u0441\u044F:"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[5].question
      value: "\u0412\u044B \u0445\u043E\u0442\u0438\u0442\u0435 \u043E\u0442\u043A\u0440\u044B\u0442\u044C
        \u0447\u0430\u0441\u0442\u043D\u0443\u044E \u0441\u0442\u043E\u043C\u0430\u0442\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0443\u044E
        \u043A\u043B\u0438\u043D\u0438\u043A\u0443. \u041A\u0430\u043A\u0443\u044E
        \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u044E \u043D\u0443\u0436\u043D\u043E
        \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C?"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[6].question
      value: "\u0412\u0430\u0448 \u0431\u0438\u0437\u043D\u0435\u0441 \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
        \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u043A\u043E\u0439 \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u043E\u0432
        \u043D\u0430 \u0430\u0432\u0442\u043E\u0431\u0443\u0441\u0430\u0445. \u0427\u0442\u043E
        \u0432\u0430\u043C \u043D\u0443\u0436\u043D\u043E \u0434\u043B\u044F \u043B\u0435\u0433\u0430\u043B\u044C\u043D\u043E\u0439
        \u0440\u0430\u0431\u043E\u0442\u044B?"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[7].question
      value: "\u0412\u044B \u0445\u043E\u0442\u0438\u0442\u0435 \u043E\u0442\u043A\u0440\u044B\u0442\u044C
        \u043C\u0430\u0433\u0430\u0437\u0438\u043D \u0438 \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u0442\u044C
        \u043E\u0440\u0443\u0436\u0438\u0435. \u041A\u0430\u043A\u0430\u044F \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u044F
        \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u0430?"
