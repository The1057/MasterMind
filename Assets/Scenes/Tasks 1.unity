  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n> \u041F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435
    \u2013 \u0437\u0430\u0432\u0438\u0441\u044F\u0442 \u043E\u0442 \u043E\u0431\u044A\u0451\u043C\u0430
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430: \u0441\u044B\u0440\u044C\u0451,
    \u0443\u043F\u0430\u043A\u043E\u0432\u043A\u0430, \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u044D\u043D\u0435\u0440\u0433\u0438\u044F.\r\r\n>
    \u041F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0435 \u2013 \u043D\u0435
    \u0437\u0430\u0432\u0438\u0441\u044F\u0442 \u043E\u0442 \u043E\u0431\u044A\u0451\u043C\u043E\u0432:
    \u0430\u0440\u0435\u043D\u0434\u0430, \u0437\u0430\u0440\u043F\u043B\u0430\u0442\u0430
    \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0446\u0435\u0432, \u043D\u0430\u043B\u043E\u0433\u0438.\r\n\r\r>
    \u041F\u0440\u044F\u043C\u044B\u0435 \u2013 \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E
    \u0441\u0432\u044F\u0437\u0430\u043D\u044B \n\u0441 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C:
    \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B, \u0437\u0430\u0440\u043F\u043B\u0430\u0442\u0430
    \u0440\u0430\u0431\u043E\u0447\u0438\u0445.\r\n>  \u041A\u043E\u0441\u0432\u0435\u043D\u043D\u044B\u0435
    \u2013 \u0441\u0432\u044F\u0437\u0430\u043D\u044B \n\u0441 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u0435\u043C
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430: \u043E\u0445\u0440\u0430\u043D\u0430,
    \u0431\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440\u0438\u044F, \u043B\u043E\u0433\u0438\u0441\u0442\u0438\u043A\u0430."
