  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n3. \u0421\u0435\u0440\u0442\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u044F:\r\n>  
    \u042D\u0442\u043E \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435
    \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435
    \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u0442\u043E\u0432\u0430\u0440 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442
    \u043D\u043E\u0440\u043C\u0430\u043C \u0441\u0442\u0440\u0430\u043D\u044B-\u0438\u043C\u043F\u043E\u0440\u0442\u0451\u0440\u0430.\r\n>  
    \u0411\u0435\u0437 \u0441\u0435\u0440\u0442\u0438\u0444\u0438\u043A\u0430\u0442\u0430
    \u043F\u0440\u043E\u0434\u0430\u0436\u0430 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C
    \u0437\u0430\u043F\u0440\u0435\u0449\u0435\u043D\u0430 \u0438\u043B\u0438 \u0442\u043E\u0432\u0430\u0440
    \u0431\u0443\u0434\u0435\u0442 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0451\u043D.\r\n>  
    \u0412 \u0420\u043E\u0441\u0441\u0438\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
    \u0424\u0435\u0434\u0435\u0440\u0430\u043B\u044C\u043D\u044B\u0439 \u0437\u0430\u043A\u043E\u043D
    \u2116184-\u0424\u0417 \xAB\u041E \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u043C
    \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0438\xBB,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u0435\u0442
    \u0432\u043E\u043F\u0440\u043E\u0441\u044B \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u0441\u0435\u0440\u0442\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u0438.\r\n4.
    \u0420\u0438\u0441\u043A\u0438 \u043F\u0440\u0438 \u044D\u043A\u0441\u043F\u043E\u0440\u0442\u0435:\r\n>  
    \u0412\u044B\u0441\u043E\u043A\u0438\u0435 \u0438\u0437\u0434\u0435\u0440\u0436\u043A\u0438
    \u043D\u0430 \u0441\u0435\u0440\u0442\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u044E
    \u0438 \u0430\u0434\u0430\u043F\u0442\u0430\u0446\u0438\u044E \u043F\u0440\u043E\u0434\u0443\u043A\u0446\u0438\u0438.\r\n>  
    \u0412\u0430\u043B\u044E\u0442\u043D\u044B\u0435 \u043A\u043E\u043B\u0435\u0431\u0430\u043D\u0438\u044F.\r\n>  
    \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0435 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0435
    \u0431\u0430\u0440\u044C\u0435\u0440\u044B (\u043A\u0432\u043E\u0442\u044B, \u0441\u0430\u043D\u043A\u0446\u0438\u0438,
    \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0438).\r\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6d9ad1c49cfdf504faddd7afd3ceae86, type: 2}
