  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n\r> \u0412 \u0420\u043E\u0441\u0441\u0438\u0438 IPO \u043F\u0440\u043E\u0445\u043E\u0434\u044F\u0442
    \u043D\u0430 \u041C\u043E\u0441\u043A\u043E\u0432\u0441\u043A\u043E\u0439 \u0431\u0438\u0440\u0436\u0435,
    \u043D\u043E \u0438\u0445 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0438\u0437-\u0437\u0430
    \u0441\u0430\u043D\u043A\u0446\u0438\u0439 \u0438 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u0439.\r\n>
    \u041A\u0440\u0443\u043F\u043D\u0435\u0439\u0448\u0438\u0435 \u043C\u0438\u0440\u043E\u0432\u044B\u0435
    \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0438 \u0434\u043B\u044F IPO: NYSE,
    NASDAQ, \n> \u0413\u043E\u043D\u043A\u043E\u043D\u0433\u0441\u043A\u0430\u044F
    \u0431\u0438\u0440\u0436\u0430 (HKEX).\r\n> \u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0435
    \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 \u0432\u0441\u0451 \u0447\u0430\u0449\u0435
    \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u0443\u044E\u0442\u0441\u044F
    \u043D\u0430 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439 \u0440\u044B\u043D\u043E\u043A
    \u0438 \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0445
    \u0438\u043D\u0432\u0435\u0441\u0442\u043E\u0440\u043E\u0432.\r\n\n\n"
