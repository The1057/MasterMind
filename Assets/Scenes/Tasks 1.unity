      m_Calls: []
  m_text: "   \n\n1. \u0427\u0435\u0442\u043A\u0438\u0435 \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u043D\u044B\u0435
    \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438.  \r\r\r\r\n2. \u0420\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u0430\u044F
    \u043E\u0431\u0440\u0430\u0442\u043D\u0430\u044F \u0441\u0432\u044F\u0437\u044C
    (1-on-1 \u0432\u0441\u0442\u0440\u0435\u0447\u0438).  \n3. \u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u0430\u044F
    \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u0430, \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u043D\u0430\u044F
    \u043D\u0430 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0438. \r\n\r\r"
