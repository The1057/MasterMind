    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[9].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        D \\n\u0423\u0421\u041D \u043D\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
        \u0438\u0437-\u0437\u0430 \u043F\u0440\u0435\u0432\u044B\u0448\u0435\u043D\u0438\u044F
        \u043B\u0438\u043C\u0438\u0442\u0430 \u0434\u043E\u0445\u043E\u0434\u0430.
        \u041E\u0421\u041D \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u0435\u043D,
        \u0442\u0430\u043A \u043A\u0430\u043A \u043A\u043B\u0438\u0435\u043D\u0442\u044B
        \u0442\u0440\u0435\u0431\u0443\u044E\u0442 \u0443\u043F\u043B\u0430\u0442\u044B
        \u041D\u0414\u0421"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[0].question
      value: "\u0427\u0442\u043E \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442
        \u0432 \u0441\u0435\u0431\u044F \u043F\u043E\u043D\u044F\u0442\u0438\u0435
        \"\u043B\u043E\u0433\u0438\u0441\u0442\u0438\u043A\u0430\" \u043D\u0430 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u043C
        \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u0438?"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[1].question
      value: "\u0427\u0442\u043E \u0442\u0430\u043A\u043E\u0435 \"\u0446\u0435\u043F\u043E\u0447\u043A\u0430
        \u043F\u043E\u0441\u0442\u0430\u0432\u043E\u043A\"?"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[2].question
      value: "\u041A\u0430\u043A\u043E\u0439 \u0438\u0437 \u044D\u0442\u0438\u0445
        \u044D\u0442\u0430\u043F\u043E\u0432 \u0432\u0445\u043E\u0434\u0438\u0442
        \u0432 \u0446\u0435\u043F\u043E\u0447\u043A\u0443 \u043F\u043E\u0441\u0442\u0430\u0432\u043E\u043A?"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[3].question
      value: "\u0427\u0442\u043E \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u043E\u0438\u0437\u043E\u0439\u0442\u0438,
        \u0435\u0441\u043B\u0438 \u043B\u043E\u0433\u0438\u0441\u0442\u0438\u043A\u0430
        \u043D\u0430 \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u0438
        \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u0430\u043D\u0430
        \u043F\u043B\u043E\u0445\u043E? "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[4].question
      value: "\u041A\u0430\u043A\u0438\u0435 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u044F
        \u043F\u043E \u0447\u0438\u0441\u043B\u0443 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432
        \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u044B \u0434\u043B\u044F
        \u0423\u0421\u041D?"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[5].question
      value: "\u041A\u0430\u043A\u0430\u044F \u0438\u0437 \u043C\u043E\u0434\u0435\u043B\u0435\u0439
        \u043F\u043E\u0441\u0442\u0430\u0432\u043E\u043A \u0441\u043D\u0438\u0436\u0430\u0435\u0442
        \u0440\u0438\u0441\u043A\u0438 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438
        \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430? "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[6].question
      value: "\u041A\u0430\u043A\u043E\u0439 \u0438\u0437 \u0432\u0438\u0434\u043E\u0432
        \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u0430 \u043D\u0430\u0438\u043C\u0435\u043D\u0435\u0435
        \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0434\u043B\u044F \u0441\u0440\u043E\u0447\u043D\u043E\u0439
        \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u0438? "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[7].question
      value: "\u0412\u044B \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435
        \u043F\u0435\u043A\u0430\u0440\u043D\u044B\u0435 \u0438\u0437\u0434\u0435\u043B\u0438\u044F.
        \u0427\u0442\u043E \u0431\u0443\u0434\u0435\u0442 \u0443\u0437\u043A\u0438\u043C
        \u043C\u0435\u0441\u0442\u043E\u043C \u0432 \u043B\u043E\u0433\u0438\u0441\u0442\u0438\u043A\u0435,
        \u0435\u0441\u043B\u0438 \u043C\u0443\u043A\u0430 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442
        \u0441 \u043E\u043F\u043E\u0437\u0434\u0430\u043D\u0438\u0435\u043C? "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[8].question
      value: "\u041A\u0430\u043A \u043C\u043E\u0436\u043D\u043E \u0441\u043E\u043A\u0440\u0430\u0442\u0438\u0442\u044C
        \u043B\u043E\u0433\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
        \u0438\u0437\u0434\u0435\u0440\u0436\u043A\u0438?"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[9].question
      value: "\u0423 \u0432\u0430\u0441 \u0431\u0438\u0437\u043D\u0435\u0441, \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0449\u0438\u0439
        \u0441 \u043A\u0440\u0443\u043F\u043D\u044B\u043C\u0438 \u043A\u043B\u0438\u0435\u043D\u0442\u0430\u043C\u0438,
        \u0434\u043B\u044F \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0432\u0430\u0436\u0435\u043D
        \u041D\u0414\u0421. \u0412\u0430\u0448 \u0433\u043E\u0434\u043E\u0432\u043E\u0439
        \u0434\u043E\u0445\u043E\u0434 \u2014 300 \u043C\u043B\u043D \u0440\u0443\u0431\u043B\u0435\u0439,
        \u0440\u0430\u0441\u0445\u043E\u0434\u044B \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442
        180 \u043C\u043B\u043D \u0440\u0443\u0431\u043B\u0435\u0439. \u0427\u0442\u043E
        \u0432\u044B\u0431\u0440\u0430\u0442\u044C?"
      objectReference: {fileID: 0}
