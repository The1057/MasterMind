--- !u!114 &903434953
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 903434951}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 69a3124a7f8a4f342ac1bd89ed3760ee, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  questionPanel: {fileID: 211247466}
  resultPanel: {fileID: 1063295407}
  endPanel: {fileID: 1085397984}
  statementText: {fileID: 291347615}
  timerText: {fileID: 1407879427}
  feedbackText: {fileID: 1930513208}
  explanationText: {fileID: 1811588273}
  questionCounterText: {fileID: 1249673848}
  believeButton: {fileID: 731781791}
  notBelieveButton: {fileID: 403031036}
  nextButton: {fileID: 1816528020}
  restartButton: {fileID: 716621907}
  statements:
  - statement: "\u0412\u0435\u043B\u0438\u043A\u0430\u044F \u0434\u0435\u043F\u0440\u0435\u0441\u0441\u0438\u044F
      \u043D\u0430\u0447\u0430\u043B\u0430\u0441\u044C \u0432 \u0421\u0428\u0410
      \u0432 1929 \u0433\u043E\u0434\u0443"
    isTrue: 1
    correctForm: 0
    explanation: "\u044D\u0442\u043E \u043A\u0440\u0443\u043F\u043D\u0435\u0439\u0448\u0438\u0439
      \u043C\u0438\u0440\u043E\u0432\u043E\u0439 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u043A\u0440\u0438\u0437\u0438\u0441 \u0425\u0425 \u0432\u0435\u043A\u0430"
  - statement: "\u0412 1998 \u0433\u043E\u0434\u0443 \u0432 \u0420\u043E\u0441\u0441\u0438\u0438
      \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u0451\u043B \u0434\u0435\u0444\u043E\u043B\u0442
      \u0438 \u0440\u0435\u0437\u043A\u043E\u0435 \u043F\u0430\u0434\u0435\u043D\u0438\u0435
      \u0440\u0443\u0431\u043B\u044F"
    isTrue: 1
    correctForm: 0
    explanation: "\u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u043E
      \u043E\u0431\u044A\u044F\u0432\u0438\u043B\u043E \u043E \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438
      \u0432\u044B\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0434\u043E\u043B\u0433\u0438"
  - statement: "\u0415\u0432\u0440\u043E \u0431\u044B\u043B \u0432\u0432\u0435\u0434\u0451\u043D
      \u0432 \u043D\u0430\u043B\u0438\u0447\u043D\u043E\u0435 \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u0435
      \u0432 2002 \u0433\u043E\u0434\u0443"
    isTrue: 1
    correctForm: 0
    explanation: "\u0441\u043D\u0430\u0447\u0430\u043B\u0430 (\u0441 1999) \u0435\u0432\u0440\u043E
      \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B \u0442\u043E\u043B\u044C\u043A\u043E
      \u0431\u0435\u0437\u043D\u0430\u043B\u0438\u0447\u043D\u043E"
  - statement: "\u0412 2020 \u0433\u043E\u0434\u0443 \u043C\u0438\u0440\u043E\u0432\u0430\u044F
      \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0430 \u0438\u0441\u043F\u044B\u0442\u0430\u043B\u0430
      \u043A\u0440\u0438\u0437\u0438\u0441 \u0438\u0437-\u0437\u0430 \u043F\u0430\u043D\u0434\u0435\u043C\u0438\u0438
      COVID-19"
    isTrue: 1
    correctForm: 0
    explanation: "\u0431\u044B\u043B \u0440\u0435\u0437\u043A\u0438\u0439 \u0441\u043F\u0430\u0434
      \u0412\u0412\u041F \u0438 \u0437\u0430\u043A\u0440\u044B\u0442\u0438\u0435
      \u0433\u0440\u0430\u043D\u0438\u0446"
  - statement: "\u0410\u043A\u0446\u0438\u0438 \u2014 \u044D\u0442\u043E \u0446\u0435\u043D\u043D\u044B\u0435
      \u0431\u0443\u043C\u0430\u0433\u0438, \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044E\u0449\u0438\u0435
      \u0434\u043E\u043B\u044E \u0432 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438"
    isTrue: 1
    correctForm: 0
    explanation: "\u0432\u043B\u0430\u0434\u0435\u043B\u0435\u0446 \u0430\u043A\u0446\u0438\u0438
      \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0441\u043E\u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0435\u043C
      \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438"
  - statement: "\u0412\u0412\u041F \u041A\u0438\u0442\u0430\u044F \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u043E\u0434\u0438\u043D \u0438\u0437 \u043A\u0440\u0443\u043F\u043D\u0435\u0439\u0448\u0438\u0445
      \u0432 \u043C\u0438\u0440\u0435"
    isTrue: 1
    correctForm: 0
    explanation: "\u0412\u0435\u0440\u044E  \u2014 \u041A\u0438\u0442\u0430\u0439
      \u0432\u0445\u043E\u0434\u0438\u0442 \u0432 \u0442\u043E\u043F-2 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A
      \u043C\u0438\u0440\u0430"
  - statement: "\u0411\u0438\u0442\u043A\u043E\u0438\u043D \u2014 \u044D\u0442\u043E
      \u043F\u0435\u0440\u0432\u0430\u044F \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u0438
      \u043A\u0440\u0438\u043F\u0442\u043E\u0432\u0430\u043B\u044E\u0442\u0430"
    isTrue: 1
    correctForm: 0
    explanation: "\u0411\u0438\u0442\u043A\u043E\u0438\u043D \u0441\u043E\u0437\u0434\u0430\u043D
      \u0432 2009 \u0433\u043E\u0434\u0443"
  - statement: "\u0412 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0433\u0438\u043F\u0435\u0440\u0438\u043D\u0444\u043B\u044F\u0446\u0438\u0438
      \u0446\u0435\u043D\u044B \u043C\u043E\u0433\u0443\u0442 \u0440\u0430\u0441\u0442\u0438
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C"
    isTrue: 1
    correctForm: 0
    explanation: "\u043F\u0440\u0438\u043C\u0435\u0440: \u0413\u0435\u0440\u043C\u0430\u043D\u0438\u044F
      1920-\u0445, \u0417\u0438\u043C\u0431\u0430\u0431\u0432\u0435 2000-\u0445"
  - statement: "\u0415\u0432\u0440\u043E \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
      \u0441 1980-\u0445 \u0433\u043E\u0434\u043E\u0432"
    isTrue: 0
    correctForm: 0
    explanation: "\u0435\u0432\u0440\u043E \u0432\u0432\u0435\u043B\u0438 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0432 1999 (\u0431\u0435\u0437\u043D\u0430\u043B\u0438\u0447\u043D\u043E)
      \u0438 \u0432 2002 (\u043D\u0430\u043B\u0438\u0447\u043D\u043E)"
  - statement: "\u0412\u0435\u043B\u0438\u043A\u0430\u044F \u0434\u0435\u043F\u0440\u0435\u0441\u0441\u0438\u044F
      \u0431\u044B\u043B\u0430 \u0432 \u0420\u043E\u0441\u0441\u0438\u0438 \u0432
      1980-\u0445"
    isTrue: 0
    correctForm: 0
    explanation: "\u043E\u043D\u0430 \u043D\u0430\u0447\u0430\u043B\u0430\u0441\u044C
      \u0432 \u0421\u0428\u0410 \u0432 1929 \u0433\u043E\u0434\u0443 \u0438 \u0437\u0430\u0442\u0440\u043E\u043D\u0443\u043B\u0430
      \u043C\u0438\u0440"
  - statement: "\u0412\u0412\u041F \u2014 \u044D\u0442\u043E \u0441\u0443\u043C\u043C\u0430
      \u0432\u0441\u0435\u0445 \u043D\u0430\u043B\u043E\u0433\u043E\u0432 \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0430"
    isTrue: 0
    correctForm: 0
    explanation: "\u0412\u0412\u041F \u0438\u0437\u043C\u0435\u0440\u044F\u0435\u0442
      \u043E\u0431\u0449\u0438\u0439 \u043E\u0431\u044A\u0451\u043C \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430"
  - statement: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0431\u0438\u0442\u043A\u043E\u0438\u043D
      \u0431\u044B\u043B \u0441\u043E\u0437\u0434\u0430\u043D \u0432 1990 \u0433\u043E\u0434\u0443"
    isTrue: 0
    correctForm: 0
    explanation: "\u043D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435
      \u0432 2009 \u0433\u043E\u0434\u0443"
  - statement: "\u0414\u0435\u0444\u043E\u043B\u0442 \u0432 \u0420\u043E\u0441\u0441\u0438\u0438
      \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u0451\u043B \u0432 2008 \u0433\u043E\u0434\u0443"
    isTrue: 0
    correctForm: 0
    explanation: "\u043D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435
      \u0432 1998 \u0433\u043E\u0434\u0443"
  - statement: "\u0418\u043D\u0444\u043B\u044F\u0446\u0438\u044F \u0432\u0441\u0435\u0433\u0434\u0430
      \u043F\u043E\u043B\u0435\u0437\u043D\u0430 \u0434\u043B\u044F \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0438"
    isTrue: 0
    correctForm: 0
    explanation: "\u0443\u043C\u0435\u0440\u0435\u043D\u043D\u0430\u044F \u043C\u043E\u0436\u0435\u0442
      \u0431\u044B\u0442\u044C \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0439,
      \u043D\u043E \u0433\u0438\u043F\u0435\u0440\u0438\u043D\u0444\u043B\u044F\u0446\u0438\u044F
      \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u0430"
  - statement: "\u0410\u043A\u0446\u0438\u044F \u2014 \u044D\u0442\u043E \u0431\u0430\u043D\u043A\u043E\u0432\u0441\u043A\u0438\u0439
      \u0432\u043A\u043B\u0430\u0434"
    isTrue: 0
    correctForm: 0
    explanation: "\u044D\u0442\u043E \u0446\u0435\u043D\u043D\u0430\u044F \u0431\u0443\u043C\u0430\u0433\u0430,
      \u0434\u0430\u044E\u0449\u0430\u044F \u043F\u0440\u0430\u0432\u0430 \u0432
      \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438"
  numberOfQuestionsToUse: 10
  resultText: {fileID: 1338969987}
