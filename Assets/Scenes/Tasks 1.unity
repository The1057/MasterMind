      m_Calls: []
  m_text: "   \n\n1. \u0410\u043D\u0442\u0438\u0434\u0435\u043C\u043F\u0438\u043D\u0433\u043E\u0432\u044B\u0435
    \u2013 \u0437\u0430\u0449\u0438\u0449\u0430\u044E\u0442 \u0440\u044B\u043D\u043E\u043A
    \u043E\u0442 \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0435\u043D\u043D\u043E
    \u0437\u0430\u043D\u0438\u0436\u0435\u043D\u043D\u044B\u0445 \u0446\u0435\u043D
    \u0438\u043C\u043F\u043E\u0440\u0442\u0430.  \r\r\r\n2. \u041A\u043E\u043C\u043F\u0435\u043D\u0441\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0435
    \u2013 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F \u043F\u0440\u043E\u0442\u0438\u0432
    \u0441\u0443\u0431\u0441\u0438\u0434\u0438\u0440\u0443\u0435\u043C\u043E\u0433\u043E
    \u044D\u043A\u0441\u043F\u043E\u0440\u0442\u0430.  \n3. \u0421\u0435\u0437\u043E\u043D\u043D\u044B\u0435
    \u2013 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0442 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u043D\u0430 \u0441\u0435\u043B\u044C\u0445\u043E\u0437\u043F\u0440\u043E\u0434\u0443\u043A\u0446\u0438\u044E). 
    \r\n\r\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6d9ad1c49cfdf504faddd7afd3ceae86, type: 2}
