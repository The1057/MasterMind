  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n> E (Environment) \u2013 \u044D\u043A\u043E\u043B\u043E\u0433\u0438\u044F:
    \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u0435 \u0432\u044B\u0431\u0440\u043E\u0441\u043E\u0432,
    \u044D\u043D\u0435\u0440\u0433\u043E\u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C,
    \xAB\u0437\u0435\u043B\u0451\u043D\u0430\u044F\xBB \u044D\u043D\u0435\u0440\u0433\u0438\u044F.\r\r\r\n>
    S (Social) \u2013 \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u0430\u044F
    \u0441\u0444\u0435\u0440\u0430: \u0443\u0441\u043B\u043E\u0432\u0438\u044F \u0442\u0440\u0443\u0434\u0430,
    \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C, \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430
    \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430, \u0431\u043B\u0430\u0433\u043E\u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C.\r\n\r\r>
    G (Governance) \u2013 \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u043E\u0435
    \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435: \u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u043E\u0441\u0442\u044C
    \u043E\u0442\u0447\u0451\u0442\u043D\u043E\u0441\u0442\u0438, \u0441\u043E\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435
    \u0437\u0430\u043A\u043E\u043D\u043E\u0434\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430,
    \u0431\u043E\u0440\u044C\u0431\u0430 \u0441 \u043A\u043E\u0440\u0440\u0443\u043F\u0446\u0438\u0435\u0439..\n\r\r\n"
