  m_text: "   \u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u043E\u043C
    \u2014 \u044D\u0442\u043E \u043D\u0435 \"\u043A\u0430\u0440\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F
    \u0441\u0438\u0441\u0442\u0435\u043C\u0430\", \u0430 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442
    \u0434\u043B\u044F \u0440\u043E\u0441\u0442\u0430 \u0431\u0438\u0437\u043D\u0435\u0441\u0430
    \u0438 \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u0430 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432.
