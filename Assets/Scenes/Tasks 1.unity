  m_text: "   \n\n> \u0418\u043D\u0432\u0435\u0441\u0442\u043E\u0440\u044B \u2013
    \u043F\u043E\u043A\u0443\u043F\u0430\u044E\u0442 \u0430\u043A\u0442\u0438\u0432\u044B
    \n\u0441 \u0446\u0435\u043B\u044C\u044E \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F
    \u043F\u0440\u0438\u0431\u044B\u043B\u0438.\r\r\n> \u042D\u043C\u0438\u0442\u0435\u043D\u0442\u044B
    \u2013 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u044E\u0442 \u0430\u043A\u0446\u0438\u0438
    \u0438\u043B\u0438 \u043E\u0431\u043B\u0438\u0433\u0430\u0446\u0438\u0438.\r\n\r>
    \u0411\u0440\u043E\u043A\u0435\u0440\u044B \u2013 \u043F\u043E\u0441\u0440\u0435\u0434\u043D\u0438\u043A\u0438,
    \u0447\u0435\u0440\u0435\u0437 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0441\u043E\u0432\u0435\u0440\u0448\u0430\u044E\u0442\u0441\u044F
    \u0441\u0434\u0435\u043B\u043A\u0438.\r\n\n"
