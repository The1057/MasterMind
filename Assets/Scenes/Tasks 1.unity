  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0414\u043B\u044F \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445
    \u0432\u0438\u0434\u043E\u0432 \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u044F
    \u0438\u043B\u0438 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435
    \u043E\u0442 \u0433\u043E\u0441\u043E\u0440\u0433\u0430\u043D\u043E\u0432.\n\n>
    \u041B\u0438\u0446\u0435\u043D\u0437\u0438\u044F \u2014 \u043F\u0440\u0430\u0432\u043E
    \u043D\u0430 \u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u043F\u043E\u0434 \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
    \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u043C.\r\n\n> \u0420\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435
    \u2014 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435
    \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044F \u043D\u043E\u0440\u043C\u0430\u043C
    (\u0441\u0430\u043D\u0438\u0442\u0430\u0440\u043D\u044B\u043C, \u043F\u043E\u0436\u0430\u0440\u043D\u044B\u043C
    \u0438 \u0434\u0440.).\r\r\n\n"
