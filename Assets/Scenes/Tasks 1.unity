  m_text: "\n> \u0414\u0438\u0444\u0444\u0435\u0440\u0435\u043D\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u043C\u0430\u0440\u043A\u0435\u0442\u0438\u043D\u0433 \u2014 \u0430\u0434\u0430\u043F\u0442\u0430\u0446\u0438\u044F
    \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0430 \u043F\u043E\u0434 \u0440\u0430\u0437\u043D\u044B\u0435
    \u0433\u0440\u0443\u043F\u043F\u044B.\r\n\n>  \u041C\u0430\u0441\u0441\u043E\u0432\u044B\u0439
    \u043C\u0430\u0440\u043A\u0435\u0442\u0438\u043D\u0433 \u2014 \u0435\u0434\u0438\u043D\u043E\u0435
    \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0434\u043B\u044F
    \u0432\u0441\u0435\u0445.\r\r\n\n> \u041D\u0438\u0448\u0435\u0432\u043E\u0439
    \u043C\u0430\u0440\u043A\u0435\u0442\u0438\u043D\u0433 \u2014 \u0443\u0437\u043A\u0438\u0439
    \u0441\u0435\u0433\u043C\u0435\u043D\u0442.\r\n\n> \u041F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
