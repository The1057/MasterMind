  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n\n\u0421\u0442\u0430\u0432\u043A\u0430: 20% (\u0431\u0430\u0437\u043E\u0432\u0430\u044F)\n\n>
    \u041D\u0414\u0421 \u2013 \u044D\u0442\u043E \u043A\u043E\u0441\u0432\u0435\u043D\u043D\u044B\u0439
    \u043D\u0430\u043B\u043E\u0433, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F
    \u0432 \u0446\u0435\u043D\u0443 \u0442\u043E\u0432\u0430\u0440\u043E\u0432 \n\u0438
    \u0443\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0432
    \u0431\u044E\u0434\u0436\u0435\u0442 \u043F\u0440\u0438 \u0440\u0435\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438
    \u043F\u0440\u043E\u0434\u0443\u043A\u0446\u0438\u0438.\n\r\n\u041F\u0440\u0438\u043D\u0446\u0438\u043F:\n\n>
    \u041F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u0435 \u043F\u043B\u0430\u0442\u0438\u0442
    \u041D\u0414\u0421 \u0441 \u043F\u0440\u043E\u0434\u0430\u0436, \u043D\u043E
    \u043C\u043E\u0436\u0435\u0442 \u0432\u044B\u0447\u0435\u0441\u0442\u044C \u041D\u0414\u0421,
    \u0443\u043F\u043B\u0430\u0447\u0435\u043D\u043D\u044B\u0439 \u043F\u0440\u0438
    \u043F\u043E\u043A\u0443\u043F\u043A\u0435 \u0441\u044B\u0440\u044C\u044F \u0438
    \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F.\r\n\r\r\r\n>
    \u041D\u0414\u0421 \u043D\u0435 \u0432\u043B\u0438\u044F\u0435\u0442 \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E
    \u043D\u0430 \u043F\u0440\u0438\u0431\u044B\u043B\u044C, \u043D\u043E \u0442\u0440\u0435\u0431\u0443\u0435\u0442
    \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E\u0433\u043E \u0443\u0447\u0451\u0442\u0430
    \u0438 \u0441\u0432\u043E\u0435\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439
    \u043E\u0442\u0447\u0451\u0442\u043D\u043E\u0441\u0442\u0438.\n\r\r\r\r\n"
