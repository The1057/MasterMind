    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[0].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B\\n \u041E\u0441\u043D\u043E\u0432\u043D\u0430\u044F \u0446\u0435\u043B\u044C
        \u043E\u0442\u0447\u0435\u0442\u043D\u043E\u0441\u0442\u0438 \u2013 \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
        \u0434\u043E\u0441\u0442\u043E\u0432\u0435\u0440\u043D\u0443\u044E \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E
        \u043E \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u043E\u043C \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438
        \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438 \u0434\u043B\u044F
        \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A\u043E\u0432,
        \u0438\u043D\u0432\u0435\u0441\u0442\u043E\u0440\u043E\u0432 \u0438 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u044E\u0449\u0438\u0445
        \u043E\u0440\u0433\u0430\u043D\u043E\u0432.   "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[1].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        C \\n \u041F\u043E\u043B\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442
        \u0433\u043E\u0434\u043E\u0432\u043E\u0439 \u043E\u0442\u0447\u0435\u0442\u043D\u043E\u0441\u0442\u0438
        \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442 \u0432\u0441\u0435 \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u044B\u0435
        \u0444\u043E\u0440\u043C\u044B. \u041C\u0430\u043B\u044B\u0435 \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u044F
        \u043C\u043E\u0433\u0443\u0442 \u0441\u0434\u0430\u0432\u0430\u0442\u044C
        \u0443\u043F\u0440\u043E\u0449\u0435\u043D\u043D\u044B\u0439 \u0432\u0430\u0440\u0438\u0430\u043D\u0442
        (\u0442\u043E\u043B\u044C\u043A\u043E \u0431\u0430\u043B\u0430\u043D\u0441
        \u0438 \u043E\u0442\u0447\u0435\u0442 \u043E \u043F\u0440\u0438\u0431\u044B\u043B\u044F\u0445
        \u0438 \u0443\u0431\u044B\u0442\u043A\u0430\u0445).    "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[2].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        \u0421 \\n \u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438
        \u043E\u0431\u044F\u0437\u0430\u043D\u044B \u0441\u0434\u0430\u0442\u044C
        \u0433\u043E\u0434\u043E\u0432\u0443\u044E \u043E\u0442\u0447\u0435\u0442\u043D\u043E\u0441\u0442\u044C
        \u043D\u0435 \u043F\u043E\u0437\u0434\u043D\u0435\u0435 31 \u043C\u0430\u0440\u0442\u0430
        \u0433\u043E\u0434\u0430, \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
        \u0437\u0430 \u043E\u0442\u0447\u0435\u0442\u043D\u044B\u043C.   "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[3].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B\\n  \u0412\u0441\u0435 \u044E\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043A\u0438\u0435
        \u043B\u0438\u0446\u0430 \u043E\u0431\u044F\u0437\u0430\u043D\u044B \u0432\u0435\u0441\u0442\u0438
        \u0431\u0443\u0445\u0443\u0447\u0435\u0442 \u0438 \u0441\u0434\u0430\u0432\u0430\u0442\u044C
        \u043E\u0442\u0447\u0435\u0442\u043D\u043E\u0441\u0442\u044C. \u0418\u041F
        \u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0434\u0435\u043D\u044B \u043E\u0442
        \u044D\u0442\u043E\u0439 \u043E\u0431\u044F\u0437\u0430\u043D\u043D\u043E\u0441\u0442\u0438
        (\u043D\u043E \u0432\u0435\u0434\u0443\u0442 \u043D\u0430\u043B\u043E\u0433\u043E\u0432\u044B\u0439
        \u0443\u0447\u0435\u0442).   "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[4].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B\\n\u041A\u043E\u043D\u0441\u043E\u043B\u0438\u0434\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F
        \u043E\u0442\u0447\u0435\u0442\u043D\u043E\u0441\u0442\u044C \u043E\u0442\u0440\u0430\u0436\u0430\u0435\u0442
        \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u043E\u0435 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435
        \u0445\u043E\u043B\u0434\u0438\u043D\u0433\u0430 \u0438\u043B\u0438 \u0433\u0440\u0443\u043F\u043F\u044B
        \u0432\u0437\u0430\u0438\u043C\u043E\u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0445
        \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0439.  "
