  m_text: "   \u0413\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
    \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430 \u2013 \u044D\u0442\u043E
    \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u043C\u0435\u0440, \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0445
    \u043D\u0430 \u043F\u043E\u043C\u043E\u0449\u044C \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u044F\u043C
    \u0432 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438, \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u0438
    \u0438\u0437\u0434\u0435\u0440\u0436\u0435\u043A \u0438 \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u0438
    \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0441\u0442\u0438. \u041E\u043D\u0430
    \u043C\u043E\u0436\u0435\u0442 \u0432\u044B\u0440\u0430\u0436\u0430\u0442\u044C\u0441\u044F
    \u0432 \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u043E\u0439, \u043D\u0430\u043B\u043E\u0433\u043E\u0432\u043E\u0439,
    \u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043D\u043E\u0439
    \u0438 \u0438\u043D\u043E\u0439 \u0444\u043E\u0440\u043C\u0435.\n\n"
