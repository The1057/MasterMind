  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   PO (Initial Public Offering) \u2013 \u044D\u0442\u043E \u043F\u0440\u043E\u0446\u0435\u0441\u0441,
    \u043F\u0440\u0438 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F
    \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u0435\u0442
    \u0441\u0432\u043E\u0438 \u0430\u043A\u0446\u0438\u0438 \u043D\u0430 \u0444\u043E\u043D\u0434\u043E\u0432\u043E\u0439
    \u0431\u0438\u0440\u0436\u0435, \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u0438\u0432\u043B\u0435\u0447\u044C
    \u043A\u0430\u043F\u0438\u0442\u0430\u043B \u043E\u0442 \u0448\u0438\u0440\u043E\u043A\u043E\u0433\u043E
    \u043A\u0440\u0443\u0433\u0430 \u0438\u043D\u0432\u0435\u0441\u0442\u043E\u0440\u043E\u0432.\r\n  
    \u0413\u043B\u0430\u0432\u043D\u0430\u044F \u0446\u0435\u043B\u044C IPO \u2013
    \u043F\u0440\u0438\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0435 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
    \u043A\u0430\u043F\u0438\u0442\u0430\u043B\u0430 \u0434\u043B\u044F \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F
    \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 (\u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u0438\u0435
    \u0431\u0438\u0437\u043D\u0435\u0441\u0430, \u0438\u043D\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u0438
    \u0432 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0438, \u0432\u044B\u0445\u043E\u0434
    \u043D\u0430 \u043D\u043E\u0432\u044B\u0435 \u0440\u044B\u043D\u043A\u0438),
    \u0430 \u0442\u0430\u043A\u0436\u0435 \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u0435
    \u0435\u0451 \u0440\u044B\u043D\u043E\u0447\u043D\u043E\u0439 \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u0438
    \u0438 \u0443\u0437\u043D\u0430\u0432\u0430\u0435\u043C\u043E\u0441\u0442\u0438.\r\n\r\n\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6d9ad1c49cfdf504faddd7afd3ceae86, type: 2}
