  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n> \u0423\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435
    \u0434\u043E\u0432\u0435\u0440\u0438\u044F \u0438 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438
    \u0431\u0438\u0437\u043D\u0435\u0441\u0430 \u0441\u0440\u0435\u0434\u0438 \u043C\u0435\u0441\u0442\u043D\u044B\u0445
    \u0436\u0438\u0442\u0435\u043B\u0435\u0439.\r\r\r\n> \u0420\u0430\u0437\u0432\u0438\u0442\u0438\u0435
    \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B\u0430 \u0438 \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u0435
    \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0439 \u043D\u0430\u043F\u0440\u044F\u0436\u0451\u043D\u043D\u043E\u0441\u0442\u0438.\r\n\r\r>
    \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u044C
    \u043B\u044C\u0433\u043E\u0442\u044B, \u0441\u0443\u0431\u0441\u0438\u0434\u0438\u0438
    \u0438\u043B\u0438 \u043F\u0440\u0435\u0444\u0435\u0440\u0435\u043D\u0446\u0438\u0438
    \u043E\u0442 \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0430
    \u0437\u0430 \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u0443\u044E \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C..\r\r\n>
    \u0423\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435 \u0443\u0441\u043B\u043E\u0432\u0438\u0439
    \u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0431\u0438\u0437\u043D\u0435\u0441\u0430
    (\u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C, \u0438\u043D\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0430,
    \u043A\u0430\u0434\u0440\u044B)"
  m_isRightToLeft: 0
