  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n> \u0410\u0434\u0432\u0430\u043B\u043E\u0440\u043D\u044B\u0435
    \u2013 \u043D\u0430\u0447\u0438\u0441\u043B\u044F\u044E\u0442\u0441\u044F \u0432
    % \u043E\u0442 \u0442\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u043E\u0439 \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u0438
    \u0442\u043E\u0432\u0430\u0440\u0430 (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    10% \u043E\u0442 \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u0438 \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u044F). 
    \r\r\r\n> \u0421\u043F\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u2013 \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F
    \u0441\u0443\u043C\u043C\u0430 \u0437\u0430 \u0435\u0434\u0438\u043D\u0438\u0446\u0443
    \u0442\u043E\u0432\u0430\u0440\u0430 (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440
    1 \u0434\u043E\u043B\u043B\u0430\u0440 \u0437\u0430 1 \u043A\u0433 \u043C\u044F\u0441\u0430). 
    \r\n\r\r> \u041A\u043E\u043C\u0431\u0438\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435
    \u2013 \u0441\u043E\u0447\u0435\u0442\u0430\u044E\u0442 \u043E\u0431\u0430 \u043C\u0435\u0442\u043E\u0434\u0430
    (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, 10%, \u043D\u043E \u043D\u0435
    \u043C\u0435\u043D\u0435\u0435 1 \u0434\u043E\u043B\u043B\u0430\u0440\u0430 \u0437\u0430
    \u043A\u0433).  \r\r\n\n"
  m_isRightToLeft: 0
