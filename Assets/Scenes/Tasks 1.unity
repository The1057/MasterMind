  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n > \u0412\u044B\u0431\u0438\u0440\u0430\u0442\u044C \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u0445
    \u0438 \u043D\u0430\u0434\u0451\u0436\u043D\u044B\u0445 \u043F\u043E\u0441\u0442\u0430\u0432\u0449\u0438\u043A\u043E\u0432.\r\n
    > \u0421\u043B\u0435\u0434\u0438\u0442\u044C \u0437\u0430 \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C
    \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0438 \n\u0438 \u0437\u0430\u0433\u0440\u0443\u0436\u0435\u043D\u043D\u043E\u0441\u0442\u044C\u044E
    \u0441\u043A\u043B\u0430\u0434\u0430.\r\n > \u041D\u0435 \u0437\u0430\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C
    \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u043D\u0443\u0436\u043D\u043E
    (\u0443\u0447\u0438\u0442\u044B\u0432\u0430\u0442\u044C \u0442\u0435\u043C\u043F\u044B
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430).\n
    > \u041A\u043E\u043C\u0431\u0438\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0440\u0430\u0437\u043D\u044B\u0435 \u0432\u0438\u0434\u044B \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u0430
    \u0434\u043B\u044F \u0443\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u044F \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u0438.\r\n
    > \u041F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0431\u0443\u0444\u0435\u0440\u043D\u044B\u0439
    \u0437\u0430\u043F\u0430\u0441 \u2013 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439
    \u0440\u0435\u0437\u0435\u0440\u0432 \u043D\u0430 \u0441\u043B\u0443\u0447\u0430\u0439
    \u0437\u0430\u0434\u0435\u0440\u0436\u0435\u043A."
