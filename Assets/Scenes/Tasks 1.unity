  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\n\n\u0420\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044F
    \u0418\u041F:\n\n> \u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B: \u0437\u0430\u044F\u0432\u043B\u0435\u043D\u0438\u0435
    (\u0444\u043E\u0440\u043C\u0430 \u042021001), \u0418\u041D\u041D, \u043A\u0432\u0438\u0442\u0430\u043D\u0446\u0438\u044F
    \u043E \u0433\u043E\u0441\u043F\u043E\u0448\u043B\u0438\u043D\u0435 (800 \u0440\u0443\u0431),
    \u0432\u044B\u0431\u043E\u0440 \u041E\u041A\u0412\u042D\u0414.\r\n\r\n> \u041F\u043E\u0434\u0430\u0447\u0430
    \u0432 \u0424\u041D\u0421 (\u043D\u0430\u043B\u043E\u0433\u043E\u0432\u0443\u044E)
    \u0447\u0435\u0440\u0435\u0437 \u041C\u0424\u0426, \u043B\u0438\u0447\u043D\u043E
    \u0438\u043B\u0438 \u043E\u043D\u043B\u0430\u0439\u043D.\r\n\r\n> \u0420\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044F
    \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442 3 \u0440\u0430\u0431\u043E\u0447\u0438\u0445
    \u0434\u043D\u044F. \u041F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0435 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
    \u043E \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438 \u0438
    \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u0435 \u043E \u0432\u043D\u0435\u0441\u0435\u043D\u0438\u0438
    \u0437\u0430\u043F\u0438\u0441\u0438 \u0432 \u0415\u0413\u0420\u0418\u041F.\r\n\r\n>
    \u0412\u044B\u0431\u043E\u0440 \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u043D\u0430\u043B\u043E\u0433\u043E\u043E\u0431\u043B\u043E\u0436\u0435\u043D\u0438\u044F
    (\u0423\u0421\u041D, \u041F\u0421\u041D, \u041E\u0421\u041D\u041E), \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u0435
    \u0440\u0430\u0441\u0447\u0451\u0442\u043D\u043E\u0433\u043E \u0441\u0447\u0451\u0442\u0430
    \u0438 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044F \u0432
    \u0421\u0424\u0420 \u043F\u0440\u0438 \u043D\u0430\u0439\u043C\u0435 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432.\r\n\r\n"
  m_isRightToLeft: 0
