  m_text: "   \n\n > \u0415\u0441\u043B\u0438 \u0441\u044B\u0440\u044C\u0451 \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
    \u2013 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u043E
    \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F.\r\n
    > \u0415\u0441\u043B\u0438 \u0437\u0430\u043A\u0430\u0437\u0430\u043D\u043E \u0441\u043B\u0438\u0448\u043A\u043E\u043C
    \u043C\u043D\u043E\u0433\u043E \u0441\u044B\u0440\u044C\u044F \u2013 \u0432\u043E\u0437\u043D\u0438\u043A\u0430\u044E\u0442
    \u0438\u0437\u043B\u0438\u0448\u043A\u0438 \u0438 \u043B\u0438\u0448\u043D\u0438\u0435
    \u0437\u0430\u0442\u0440\u0430\u0442\u044B \u043D\u0430 \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435.\r\n
    > \u0415\u0441\u043B\u0438 \u043D\u0435 \u0443\u0447\u0442\u0451\u043D \u043C\u0430\u0440\u0448\u0440\u0443\u0442
    \u2013 \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0430 \u043C\u043E\u0436\u0435\u0442
    \u043E\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u0441\u043B\u0438\u0448\u043A\u043E\u043C
    \u0434\u043E\u0440\u043E\u0433\u043E\u0439 \n\u0438\u043B\u0438 \u0434\u043E\u043B\u0433\u043E\u0439."
