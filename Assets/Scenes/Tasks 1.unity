  m_text: "   \n\n\r> \u041A\u043E\u043C\u043F\u0430\u043D\u0438\u044F \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
    \u043A\u0430\u043F\u0438\u0442\u0430\u043B \u0438 \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442
    \u0440\u044B\u043D\u043E\u0447\u043D\u0443\u044E \u043A\u0430\u043F\u0438\u0442\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044E.\r\n>
    \u041E\u0441\u043D\u043E\u0432\u0430\u0442\u0435\u043B\u0438 \u0438 \u0430\u043A\u0446\u0438\u043E\u043D\u0435\u0440\u044B
    \u043C\u043E\u0433\u0443\u0442 \u043F\u0440\u043E\u0434\u0430\u0442\u044C \u0447\u0430\u0441\u0442\u044C
    \u0434\u043E\u043B\u0435\u0439, \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0432
    \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C.\r\n> \u0418\u043D\u0432\u0435\u0441\u0442\u043E\u0440\u044B
    \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
    \u0432\u043B\u043E\u0436\u0438\u0442\u044C\u0441\u044F \u0432 \u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0435
    \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438.\r\n\n\n"
  m_isRightToLeft: 0
