    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[0].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B\\n  ESG \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u044B\u0432\u0430\u0435\u0442\u0441\u044F
        \u043A\u0430\u043A Environmental (\u044D\u043A\u043E\u043B\u043E\u0433\u0438\u044F),
        Social (\u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u0444\u0435\u0440\u0430),
        Governance (\u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u043E\u0435
        \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435). "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[1].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        A \\n \u042D\u043A\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
        \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442 \u0441\u0432\u044F\u0437\u0430\u043D
        \u0441 \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u044B\u043C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435\u043C
        \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432, \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u0435\u043C
        \u0432\u044B\u0431\u0440\u043E\u0441\u043E\u0432 \u0438 \xAB\u0437\u0435\u043B\u0451\u043D\u043E\u0439\xBB
        \u044D\u043D\u0435\u0440\u0433\u0438\u0435\u0439. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[2].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n \u0423\u0441\u043B\u043E\u0432\u0438\u044F \u0442\u0440\u0443\u0434\u0430,
        \u043E\u0445\u0440\u0430\u043D\u0430 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F
        \u0438 \u0431\u043B\u0430\u0433\u043E\u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
        \u0432\u0445\u043E\u0434\u044F\u0442 \u0432 \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439
        \u0431\u043B\u043E\u043A ESG. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[3].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        A\\n  Governance (\u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435)
        \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u0447\u0435\u0441\u0442\u043D\u043E\u0435
        \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u043E\u0435
        \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435, \u043E\u0442\u0447\u0451\u0442\u043D\u043E\u0441\u0442\u044C
        \u0438 \u0441\u043E\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435 \u0437\u0430\u043A\u043E\u043D\u043E\u0434\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[4].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        C\\n \u0412 \u0415\u0421 \u0441 2024 \u0433\u043E\u0434\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
        CSRD, \u043E\u0431\u044F\u0437\u044B\u0432\u0430\u044E\u0449\u0430\u044F
        \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0442\u044C
        \u0434\u0430\u043D\u043D\u044B\u0435 \u043E\u0431 \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u043C
        \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[5].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n \u0411\u0430\u043D\u043A \u0420\u043E\u0441\u0441\u0438\u0438 \u0432
        2021 \u0433\u043E\u0434\u0443 \u0432\u044B\u043F\u0443\u0441\u0442\u0438\u043B
        \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0430\u0446\u0438\u0438
        \u043F\u043E \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u0438\u044E \u043D\u0435\u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u043E\u0439
        \u043E\u0442\u0447\u0451\u0442\u043D\u043E\u0441\u0442\u0438, \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0445
        \u0441 ESG. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[6].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n\u0413\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u043E \u0438
        \u0438\u043D\u0432\u0435\u0441\u0442\u043E\u0440\u044B \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E\u0442
        \u044D\u043A\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438
        \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
        \u0431\u0438\u0437\u043D\u0435\u0441 \u043D\u0430\u043B\u043E\u0433\u043E\u0432\u044B\u043C\u0438
        \u0441\u0442\u0438\u043C\u0443\u043B\u0430\u043C\u0438 \u0438 \u043F\u043E\u0437\u0438\u0442\u0438\u0432\u043D\u044B\u043C
        \u0438\u043C\u0438\u0434\u0436\u0435\u043C."
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[7].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n\u0415\u0441\u043B\u0438 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F
        \u0438\u0433\u043D\u043E\u0440\u0438\u0440\u0443\u0435\u0442 \u044D\u043A\u043E\u043B\u043E\u0433\u0438\u044E
        \u0438 \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u0443\u044E \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C,
        \u043E\u043D\u0430 \u0440\u0438\u0441\u043A\u0443\u0435\u0442 \u0448\u0442\u0440\u0430\u0444\u0430\u043C\u0438,
        \u043F\u043E\u0442\u0435\u0440\u0435\u0439 \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432
        \u0438 \u0438\u043D\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u0439. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[8].comment
