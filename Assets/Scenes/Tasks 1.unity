  m_text: "   \u041B\u043E\u0433\u0438\u0441\u0442\u0438\u043A\u0430 \u2013 \u044D\u0442\u043E
    \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0435\u043C
    \u0438 \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435\u043C \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432
    \u043D\u0430 \u0432\u0441\u0435\u0445 \u044D\u0442\u0430\u043F\u0430\u0445 \u044D\u0442\u043E\u0439
    \u0446\u0435\u043F\u043E\u0447\u043A\u0438. \n\u041E\u0442 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0439
    \u043B\u043E\u0433\u0438\u0441\u0442\u0438\u043A\u0438 \u0437\u0430\u0432\u0438\u0441\u0438\u0442,
    \u0431\u0443\u0434\u0435\u0442 \u043B\u0438 \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u0435
    \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0431\u0435\u0437 \u0437\u0430\u0434\u0435\u0440\u0436\u0435\u043A
    \u0438\u043B\u0438 \u0432\u0441\u0442\u0430\u043D\u0435\u0442 \u0438\u0437-\u0437\u0430
    \u043D\u0435\u0445\u0432\u0430\u0442\u043A\u0438 \u0441\u044B\u0440\u044C\u044F."
