    m_PersistentCalls:
      m_Calls: []
  m_text: "  \u041F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043B\u0430\u0439\u0444\u0445\u0430\u043A:\n  \u0414\u043B\u044F \u0443\u0447\u0430\u0441\u0442\u0438\u044F
    \u0432 \u0442\u0435\u043D\u0434\u0435\u0440\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F:\n\n>
    \u0410\u043A\u043A\u0440\u0435\u0434\u0438\u0442\u0430\u0446\u0438\u044F \u043D\u0430
    5+ \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u044B\u0445 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0430\u0445\r\r\n>
    \u0424\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u044B\u0435 \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0438
    (\u0434\u043E 30% \u043E\u0442 \u0441\u0443\u043C\u043C\u044B \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0430)\n>
    \u041E\u043F\u044B\u0442 \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F
    \u0430\u043D\u0430\u043B\u043E\u0433\u0438\u0447\u043D\u044B\u0445 \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u043E\u0432
    (3+ \u0433\u043E\u0434\u0430)\n\n   \u041A\u0435\u0439\u0441: \u0420\u043E\u0441\u0442\u0435\u0445 
    \r\n> \u0414\u043E\u043B\u044F \u0433\u043E\u0441\u0437\u0430\u043A\u0430\u0437\u043E\u0432:
    68%\r\n> \u041A\u043B\u044E\u0447\u0435\u0432\u043E\u0439 \u0444\u0430\u043A\u0442\u043E\u0440
    \u0443\u0441\u043F\u0435\u0445\u0430: \u043B\u043E\u0431\u0431\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
    \u0447\u0435\u0440\u0435\u0437 \u043E\u0442\u0440\u0430\u0441\u043B\u0435\u0432\u044B\u0435
    \u0430\u0441\u0441\u043E\u0446\u0438\u0430\u0446\u0438\u0438\r\n"
