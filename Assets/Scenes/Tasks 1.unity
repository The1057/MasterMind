  m_text: "\r\n\r\n\n> CPC \u2014 \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C
    \u043A\u043B\u0438\u043A\u0430.\r\n\n> CTR \u2014 \u043F\u0440\u043E\u0446\u0435\u043D\u0442
    \u043A\u043B\u0438\u043A\u043E\u0432 \u043F\u043E \u0440\u0435\u043A\u043B\u0430\u043C\u0435.\r\n\r\n>
