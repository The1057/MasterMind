  m_text: "   \u041F\u0414\u041D \u2013 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C
    \u0434\u043E\u043B\u0433\u043E\u0432\u043E\u0439 \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0438:\r\n\u041F\u0414\u041D
    (\u0432 \u0420\u0424) = \u0421\u0443\u043C\u043C\u0430 \u0432\u0441\u0435\u0445
    \u0435\u0436\u0435\u043C\u0435\u0441\u044F\u0447\u043D\u044B\u0445 \u043F\u043B\u0430\u0442\u0435\u0436\u0435\u0439
    \u043F\u043E \u043A\u0440\u0435\u0434\u0438\u0442\u0430\u043C \xF7 \u0421\u0440\u0435\u0434\u043D\u0435\u043C\u0435\u0441\u044F\u0447\u043D\u044B\u0439
    \u0434\u043E\u0445\u043E\u0434 \xD7 100%\r\n\u0411\u0430\u043D\u043A\u0438 \u0441\u0447\u0438\u0442\u0430\u044E\u0442
    \u041F\u0414\u041D \u0432\u044B\u0448\u0435 50% \u0432\u044B\u0441\u043E\u043A\u0438\u043C
    \u0440\u0438\u0441\u043A\u043E\u043C.\r\n"
