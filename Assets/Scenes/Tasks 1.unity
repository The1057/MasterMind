  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n> \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u2013
    \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0447\u0435\u0441\u043A\u0438\u0439
    \u0430\u043A\u0442\u0438\u0432. \u0415\u0451 \u043D\u0435\u043B\u044C\u0437\u044F
    \xAB\u043A\u0443\u043F\u0438\u0442\u044C\xBB \u0440\u0435\u043A\u043B\u0430\u043C\u043E\u0439:
    \u043E\u043D\u0430 \u0432\u043E\u0437\u043D\u0438\u043A\u0430\u0435\u0442 \u0438\u0437
    \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0445 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439
    \u0438 \u0432\u0440\u0435\u043C\u0435\u043D\u0438.\r\r\r\n> PR \u2013 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442,
    \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u2013 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442.
    PR \u0442\u0440\u0430\u043D\u0441\u043B\u0438\u0440\u0443\u0435\u0442 \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0435
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0438 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442
    \u0438\u0445 \u0441\u043C\u044B\u0441\u043B \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u0438;
    \u0431\u0435\u0437 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044F
    \u0441\u043B\u043E\u0432\u0430\u043C \u0434\u0435\u043B\u0430 \u044D\u0444\u0444\u0435\u043A\u0442
    \u043D\u0435\u0434\u043E\u043B\u0433\u043E\u0432\u0435\u0447\u0435\u043D.\r\n\r\r> 
    \u041F\u043E\u0436\u0435\u0440\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044F
    \u0438 \u0431\u043B\u0430\u0433\u043E\u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C.
    \u041A\u043E\u0440\u0440\u0435\u043A\u0442\u043D\u043E \u043F\u0440\u043E\u0432\u0435\u0434\u0451\u043D\u043D\u044B\u0435
    \u043F\u043E\u0436\u0435\u0440\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044F
    \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044E\u0442 \u043B\u043E\u044F\u043B\u044C\u043D\u043E\u0441\u0442\u044C
    \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432 \u0438 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E
    \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0443, \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
    \u0435\u0441\u043B\u0438: \u043E\u043D\u0438 \u0440\u0435\u043B\u0435\u0432\u0430\u043D\u0442\u043D\u044B
    \u0431\u0438\u0437\u043D\u0435\u0441\u0443/\u0441\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0443,
    \u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u044B \u0438 \u0438\u0437\u043C\u0435\u0440\u0438\u043C\u044B.\r\r\n"
  m_isRightToLeft: 0
