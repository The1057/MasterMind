  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\n\n    1. \u0414\u043E\u0433\u043E\u0432\u043E\u0440 \u0431\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440\u0441\u043A\u043E\u0433\u043E
    \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F: \u0432\u0435\u0434\u0435\u043D\u0438\u0435
    \u0443\u0447\u0451\u0442\u0430, \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430
    \u043E\u0442\u0447\u0451\u0442\u043D\u043E\u0441\u0442\u0438, \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C
    \u0437\u0430 \u043E\u0448\u0438\u0431\u043A\u0438.\n    2. \u0414\u043E\u0433\u043E\u0432\u043E\u0440
    \u0441 \u043E\u0445\u0440\u0430\u043D\u043D\u043E\u0439 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0435\u0439:
    \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432,
    \u043E\u0431\u044F\u0437\u0430\u043D\u043D\u043E\u0441\u0442\u0438, \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C,
    \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C
    \n\u0437\u0430 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C.\n   
    3. \u0414\u043E\u0433\u043E\u0432\u043E\u0440 \u0441 \u043A\u0430\u0434\u0440\u043E\u0432\u044B\u043C
    \u0430\u0433\u0435\u043D\u0442\u0441\u0442\u0432\u043E\u043C: \u043F\u043E\u0434\u0431\u043E\u0440
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u0430, \u043E\u043F\u043B\u0430\u0442\u0430,
    \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0438 (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u0437\u0430\u043C\u0435\u043D\u0430 \u043A\u0430\u043D\u0434\u0438\u0434\u0430\u0442\u0430).\r\n"
  m_isRightToLeft: 0
