    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[0].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B\\n\u041E\u043F\u0442\u0438\u043C\u0438\u0437\u0430\u0446\u0438\u044F \u2013
        \u044D\u0442\u043E \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u0435 \u0440\u0430\u0441\u0445\u043E\u0434\u043E\u0432
        \u043F\u0440\u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0438
        \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[1].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        C \\n \u0423\u043F\u0430\u043A\u043E\u0432\u043A\u0430 \u0437\u0430\u0432\u0438\u0441\u0438\u0442
        \u043E\u0442 \u043E\u0431\u044A\u0451\u043C\u0430 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430
        \u2013 \u044D\u0442\u043E \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u0430\u044F
        \u0441\u0442\u0430\u0442\u044C\u044F. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[2].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        D \\n\u0410\u0440\u0435\u043D\u0434\u0430 \u043D\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u0442
        \u043E\u0442 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430
        \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0451\u043D\u043D\u043E\u0433\u043E
        \u0442\u043E\u0432\u0430\u0440\u0430. "
