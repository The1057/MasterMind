  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n\n1. \u041F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u043F\u043E\u043B\u043D\u044B\u0439
    \u0430\u0443\u0434\u0438\u0442 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0435\u0439 
    \r\r\r\r\n2. \u0412\u043D\u0435\u0434\u0440\u0438\u0442\u044C \u0441\u0438\u0441\u0442\u0435\u043C\u0443
    KPI \u043F\u043E \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438 
    \n3. \u0417\u0430\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0434\u043E\u0433\u043E\u0432\u043E\u0440
    \u0441\u043E \u0441\u0442\u0440\u0430\u0445\u043E\u0432\u043E\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439
    \n4. \u041E\u0431\u0443\u0447\u0438\u0442\u044C \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F\u043C \u043F\u0440\u0438 \u0427\u0421 
    \n5. \u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0441\u0438\u0441\u0442\u0435\u043C\u044B
    \u043C\u043E\u043D\u0438\u0442\u043E\u0440\u0438\u043D\u0433\u0430 (\u0434\u0430\u0442\u0447\u0438\u043A\u0438
    \u0433\u0430\u0437\u0430, \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u044B) 
    \r\n\r\n\r\r"
  m_isRightToLeft: 0
