  m_text: "   \n\n\n1. \u041C\u043E\u0433\u0443\u0442 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0442\u044C
    \u0443\u043F\u0440\u043E\u0449\u0435\u043D\u043D\u044B\u0435 \u0444\u043E\u0440\u043C\u044B
    \u043E\u0442\u0447\u0435\u0442\u043D\u043E\u0441\u0442\u0438.  \r\r\r\n2. \u0412\u043F\u0440\u0430\u0432\u0435
    \u043D\u0435 \u0432\u043A\u043B\u044E\u0447\u0430\u0442\u044C \u043E\u0442\u0447\u0435\u0442
    \u043E \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0438 \u0434\u0435\u043D\u0435\u0436\u043D\u044B\u0445
    \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u0438 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u044F. 
    \r\n3. \u0412\u043E\u0437\u043C\u043E\u0436\u0435\u043D \u043A\u0430\u0441\u0441\u043E\u0432\u044B\u0439
    \u043C\u0435\u0442\u043E\u0434 \u0443\u0447\u0435\u0442\u0430 (\u0432\u043C\u0435\u0441\u0442\u043E
    \u043C\u0435\u0442\u043E\u0434\u0430 \u043D\u0430\u0447\u0438\u0441\u043B\u0435\u043D\u0438\u044F). 
    \r\n\r\r"
  m_isRightToLeft: 0
