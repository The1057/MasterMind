  m_text: "   \u0412\u044B\u0431\u043E\u0440 \u0444\u043E\u0440\u043C\u044B \u0437\u0430\u0432\u0438\u0441\u0438\u0442
    \u043E\u0442 \u0446\u0435\u043B\u0435\u0439 \u0431\u0438\u0437\u043D\u0435\u0441\u0430:
    \u0435\u0441\u043B\u0438 \u0432\u0430\u0436\u043D\u043E \u0431\u044B\u0441\u0442\u0440\u043E
    \u043D\u0430\u0447\u0430\u0442\u044C \u0438 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
    \u043E\u0434\u043D\u043E\u043C\u0443 \u2014 \u043F\u0440\u043E\u0449\u0435 \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0418\u041F, \u0435\u0441\u043B\u0438 \u043F\u043B\u0430\u043D\u0438\u0440\u0443\u0435\u0442\u0441\u044F
    \u0440\u043E\u0441\u0442 \u0438 \u043F\u0430\u0440\u0442\u043D\u0435\u0440\u0441\u0442\u0432\u043E
    \u2014 \u043B\u0443\u0447\u0448\u0435 \u041E\u041E\u041E.\r\n"
