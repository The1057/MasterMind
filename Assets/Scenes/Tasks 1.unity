  m_text: "\u0418\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u044B\u0439
    \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C
    (\u0418\u041F) \u2014 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u043B\u0438\u0446\u043E, \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0435
    \u0434\u043B\u044F \u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0431\u0438\u0437\u043D\u0435\u0441\u0430
    \u0438 \u043E\u0442\u0432\u0435\u0447\u0430\u044E\u0449\u0435\u0435 \u0432\u0441\u0435\u043C
    \u0441\u0432\u043E\u0438\u043C \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u043C
    (\u0441\u0442. 24 \u0413\u041A \u0420\u0424). \u0420\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044F
    \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0437\u0430\u044F\u0432\u043B\u0435\u043D\u0438\u044F,
    \u043F\u0430\u0441\u043F\u043E\u0440\u0442\u0430, \u0433\u043E\u0441\u043F\u043E\u0448\u043B\u0438\u043D\u044B.
    \n  \u0418\u041F \u043C\u043E\u0436\u0435\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
    \u043D\u0430 \u043E\u0431\u0449\u0435\u0439, \u0443\u043F\u0440\u043E\u0449\u0435\u043D\u043D\u043E\u0439
    \u0438\u043B\u0438 \u043F\u0430\u0442\u0435\u043D\u0442\u043D\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u0435
    \u043D\u0430\u043B\u043E\u0433\u043E\u043E\u0431\u043B\u043E\u0436\u0435\u043D\u0438\u044F,
    \u0430 \u0442\u0430\u043A\u0436\u0435 \u043C\u043E\u0436\u0435\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u0435\u0434\u0438\u043D\u044B\u0439 \u0441\u0435\u043B\u044C\u0441\u043A\u043E\u0445\u043E\u0437\u044F\u0439\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u043D\u0430\u043B\u043E\u0433 \u0438\u043B\u0438 \u043D\u0430\u043B\u043E\u0433
    \u043D\u0430 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439
    \u0434\u043E\u0445\u043E\u0434, \u043D\u043E \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0442\u044C
    \u0438\u043D\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u0438 \u0441\u043B\u043E\u0436\u043D\u043E.\r"
  m_isRightToLeft: 0
