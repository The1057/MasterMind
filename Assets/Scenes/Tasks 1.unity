--- !u!114 &854628926
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 854628924}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "      \n\n\n\u041F\u0440\u0438\u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F
    \u043D\u0435 \u043A\u043E \u0432\u0441\u0435\u043C \u0432\u0438\u0434\u0430\u043C
    \u043F\u0440\u043E\u0434\u0443\u043A\u0446\u0438\u0438.\n\n> \u042D\u0442\u043E
    \u043A\u043E\u0441\u0432\u0435\u043D\u043D\u044B\u0435 \u043D\u0430\u043B\u043E\u0433\u0438
    \u043D\u0430 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0435 \u0432\u0438\u0434\u044B
    \u0442\u043E\u0432\u0430\u0440\u043E\u0432, \u043A\u0430\u043A \u043F\u0440\u0430\u0432\u0438\u043B\u043E
    - \u043F\u043E\u0434\u0430\u043A\u0446\u0438\u0437\u043D\u044B\u0435 (\u0430\u043B\u043A\u043E\u0433\u043E\u043B\u044C,
    \u0442\u0430\u0431\u0430\u043A, \u0431\u0435\u043D\u0437\u0438\u043D \u0438 \u0442.\u043F.).\r\n>
    \u0415\u0441\u043B\u0438 \u0432\u0430\u0448\u0430 \u0444\u0430\u0431\u0440\u0438\u043A\u0430
    \u043D\u0435 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442 \u043F\u043E\u0434\u0430\u043A\u0446\u0438\u0437\u043D\u0443\u044E
    \u043F\u0440\u043E\u0434\u0443\u043A\u0446\u0438\u044E, \u0430\u043A\u0446\u0438\u0437\u044B
    \u0432\u0430\u0441 \u043D\u0435 \u043A\u0430\u0441\u0430\u044E\u0442\u0441\u044F.\r\n>
    \u041E\u0434\u043D\u0430\u043A\u043E \u0435\u0441\u043B\u0438 \u0438\u0433\u0440\u043E\u043A
    \u0440\u0435\u0448\u0438\u0442 \u043E\u0442\u043A\u0440\u044B\u0442\u044C, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u043C\u0438\u043D\u0438-\u0437\u0430\u0432\u043E\u0434 \n\u043F\u043E \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0443
    \u044D\u043D\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043D\u0430\u043F\u0438\u0442\u043A\u043E\u0432, \u0430\u043A\u0446\u0438\u0437\u044B
    \u0431\u0443\u0434\u0443\u0442 \u0443\u0447\u0442\u0435\u043D\u044B.\r\n\n\u041E\u0431\u044F\u0437\u0430\u043D\u043D\u043E\u0441\u0442\u0438
    \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u044F:\n\n> \u0412\u0435\u0441\u0442\u0438
    \u043D\u0430\u043B\u043E\u0433\u043E\u0432\u044B\u0439 \u0443\u0447\u0451\u0442
    (\u041D\u0414\u0421, \u043F\u0440\u0438\u0431\u044B\u043B\u044C, \u0441\u0442\u0440\u0430\u0445\u043E\u0432\u044B\u0435
    \u0432\u0437\u043D\u043E\u0441\u044B \u0438 \u043F\u0440.)\n\r> \u0421\u0434\u0430\u0432\u0430\u0442\u044C
    \u043D\u0430\u043B\u043E\u0433\u043E\u0432\u0443\u044E \u043E\u0442\u0447\u0451\u0442\u043D\u043E\u0441\u0442\u044C\n>
    \u0423\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u0442\u044C \u043D\u0430\u043B\u043E\u0433\u0438
    \u0432 \u0441\u0440\u043E\u043A, \u0447\u0442\u043E\u0431\u044B \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044C
    \u0448\u0442\u0440\u0430\u0444\u043E\u0432\n"
  m_isRightToLeft: 0
