--- !u!114 &1155967252
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1155967250}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \u0413\u043E\u0434\u043E\u0432\u0430\u044F \u043E\u0442\u0447\u0435\u0442\u043D\u043E\u0441\u0442\u044C
    \u0441\u0434\u0430\u0435\u0442\u0441\u044F \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438
    \u043E\u0442 \u044E\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0444\u043E\u0440\u043C\u044B:\n\n> \u0414\u043B\u044F \u041E\u041E\u041E \u0438
    \u0410\u041E \u2013 \u0434\u043E 31 \u043C\u0430\u0440\u0442\u0430 (\u0435\u0441\u043B\u0438
    31 \u043C\u0430\u0440\u0442\u0430 \u2013 \u0432\u044B\u0445\u043E\u0434\u043D\u043E\u0439,
    \u0441\u0440\u043E\u043A \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442\u0441\u044F). 
    \n> \u0414\u043B\u044F \u0441\u0443\u0431\u044A\u0435\u043A\u0442\u043E\u0432
    \u041C\u0421\u041F (\u0443\u043F\u0440\u043E\u0449\u0435\u043D\u043A\u0430) \u2013
    \u0434\u043E 31 \u043C\u0430\u0440\u0442\u0430, \u043D\u043E \u043C\u043E\u0433\u0443\u0442
    \u0441\u0434\u0430\u0432\u0430\u0442\u044C \u043F\u043E \u0441\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u043D\u044B\u043C
    \u0444\u043E\u0440\u043C\u0430\u043C.  \n\n   \u041F\u0440\u043E\u043C\u0435\u0436\u0443\u0442\u043E\u0447\u043D\u0430\u044F
    \u043E\u0442\u0447\u0435\u0442\u043D\u043E\u0441\u0442\u044C \u043E\u0431\u044B\u0447\u043D\u043E
    \u043D\u0435 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u0430,
    \u043D\u043E \u043C\u043E\u0436\u0435\u0442 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C\u0441\u044F
    \u0431\u0430\u043D\u043A\u0430\u043C\u0438 \u0438\u043B\u0438 \u0443\u0447\u0440\u0435\u0434\u0438\u0442\u0435\u043B\u044F\u043C\u0438.  "
  m_isRightToLeft: 0
