  m_text: "\n\n\n> \u0410\u0441\u0441\u043E\u0440\u0442\u0438\u043C\u0435\u043D\u0442
    \u0438 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E: \u0442\u043E\u0432\u0430\u0440\u043E\u0432,
    \u043E\u0431\u044A\u0451\u043C \u043F\u043E\u0441\u0442\u0430\u0432\u043E\u043A.\r\r\n\r\n>
    \u0421\u0440\u043E\u043A\u0438 \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0438:
    \u0446\u0435\u043D\u0430, \u0440\u0430\u0441\u0447\u0451\u0442\u044B.\r\r.\r\n\r\n>
    \u041E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C
    \u0437\u0430 \u0431\u0440\u0430\u043A: \u0443\u0441\u043B\u043E\u0432\u0438\u044F
    \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u0430 \u0442\u043E\u0432\u0430\u0440\u0430.\r\n\u0412\u0438\u0434\u044B:
    \u0440\u0430\u0437\u043E\u0432\u044B\u0439 \u0438 \u0434\u043E\u043B\u0433\u043E\u0441\u0440\u043E\u0447\u043D\u044B\u0439
    \u0434\u043E\u0433\u043E\u0432\u043E\u0440 \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u0438.\r\n\r\n\n\r\n"
