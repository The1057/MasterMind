  m_text: "   \u0422\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u044B\u0435 \u043F\u043E\u0448\u043B\u0438\u043D\u044B
    \u2013 \u0432\u0430\u0436\u043D\u044B\u0439 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442
    \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043F\u043E\u043B\u0438\u0442\u0438\u043A\u0438, \u0432\u043B\u0438\u044F\u044E\u0449\u0438\u0439
    \u043D\u0430 \u0446\u0435\u043D\u044B, \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0446\u0438\u044E
    \u0438 \u0431\u044E\u0434\u0436\u0435\u0442. \u041F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u0435
    \u0438\u0445 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u043E\u0432 \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442
    \u0431\u0438\u0437\u043D\u0435\u0441\u0443 \u043C\u0438\u043D\u0438\u043C\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C
