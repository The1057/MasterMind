  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n   \u0418\u043D\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u0438
    \u0432 \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u044B, \u0434\u043E\u043C\u0430,
    \u043A\u043E\u043C\u043C\u0435\u0440\u0447\u0435\u0441\u043A\u0443\u044E \u043D\u0435\u0434\u0432\u0438\u0436\u0438\u043C\u043E\u0441\u0442\u044C.
    \u0414\u043E\u0445\u043E\u0434 \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u0441\u0442\u0443\u043F\u0430\u0442\u044C
    \u0432 \u0432\u0438\u0434\u0435:\r\n> \u0430\u0440\u0435\u043D\u0434\u044B,\r\n>
    \u043F\u0440\u0438\u0440\u043E\u0441\u0442\u0430 \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u0438
    \u043F\u0440\u0438 \u043F\u0440\u043E\u0434\u0430\u0436\u0435.\r\n \u041D\u0435\u0434\u0432\u0438\u0436\u0438\u043C\u043E\u0441\u0442\u044C
    \u2013 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u044B\u0439 \u0430\u043A\u0442\u0438\u0432,
    \u043D\u043E \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u0438\u0445
    \u0432\u043B\u043E\u0436\u0435\u043D\u0438\u0439 \u0438 \u043D\u0438\u0437\u043A\u043E\u043B\u0438\u043A\u0432\u0438\u0434\u0435\u043D
    (\u0441\u043B\u043E\u0436\u043D\u043E \u0431\u044B\u0441\u0442\u0440\u043E \u043F\u0440\u043E\u0434\u0430\u0442\u044C).\r\n\n"
