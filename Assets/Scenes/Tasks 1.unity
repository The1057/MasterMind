  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n\n> \u0424\u041C\u0421 \u0441\u043E\u0437\u0434\u0430\u044E\u0442\u0441\u044F
    \u043A\u0430\u043A \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0438
    \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0439 \u0438\u043D\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u044B
    \u043D\u0430 \u043C\u0438\u043A\u0440\u043E\u0443\u0440\u043E\u0432\u043D\u0435,
    \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u044F\u044F \u0433\u0440\u0430\u0436\u0434\u0430\u043D,
    \u0431\u0438\u0437\u043D\u0435\u0441 \u0438 \u0432\u043B\u0430\u0441\u0442\u044C.\r\r\r\n>
    \u0414\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0442 \u043F\u043E \u043A\u043E\u043D\u043A\u0443\u0440\u0441\u0430\u043C,
    \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442
    \u0433\u0440\u0430\u043D\u0442\u044B, \u0440\u0435\u0441\u0443\u0440\u0441\u044B
    \u043C\u0435\u0441\u0442\u043D\u044B\u043C \u043F\u0440\u043E\u0435\u043A\u0442\u0430\u043C.\r\n\r\r\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6d9ad1c49cfdf504faddd7afd3ceae86, type: 2}
  m_sharedMaterial: {fileID: 7286569816844298882, guid: 6d9ad1c49cfdf504faddd7afd3ceae86, type: 2}
