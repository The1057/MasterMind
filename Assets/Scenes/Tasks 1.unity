    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[4].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        D\\n\u0410\u043D\u0442\u0438\u0434\u0435\u043C\u043F\u0438\u043D\u0433\u043E\u0432\u044B\u0435
        \u043F\u043E\u0448\u043B\u0438\u043D\u044B \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F
        \u0434\u043B\u044F \u0437\u0430\u0449\u0438\u0442\u044B \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0433\u043E
        \u0440\u044B\u043D\u043A\u0430 \u043E\u0442 \u0438\u043C\u043F\u043E\u0440\u0442\u0430
        \u0442\u043E\u0432\u0430\u0440\u043E\u0432 \u043F\u043E \u0446\u0435\u043D\u0430\u043C
        \u043D\u0438\u0436\u0435 \u0438\u0445 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0439
        \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u0438 \u0432 \u0441\u0442\u0440\u0430\u043D\u0435
        \u044D\u043A\u0441\u043F\u043E\u0440\u0442\u0430. "
