  m_text: "   \u041E\u043F\u0442\u0438\u043C\u0438\u0437\u0430\u0446\u0438\u044F
    \u0437\u0430\u0442\u0440\u0430\u0442 \u2013 \u044D\u0442\u043E \u043F\u0440\u043E\u0446\u0435\u0441\u0441
    \u0430\u043D\u0430\u043B\u0438\u0437\u0430 \u0438 \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u044F
    \u0440\u0430\u0441\u0445\u043E\u0434\u043E\u0432 \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u044F
    \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u0438 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430
    \u043F\u0440\u043E\u0434\u0443\u043A\u0446\u0438\u0438. \u041E\u043D\u0430 \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442
    \u043F\u043E\u0432\u044B\u0441\u0438\u0442\u044C \u043F\u0440\u0438\u0431\u044B\u043B\u044C
    \u0438 \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0441\u0442\u044C
    \u0431\u0438\u0437\u043D\u0435\u0441\u0430.\r\n"
