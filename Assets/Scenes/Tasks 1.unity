  m_text: "   \u0422\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u0430\u044F \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C
    \u0442\u043E\u0432\u0430\u0440\u0430 - \u044D\u0442\u043E \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C
    \u0442\u043E\u0432\u0430\u0440\u0430, \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435
    \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u044E\u0442\u0441\u044F
    \u043F\u043E\u0448\u043B\u0438\u043D\u044B \u0438 \u043D\u0430\u043B\u043E\u0433\u0438.
    \u0412\u043A\u043B\u044E\u0447\u0430\u0435\u0442: \n> \u0426\u0435\u043D\u0443
    \u0442\u043E\u0432\u0430\u0440\u0430 \u043F\u043E \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0443. 
    \n> \u0420\u0430\u0441\u0445\u043E\u0434\u044B \u043D\u0430 \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u043A\u0443,
    \u0441\u0442\u0440\u0430\u0445\u043E\u0432\u0430\u043D\u0438\u0435, \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435."
  m_isRightToLeft: 0
