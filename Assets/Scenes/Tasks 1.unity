  m_text: "   \n\n\n\n>  \u0422\u0435\u0445\u043D\u043E\u0433\u0435\u043D\u043D\u044B\u0435
    (\u0430\u0432\u0430\u0440\u0438\u0438, \u043F\u043E\u043B\u043E\u043C\u043A\u0438
    \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F)\r\r\r\r\n>
    \u041F\u0440\u0438\u0440\u043E\u0434\u043D\u044B\u0435 (\u043D\u0430\u0432\u043E\u0434\u043D\u0435\u043D\u0438\u044F,
    \u0437\u0435\u043C\u043B\u0435\u0442\u0440\u044F\u0441\u0435\u043D\u0438\u044F)\r\r\n\r\r>
    \u042D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    (\u043A\u043E\u043B\u0435\u0431\u0430\u043D\u0438\u044F \u0446\u0435\u043D, \u0438\u043D\u0444\u043B\u044F\u0446\u0438\u044F)\r\r\n>
    \u042E\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043A\u0438\u0435 (\u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0435
    \u0437\u0430\u043A\u043E\u043D\u043E\u0434\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430)\n>
    \u041A\u0430\u0434\u0440\u043E\u0432\u044B\u0435 (\u0442\u0440\u0430\u0432\u043C\u0430\u0442\u0438\u0437\u043C,
    \u0442\u0435\u043A\u0443\u0447\u0435\u0441\u0442\u044C \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u0430)\n\n\u041F\u0440\u0438\u043C\u0435\u0440: 
    \r\n\u041D\u0430 \u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u043C
    \u0437\u0430\u0432\u043E\u0434\u0435 \u043A \u0442\u0435\u0445\u043D\u043E\u0433\u0435\u043D\u043D\u044B\u043C
    \u0440\u0438\u0441\u043A\u0430\u043C \u043E\u0442\u043D\u043E\u0441\u044F\u0442
    \u0443\u0442\u0435\u0447\u043A\u0443 \u043E\u043F\u0430\u0441\u043D\u044B\u0445
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432, \u0430 \u043A \u043A\u0430\u0434\u0440\u043E\u0432\u044B\u043C
    \u2014 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0435
    \u0437\u0430\u0431\u043E\u043B\u0435\u0432\u0430\u043D\u0438\u044F \u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A\u043E\u0432.\r\n"
