    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[0].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n\u0426\u0435\u043D\u043E\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435
        \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043E \u043D\u0430
        \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u0435 \u043F\u0440\u0438\u0431\u044B\u043B\u044C\u043D\u043E\u0441\u0442\u0438
        \u0431\u0438\u0437\u043D\u0435\u0441\u0430, \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435
        \u0437\u0430\u0442\u0440\u0430\u0442 \u0438 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435
        \u043F\u043B\u0430\u0442\u0435\u0436\u0435\u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438
        \u043F\u043E\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043B\u0435\u0439"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[1].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n\u0421\u0435\u0431\u0435\u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C
        \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442 \u0432\u0441\u0435 \u0437\u0430\u0442\u0440\u0430\u0442\u044B,
        \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0435 \u0441 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C
        \u0438 \u0440\u0435\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0435\u0439
        \u043F\u0440\u043E\u0434\u0443\u043A\u0446\u0438\u0438, \u0432\u043A\u043B\u044E\u0447\u0430\u044F
        \u043E\u043F\u043B\u0430\u0442\u0443 \u0442\u0440\u0443\u0434\u0430, \u0430\u0440\u0435\u043D\u0434\u0443,
        \u043B\u043E\u0433\u0438\u0441\u0442\u0438\u043A\u0443 \u0438 \u043C\u0430\u0440\u043A\u0435\u0442\u0438\u043D\u0433"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[2].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        C \\n\u041A\u043E\u0433\u0434\u0430 \u0441\u043F\u0440\u043E\u0441 \u043F\u0440\u0435\u0432\u044B\u0448\u0430\u0435\u0442
        \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435, \u0434\u0435\u0444\u0438\u0446\u0438\u0442
        \u0442\u043E\u0432\u0430\u0440\u043E\u0432 \u043D\u0430 \u0440\u044B\u043D\u043A\u0435
        \u043F\u0440\u0438\u0432\u043E\u0434\u0438\u0442 \u043A \u0440\u043E\u0441\u0442\u0443
        \u0446\u0435\u043D"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[3].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        C\\n\u041C\u0435\u0442\u043E\u0434 \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D
        \u043D\u0430 \u0446\u0435\u043D\u044B \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u043E\u0432,
        \u0447\u0442\u043E\u0431\u044B \u0431\u0438\u0437\u043D\u0435\u0441 \u043C\u043E\u0433
        \u0443\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C
        \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C \u043D\u0430 \u043E\u0434\u043D\u043E\u043C
        \u0443\u0440\u043E\u0432\u043D\u0435, \u043D\u0438\u0436\u0435 \u0438\u043B\u0438
        \u0432\u044B\u0448\u0435 \u0438\u0445 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0439"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[4].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        A \\n\u041C\u0435\u0442\u043E\u0434 '\u0441\u0435\u0431\u0435\u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C
        + \u043D\u0430\u0446\u0435\u043D\u043A\u0430' \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
        \u0441\u0435\u0431\u0435\u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C
        \u0438 \u043F\u0440\u043E\u0446\u0435\u043D\u0442 \u043D\u0430\u0446\u0435\u043D\u043A\u0438,
        \u0432\u0430\u0440\u044C\u0438\u0440\u0443\u0435\u043C\u044B\u0439 \u0434\u043B\u044F
        \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u044F \u043F\u0440\u0438\u0431\u044B\u043B\u0438"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[5].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        C \\n\u041C\u0435\u0442\u043E\u0434 \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u0438
        \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D
        \u043D\u0430 \u0432\u043E\u0441\u043F\u0440\u0438\u044F\u0442\u0438\u0435
        \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0430 \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044F\u043C\u0438,
        \u0430 \u043D\u0435 \u043D\u0430 \u0441\u0435\u0431\u0435\u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C
        \u0438\u043B\u0438 \u0446\u0435\u043D\u044B \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u043E\u0432.
        \u0427\u0430\u0441\u0442\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
        \u0434\u043B\u044F \u043F\u0440\u0435\u043C\u0438\u0430\u043B\u044C\u043D\u044B\u0445
        \u0438 \u0431\u0440\u0435\u043D\u0434\u043E\u0432\u044B\u0445 \u0442\u043E\u0432\u0430\u0440\u043E\u0432"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[6].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        D \\n\u0414\u0438\u043D\u0430\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0435
        \u0446\u0435\u043D\u043E\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435
        \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442
        \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E\u0435 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0435
        \u0446\u0435\u043D \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438
        \u043E\u0442 \u0440\u044B\u043D\u043E\u0447\u043D\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u0439.
        \u041F\u0440\u0438\u043C\u0435\u0440\u044B: \u0430\u0432\u0438\u0430\u0431\u0438\u043B\u0435\u0442\u044B,
        \u0433\u043E\u0441\u0442\u0438\u043D\u0438\u0446\u044B, \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u043D\u044B\u0435
        \u0443\u0441\u043B\u0443\u0433\u0438"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[7].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        D \\n\u041F\u0440\u0438 \u0423\u0421\u041D 6% \u043F\u043B\u0430\u0442\u0438\u0442\u0441\u044F
        \u043D\u0430\u043B\u043E\u0433 6% \u043E\u0442 \u0432\u044B\u0440\u0443\u0447\u043A\u0438,
        \u043D\u0435 \u0432\u043B\u0438\u044F\u044E\u0449\u0438\u0439 \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E
        \u043D\u0430 \u0446\u0435\u043D\u0443 \u0442\u043E\u0432\u0430\u0440\u0430"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[8].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        A \\n\u041F\u0440\u0438 \u0441\u0442\u0430\u0432\u043A\u0435 \u041D\u0414\u0421
        20% \u0444\u043E\u0440\u043C\u0443\u043B\u0430 \u0440\u0430\u0441\u0447\u0451\u0442\u0430:
        \u0426\u0435\u043D\u0430 \u0431\u0435\u0437 \u041D\u0414\u0421 \xD7 1,2 =
        \u0426\u0435\u043D\u0430 \u0441 \u041D\u0414\u0421"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[9].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
        \u0446\u0435\u043D \u0441 \"9\" \u0432 \u043A\u043E\u043D\u0446\u0435 \u0441\u043E\u0437\u0434\u0430\u0451\u0442
        \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u0438\u0435 \u0431\u043E\u043B\u0435\u0435
        \u0432\u044B\u0433\u043E\u0434\u043D\u043E\u0433\u043E \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F,
        \u0447\u0442\u043E \u043F\u0441\u0438\u0445\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438
        \u0441\u0442\u0438\u043C\u0443\u043B\u0438\u0440\u0443\u0435\u0442 \u043F\u043E\u043A\u0443\u043F\u043A\u0443"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[0].question
      value: "\u041A\u0430\u043A\u0443\u044E \u043E\u0441\u043D\u043E\u0432\u043D\u0443\u044E
