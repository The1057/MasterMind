    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[5].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n \u0413\u043B\u0430\u0432\u043D\u044B\u0439 \u043A\u0440\u0438\u0442\u0435\u0440\u0438\u0439
        \u2013 \u043F\u0440\u043E\u0435\u043A\u0442 \u0434\u043E\u043B\u0436\u0435\u043D
        \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u044C \u043F\u043E\u043B\u044C\u0437\u0443
        \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0443, \u0430 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
        \u0434\u043E\u0445\u043E\u0434. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[6].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        A \\n\u041F\u043E\u0441\u043B\u0435 \u043F\u043E\u0434\u0430\u0447\u0438
        \u0437\u0430\u044F\u0432\u043A\u0430 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
        \u044D\u043A\u0441\u043F\u0435\u0440\u0442\u0438\u0437\u0443 \u2013 \u0435\u0451
        \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u044E\u0442 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0441\u0442\u044B. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[7].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n\u0415\u0441\u043B\u0438 \u0434\u0435\u043D\u044C\u0433\u0438 \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u044B
        \u043D\u0435 \u043F\u043E \u0446\u0435\u043B\u044F\u043C \u043F\u0440\u043E\u0435\u043A\u0442\u0430,
        \u0444\u043E\u043D\u0434 \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C
        \u0432\u043E\u0437\u0432\u0440\u0430\u0442 \u0441\u0440\u0435\u0434\u0441\u0442\u0432. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[8].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        A \\n \u041F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E\u0442\u0441\u044F
        \u043F\u0440\u043E\u0435\u043A\u0442\u044B, \u043F\u0440\u0438\u043D\u043E\u0441\u044F\u0449\u0438\u0435
        \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E
        \u043F\u043E\u043B\u044C\u0437\u0443, \u0430 \u043D\u0435 \u0447\u0438\u0441\u0442\u043E
        \u043A\u043E\u043C\u043C\u0435\u0440\u0447\u0435\u0441\u043A\u0438\u0435. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[9].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n \u041A\u043E\u043D\u043A\u0443\u0440\u0441 \u0433\u0440\u0430\u043D\u0442\u043E\u0432
        \u2013 \u044D\u0442\u043E \u043F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u0430
        \u0432\u044B\u0431\u043E\u0440\u0430 \u043F\u0440\u043E\u0435\u043A\u0442\u043E\u0432,
        \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u0432\u044B\u0434\u0435\u043B\u044F\u0435\u0442\u0441\u044F
        \u0444\u0438\u043D\u0430\u043D\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435."
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[0].question
      value: "\u0427\u0442\u043E \u0442\u0430\u043A\u043E\u0435 \u0433\u0440\u0430\u043D\u0442?"
