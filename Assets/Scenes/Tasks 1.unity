  m_text: "   \u0411\u043B\u0430\u0433\u043E\u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
    \u2013 \u044D\u0442\u043E \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u043D\u0430\u044F
    \u0431\u0435\u0437\u0432\u043E\u0437\u043C\u0435\u0437\u0434\u043D\u0430\u044F
    \u043F\u043E\u043C\u043E\u0449\u044C \u0432 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0430\u0445
    \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0445 \u043B\u044E\u0434\u0435\u0439,
    \u0433\u0440\u0443\u043F\u043F \u0438\u043B\u0438 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430
    \u0432 \u0446\u0435\u043B\u043E\u043C. \u041E\u043D\u0430 \u043C\u043E\u0436\u0435\u0442
    \u0432\u044B\u0440\u0430\u0436\u0430\u0442\u044C\u0441\u044F \u0432 \u0434\u0435\u043D\u0435\u0436\u043D\u043E\u0439
    \u0438\u043B\u0438 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044C\u043D\u043E\u0439
    \u0444\u043E\u0440\u043C\u0435, \u0432 \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0438
    \u0443\u0441\u043B\u0443\u0433 \u0438\u043B\u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0438
    \u0440\u0430\u0431\u043E\u0442.\n\r\n   \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
    \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0445
    \u0432\u0438\u0434\u043E\u0432 \u0431\u043B\u0430\u0433\u043E\u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438:"
