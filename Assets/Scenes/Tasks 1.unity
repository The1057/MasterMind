  m_text: "   \n\r\n> \u0420\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u044B\u0435
    \u043F\u043E\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u044F \u0431\u0435\u0437
