  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\n\r\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0432\u0438\u0434\u044B
    \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438 \u0442\u0440\u0435\u0431\u0443\u044E\u0442
    \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0439:\r\n\n>
    \u0421\u0430\u043D\u0438\u0442\u0430\u0440\u043D\u043E\u0435 \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435
    (\u0420\u043E\u0441\u043F\u043E\u0442\u0440\u0435\u0431\u043D\u0430\u0434\u0437\u043E\u0440)
    \u2013 \u043A\u0430\u0444\u0435, \u0441\u0430\u043B\u043E\u043D\u044B, \u0448\u043A\u043E\u043B\u044B.\r\n\r\n>
    \u041F\u043E\u0436\u0430\u0440\u043D\u043E\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435
    (\u041C\u0427\u0421) \u2013 \u0441\u043A\u043B\u0430\u0434\u044B, \u0440\u0435\u0441\u0442\u043E\u0440\u0430\u043D\u044B.\r\n\r\n>
    \u0420\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u043D\u0430 \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u044E
    \u2013 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u044B, \u0440\u044B\u043D\u043A\u0438.\n\n>
    \u0421\u0435\u0440\u0442\u0438\u0444\u0438\u043A\u0430\u0442\u044B \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044F
    \u2013 \u0434\u0435\u0442\u0441\u043A\u0438\u0435 \u0442\u043E\u0432\u0430\u0440\u044B,
    \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u0438\u043A\u0430, \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u044B.\r\n\r\n\r"
