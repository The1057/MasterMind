  m_text: "   \u041F\u043E \u0434\u0430\u043D\u043D\u044B\u043C \u041C\u0438\u043D\u043F\u0440\u043E\u043C\u0442\u043E\u0440\u0433\u0430
    \u0438 \u043D\u0430\u0446\u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B
    \xAB\u0426\u0438\u0444\u0440\u043E\u0432\u0430\u044F \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0430
    \u0420\u0424\xBB, \u043A 2025 \u0433\u043E\u0434\u0443 \u0432 \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442\u0435
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u044F
    \u043E\u0431\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E\u0449\u0438\u0445
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432, \u0441\u0435\u043B\u044C\u0441\u043A\u043E\u0433\u043E
    \u0445\u043E\u0437\u044F\u0439\u0441\u0442\u0432\u0430 \u0438 \u043B\u043E\u0433\u0438\u0441\u0442\u0438\u043A\u0438.
    \u0422\u0430\u043A\u0436\u0435 \u0430\u043A\u0442\u0438\u0432\u043D\u043E \u0432\u043D\u0435\u0434\u0440\u044F\u0435\u0442\u0441\u044F
    \u043F\u0440\u043E\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u044B\u0439 \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442
    \u0432\u0435\u0449\u0435\u0439 (IIoT) \u0438 \u0446\u0438\u0444\u0440\u043E\u0432\u044B\u0435
    \u0434\u0432\u043E\u0439\u043D\u0438\u043A\u0438 \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u0439.\r\n\r\n\r\n"
