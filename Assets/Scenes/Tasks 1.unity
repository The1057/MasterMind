  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n> \u041F\u043E\u0438\u0441\u043A \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0435\u0439
    \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B.\r\r\r\n> \u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430
    \u043F\u0440\u043E\u0435\u043A\u0442\u0430 (\u0446\u0435\u043B\u0438, \u0437\u0430\u0434\u0430\u0447\u0438,
    \u0431\u044E\u0434\u0436\u0435\u0442).\r\n\r\r> \u041F\u043E\u0434\u0430\u0447\u0430
    \u0437\u0430\u044F\u0432\u043A\u0438.\r\r\n> \u042D\u043A\u0441\u043F\u0435\u0440\u0442\u043D\u0430\u044F
    \u043E\u0446\u0435\u043D\u043A\u0430 \u0438 \u0432\u044B\u0431\u043E\u0440 \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u0435\u0439.\n>
    \u041E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u0435 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u043E\u0432.\n>
    \u0420\u0435\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044F \u043F\u0440\u043E\u0435\u043A\u0442\u0430
    \u0438 \u043E\u0442\u0447\u0451\u0442\u043D\u043E\u0441\u0442\u044C."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6d9ad1c49cfdf504faddd7afd3ceae86, type: 2}
