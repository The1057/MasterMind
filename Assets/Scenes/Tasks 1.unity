  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\r\n\r1. \u0410\u0443\u0434\u0438\u0442 \u0438 \u043E\u0442\u0447\u0451\u0442\u043D\u043E\u0441\u0442\u044C
    \u2014 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430 \u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u044B\u0445
    \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u044B\u0445 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u043E\u0432.\r\n2.
    \u041F\u0440\u043E\u0441\u043F\u0435\u043A\u0442 \u044D\u043C\u0438\u0441\u0441\u0438\u0438
    \u2014 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442 \u0441 \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435\u043C
    \u0431\u0438\u0437\u043D\u0435\u0441\u0430, \u0440\u0438\u0441\u043A\u043E\u0432
    \u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u0439 \u0432\u044B\u043F\u0443\u0441\u043A\u0430
    \u0430\u043A\u0446\u0438\u0439.\r\n3. \u0423\u0447\u0430\u0441\u0442\u0438\u0435
    \u0430\u043D\u0434\u0435\u0440\u0440\u0430\u0439\u0442\u0435\u0440\u043E\u0432
    \u2014 \u0438\u043D\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u043E\u043D\u043D\u044B\u0435
    \u0431\u0430\u043D\u043A\u0438 (\u0430\u043D\u0434\u0435\u0440\u0440\u0430\u0439\u0442\u0435\u0440\u044B)
    \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0443\u044E\u0442 \u043F\u0440\u043E\u0446\u0435\u0441\u0441,
    \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442 \u0441 \u0446\u0435\u043D\u043E\u0439
    \u0438 \u043F\u0440\u0438\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0435\u043C
    \u0438\u043D\u0432\u0435\u0441\u0442\u043E\u0440\u043E\u0432.\r\n4. \u0420\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044F
    \u0438 \u043B\u0438\u0441\u0442\u0438\u043D\u0433 \u2014 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0435
    \u0434\u043E\u043F\u0443\u0441\u043A\u0430 \u043A \u0442\u043E\u0440\u0433\u0430\u043C
    \u043D\u0430 \u0431\u0438\u0440\u0436\u0435.\r\n5. \u0420\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u0435
    \u0430\u043A\u0446\u0438\u0439 \u2014 \u043D\u0430\u0447\u0430\u043B\u043E \u0442\u043E\u0440\u0433\u043E\u0432
    \u0430\u043A\u0446\u0438\u044F\u043C\u0438 \u043D\u0430 \u0440\u044B\u043D\u043A\u0435.\r\n\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6d9ad1c49cfdf504faddd7afd3ceae86, type: 2}
