      m_Calls: []
  m_text: "   \n\n1. \u041F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u0441\u0442\u0440\u0430\u0445\u043E\u0432\u0430\u043D\u0438\u0435 (\u0432\u044B\u043F\u043B\u0430\u0442\u044B
    \u043F\u0440\u0438 \u043D\u0430\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u0438
    \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u044B\u0445 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u043E\u0432,
    \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u0441\u0438\u043B\u044B \u0432\u0435\u0442\u0440\u0430)\r\r\r\r\n2. 
    \u0411\u043B\u043E\u043A\u0447\u0435\u0439\u043D-\u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u044B
    \u0434\u043B\u044F \u0443\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u044F \u0432\u044B\u043F\u043B\u0430\u0442\n\r3.\u0418\u0418-\u0430\u043D\u0430\u043B\u0438\u0437
    \u0440\u0438\u0441\u043A\u043E\u0432 \u0441 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435\u043C
    \u0434\u0430\u043D\u043D\u044B\u0445 IoT-\u0434\u0430\u0442\u0447\u0438\u043A\u043E\u0432\n"
