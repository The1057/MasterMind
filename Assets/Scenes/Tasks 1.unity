      m_Calls: []
  m_text: "   \n\r\n \u0420\u0438\u0441\u043A \u2013 \u044D\u0442\u043E \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u044C
    \u043F\u043E\u0442\u0435\u0440\u0438 \u043A\u0430\u043F\u0438\u0442\u0430\u043B\u0430.\r\n
    \u0412\u043E\u043B\u0430\u0442\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C
    \u2013 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C, \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0441\u0438\u043B\u044C\u043D\u043E \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
    \u0434\u043E\u0445\u043E\u0434\u043D\u043E\u0441\u0442\u044C \u0430\u043A\u0442\u0438\u0432\u0430\r\n>
    \u0410\u043A\u0442\u0438\u0432 \u0410: +1% \u0432 1-\u0439 \u0433\u043E\u0434,
    \u22122% \u0432\u043E 2-\u0439 \u2192 \u043D\u0438\u0437\u043A\u0430\u044F \u0432\u043E\u043B\u0430\u0442\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C\r\n>
    \u0410\u043A\u0442\u0438\u0432 B: +20% \u0432 1-\u0439 \u0433\u043E\u0434, \u221215%
    \u0432\u043E 2-\u0439 \u2192 \u0432\u044B\u0441\u043E\u043A\u0430\u044F \u0432\u043E\u043B\u0430\u0442\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C
    \u2192 \u0432\u044B\u0448\u0435 \u0440\u0438\u0441\u043A\r\n\r\n\n"
