    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n> \u0418\u043D\u0444\u043B\u044F\u0446\u0438\u044F \u0438 \u0434\u0435\u0432\u0430\u043B\u044C\u0432\u0430\u0446\u0438\u044F.\r\n
    \u0420\u043E\u0441\u0442 \u0446\u0435\u043D \u0441\u043D\u0438\u0436\u0430\u0435\u0442
    \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044C\u043D\u0443\u044E
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u044F,
    \u0430 \u043E\u0431\u0435\u0441\u0446\u0435\u043D\u0435\u043D\u0438\u0435 \u0432\u0430\u043B\u044E\u0442\u044B
    \u0434\u0435\u043B\u0430\u0435\u0442 \u0438\u043C\u043F\u043E\u0440\u0442 \u0434\u043E\u0440\u043E\u0433\u0438\u043C,
    \u0447\u0442\u043E \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u0435\u0442 \u0441\u043F\u0430\u0434.\r\r\r\n>
    \u0412\u043D\u0435\u0448\u043D\u0438\u0435 \u0448\u043E\u043A\u0438.\r\n \u0421\u0430\u043D\u043A\u0446\u0438\u0438,
    \u043F\u0430\u0434\u0435\u043D\u0438\u0435 \u0446\u0435\u043D \u043D\u0430 \u044D\u043D\u0435\u0440\u0433\u043E\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u0438,
    \u043F\u0440\u0438\u0440\u043E\u0434\u043D\u044B\u0435 \u043A\u0430\u0442\u0430\u0441\u0442\u0440\u043E\u0444\u044B
    \u0438\u043B\u0438 \u0433\u043B\u043E\u0431\u0430\u043B\u044C\u043D\u044B\u0435
    \u043A\u0440\u0438\u0437\u0438\u0441\u044B (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u043F\u0430\u043D\u0434\u0435\u043C\u0438\u0438) \u043C\u043E\u0433\u0443\u0442
    \u0440\u0435\u0437\u043A\u043E \u0434\u0435\u0441\u0442\u0430\u0431\u0438\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0443.\r\n\r\r\n\n"
  m_isRightToLeft: 0
