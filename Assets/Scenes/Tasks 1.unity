    \u0441\u0438\u0441\u0442\u0435\u043C\u0443 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C
    (MES), \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043E\u0442\u0441\u043B\u0435\u0436\u0438\u0432\u0430\u0435\u0442
    \u043A\u0430\u0436\u0434\u044B\u0439 \u044D\u0442\u0430\u043F \u0432 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u043C
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438.\r\r\r\n> \u041A\u0430\u043C\u0435\u0440\u044B
    \u0441 \u0418\u0418 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u044E\u0442
    \u0431\u0440\u0430\u043A.\r\n\r\r> \u0421\u043A\u043B\u0430\u0434 \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438
    \n\u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043A\u043E\u043D\u0432\u0435\u0439\u0435\u0440\u043E\u0432
    \u0438 \u0440\u043E\u0431\u043E\u0442\u043E\u0432.\r\r\n"
