  m_text: "   \u0414\u0435\u0432\u0430\u043B\u044C\u0432\u0430\u0446\u0438\u044F
    \u2013 \u044D\u0442\u043E \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0435
    \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u0435 \u043A\u0443\u0440\u0441\u0430
    \u043D\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0439 \u0432\u0430\u043B\u044E\u0442\u044B
    \u043F\u043E \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044E \u043A \u0438\u043D\u043E\u0441\u0442\u0440\u0430\u043D\u043D\u044B\u043C
    \u0432\u0430\u043B\u044E\u0442\u0430\u043C. \u0418\u043D\u044B\u043C\u0438 \u0441\u043B\u043E\u0432\u0430\u043C\u0438,
    \u0437\u0430 1 \u0434\u043E\u043B\u043B\u0430\u0440 \u0438\u043B\u0438 \u0435\u0432\u0440\u043E
    \u043F\u043E\u0441\u043B\u0435 \u0434\u0435\u0432\u0430\u043B\u044C\u0432\u0430\u0446\u0438\u0438
    \u043D\u0443\u0436\u043D\u043E \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C
    \u0431\u043E\u043B\u044C\u0448\u0435 \u0440\u0443\u0431\u043B\u0435\u0439.\n\n"
