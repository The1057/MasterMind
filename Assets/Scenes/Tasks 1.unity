  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n1. \u0420\u0435\u0441\u0443\u0440\u0441\u043D\u044B\u0435 (\u043D\u0435\u0445\u0432\u0430\u0442\u043A\u0430
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u0430, \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F).
    \r\r\r\r\n2. \u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0435
    (\u043D\u0435\u044F\u0441\u043D\u044B\u0435 \u043E\u0431\u044F\u0437\u0430\u043D\u043D\u043E\u0441\u0442\u0438,
    \u043D\u0435\u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E\u0435
    \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u0435
    \u0437\u0430\u0434\u0430\u0447).  \n3. \u041B\u0438\u0447\u043D\u043E\u0441\u0442\u043D\u044B\u0435
    (\u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442\u044B \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043E\u0432).\r\n\r4.
    \u0410\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0435
    (\u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u043E \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C). 
    \n\r\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6d9ad1c49cfdf504faddd7afd3ceae86, type: 2}
  m_sharedMaterial: {fileID: 7286569816844298882, guid: 6d9ad1c49cfdf504faddd7afd3ceae86, type: 2}
