  m_text: "\u041E\u0442 \u0432\u0430\u0448\u0435\u0433\u043E \u0432\u044B\u0431\u043E\u0440\u0430
    \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u0431\u0443\u0434\u0443\u0449\u0430\u044F
    \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u044F \u0438 \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0446\u0438\u044F.
    \u0412\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u0438\u0437\u0443\u0447\u0438\u0442\u0435
