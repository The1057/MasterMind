  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n\r\n> \u041F\u0440\u043E\u0445\u043E\u0434\u044F\u0442 \u043B\u0438\u0441\u0442\u0438\u043D\u0433
    \u0438 \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442 \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
    \u043D\u0430 \u0431\u0438\u0440\u0436\u0435.\r\n> \u0424\u043E\u0440\u043C\u0438\u0440\u0443\u0435\u0442\u0441\u044F
    \u0440\u044B\u043D\u043E\u0447\u043D\u0430\u044F \u0446\u0435\u043D\u0430 (price
    discovery).\r\n> \u0423\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u0434\u043E\u043B\u044F \u0430\u043A\u0446\u0438\u0439 \u0432 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u043C
    \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u0438 (free-float).\r\n> \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u044B
    \u043F\u0435\u0440\u0438\u043E\u0434\u044B lock-up, \u043A\u043E\u0433\u0434\u0430
    \u043E\u0441\u043D\u043E\u0432\u0430\u0442\u0435\u043B\u0438 \u043D\u0435 \u043C\u043E\u0433\u0443\u0442
    \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u0442\u044C \u0430\u043A\u0446\u0438\u0438.\r\n>
    \u0412 \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u043C \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B
    \u0432\u0442\u043E\u0440\u0438\u0447\u043D\u044B\u0435 \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u044F
    (SPO).\r\n\n"
