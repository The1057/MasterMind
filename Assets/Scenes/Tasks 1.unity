  m_text: "   \n\n> \u0414\u0438\u0432\u0438\u0434\u0435\u043D\u0434\u044B \u2013
    \u0432\u044B\u043F\u043B\u0430\u0442\u044B \u0430\u043A\u0446\u0438\u043E\u043D\u0435\u0440\u0430\u043C
    \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0439.\r\r\r\n> \u041F\u0440\u043E\u0446\u0435\u043D\u0442\u044B
    \u043F\u043E \u0432\u043A\u043B\u0430\u0434\u0430\u043C \u0438 \u043E\u0431\u043B\u0438\u0433\u0430\u0446\u0438\u044F\u043C
    \u2013 \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u0434\u043E\u0445\u043E\u0434 \u043E\u0442 \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u044B\u0445
    \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u0432.\r\n\r>
    \u0410\u0440\u0435\u043D\u0434\u0430 \u043D\u0435\u0434\u0432\u0438\u0436\u0438\u043C\u043E\u0441\u0442\u0438
    \u2013 \u0440\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u044B\u0439 \u0434\u043E\u0445\u043E\u0434
    \u043E\u0442 \u0441\u0434\u0430\u0447\u0438 \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432
    \u0432 \u0430\u0440\u0435\u043D\u0434\u0443\n\r> \u0418\u043D\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u0438
    \u0447\u0435\u0440\u0435\u0437 \u0444\u043E\u043D\u0434\u044B (ETF, REIT) \u2013
    \u043A\u043E\u043B\u043B\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0435 \u0432\u043B\u043E\u0436\u0435\u043D\u0438\u044F
    \u0432 \u0430\u043A\u0446\u0438\u0438, \u043D\u0435\u0434\u0432\u0438\u0436\u0438\u043C\u043E\u0441\u0442\u044C
    \u0438\u043B\u0438 \u043E\u0442\u0440\u0430\u0441\u043B\u0438 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0438.\n\n"
