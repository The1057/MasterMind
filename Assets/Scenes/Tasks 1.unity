    \u0421\u0428\u0410\r\n\r\r> \u041A\u043B\u044E\u0447\u0435\u0432\u044B\u0435
    \u0444\u0430\u043A\u0442\u043E\u0440\u044B: ROI, \u043D\u0430\u0434\u0435\u0436\u043D\u043E\u0441\u0442\u044C\r\r\n\n\u042D\u0442\u0430\u043F\u044B
    \u0441\u0434\u0435\u043B\u043A\u0438 (\u043D\u0430 \u043F\u0440\u0438\u043C\u0435\u0440\u0435
    SAP):\n\r\n1. \u041B\u0438\u0434\u043E\u0433\u0435\u043D\u0435\u0440\u0430\u0446\u0438\u044F
    \u2192 2. \u0412\u0445\u043E\u0434\u044F\u0449\u0438\u0435 \u0437\u0430\u044F\u0432\u043A\u0438
    \u2192 3. \u0414\u0435\u043C\u043E-\u0432\u0435\u0440\u0441\u0438\u044F \u2192
    4. \u041F\u0438\u043B\u043E\u0442 \u2192 5. \u0412\u043D\u0435\u0434\u0440\u0435\u043D\u0438\u0435
    \u2192 6. \u041C\u0430\u0441\u0448\u0442\u0430\u0431\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435\r\n\n"
