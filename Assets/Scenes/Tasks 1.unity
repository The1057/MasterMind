  m_text: "   \n\n3. \u041E\u043F\u0442\u0438\u043C\u0438\u0437\u0430\u0446\u0438\u044F
    \u0437\u0430\u0442\u0440\u0430\u0442.\r\n>  \u0421\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u0438\u0435
    \u0440\u0430\u0441\u0445\u043E\u0434\u043E\u0432 \u043D\u0430 \u043C\u0430\u0440\u043A\u0435\u0442\u0438\u043D\u0433,
    \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435, \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u043E\u0432\u043A\u0438,
    \u044D\u043D\u0435\u0440\u0433\u043E\u043F\u043E\u0442\u0440\u0435\u0431\u043B\u0435\u043D\u0438\u0435.
    \u0412\u0430\u0436\u043D\u043E \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0442\u044C
    \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u0432\u0430\u0436\u043D\u044B\u0435
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u044B \u0434\u043B\u044F \u0444\u0443\u043D\u043A\u0446\u0438\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
    \u0431\u0438\u0437\u043D\u0435\u0441\u0430.\r\n4. \u041F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B
    \u0441 \u043A\u0440\u0435\u0434\u0438\u0442\u043E\u0440\u0430\u043C\u0438 \u0438
    \u043F\u043E\u0441\u0442\u0430\u0432\u0449\u0438\u043A\u0430\u043C\u0438.\r\n> 
    \u041E\u0442\u0441\u0440\u043E\u0447\u043A\u0430 \u043F\u043B\u0430\u0442\u0435\u0436\u0435\u0439,
    \u0440\u0435\u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0438\u0437\u0430\u0446\u0438\u044F
