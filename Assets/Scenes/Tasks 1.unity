  m_text: "   \n\n  VaR \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442,
    \u043A\u0430\u043A\u043E\u0439 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0439
    \u0443\u0431\u044B\u0442\u043E\u043A \u0432\u043E\u0437\u043C\u043E\u0436\u0435\u043D
    \u0441 \u0437\u0430\u0434\u0430\u043D\u043D\u043E\u0439 \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u044C\u044E.
    \u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u043F\u0440\u0438 \u0434\u043E\u0432\u0435\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C
    \u0443\u0440\u043E\u0432\u043D\u0435 99% \u0438 VaR = 10 000 \u0440\u0443\u0431,
    \u0443\u0431\u044B\u0442\u043E\u043A \u0441 \u0431\u043E\u043B\u044C\u0448\u0435\u0439
    \u0441\u0443\u043C\u043C\u043E\u0439 \u0432\u043E\u0437\u043C\u043E\u0436\u0435\u043D
    \u043B\u0438\u0448\u044C \u0432 1% \u0441\u043B\u0443\u0447\u0430\u0435\u0432.\r\n\r\n\r\n\r\n\n"
