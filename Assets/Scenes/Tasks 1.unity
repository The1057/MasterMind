--- !u!114 &707947617
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 707947615}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\n\n> \u041E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u0435 \u0446\u0435\u043B\u044C
    \u2013 \u0437\u0430\u0447\u0435\u043C \u0432\u0430\u043C \u043D\u0443\u0436\u043D\u044B
    \u0437\u0430\u0451\u043C\u043D\u044B\u0435 \u0434\u0435\u043D\u044C\u0433\u0438
    (\u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u0438\u0435, \u043E\u0431\u043E\u0440\u043E\u0442,
    \u0442\u0435\u0445\u043D\u0438\u043A\u0430).\r\n> \u041E\u0446\u0435\u043D\u0438\u0442\u0435
    \u043E\u043A\u0443\u043F\u0430\u0435\u043C\u043E\u0441\u0442\u044C \u2013 \u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
    \u043D\u0430 \u0437\u0430\u0451\u043C\u043D\u044B\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430.\n\r\r>
    \u0421\u0440\u0430\u0432\u043D\u0438\u0442\u0435 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F
    \u2013 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u043D\u0430
    \u0441\u0442\u0430\u0432\u043A\u0443, \u0441\u0440\u043E\u043A, \u043A\u043E\u043C\u0438\u0441\u0441\u0438\u0438,
    \u0441\u0442\u0440\u0430\u0445\u043E\u0432\u043A\u0443.\r\n> \u0420\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u0439\u0442\u0435
    \u043F\u043B\u0430\u0442\u0451\u0436 \u2013 \u043E\u043D \u0434\u043E\u043B\u0436\u0435\u043D
    \u0431\u044B\u0442\u044C \u043D\u0435 \u0432\u044B\u0448\u0435 30\u201340% \u0434\u043E\u0445\u043E\u0434\u0430.\n>
    \u041E\u0446\u0435\u043D\u0438\u0442\u0435 \u0440\u0438\u0441\u043A\u0438 \u2013
    \u0433\u043E\u0442\u043E\u0432\u044B \u043B\u0438 \u0432\u044B \u043A \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u044E
    \u0434\u043E\u0445\u043E\u0434\u0430, \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044E
    \u0441\u0442\u0430\u0432\u043A\u0438, \u043A\u043E\u043B\u0435\u0431\u0430\u043D\u0438\u044F\u043C
    \u0440\u044B\u043D\u043A\u0430.\r\n> \u041F\u0440\u0435\u0434\u043F\u043E\u0447\u0438\u0442\u0430\u0439\u0442\u0435
    \u043A\u0440\u0435\u0434\u0438\u0442\u044B \u0441 \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439
    \u0441\u0442\u0430\u0432\u043A\u043E\u0439, \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
    \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u043D\u0435\u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0439
    \u0438\u043D\u0444\u043B\u044F\u0446\u0438\u0438.\r\n> \u0418\u0437\u0431\u0435\u0433\u0430\u0439\u0442\u0435
    \u043C\u0438\u043A\u0440\u043E\u0437\u0430\u0439\u043C\u043E\u0432 \u2013 \u043E\u043D\u0438
    \u043E\u0447\u0435\u043D\u044C \u0434\u043E\u0440\u043E\u0433\u0438 \u0438 \u0447\u0430\u0441\u0442\u043E
    \u043F\u0440\u0438\u0432\u043E\u0434\u044F\u0442 \u043A \xAB\u0434\u043E\u043B\u0433\u043E\u0432\u043E\u0439
    \u044F\u043C\u0435\xBB.\n\r> \u0421\u043E\u0445\u0440\u0430\u043D\u044F\u0439\u0442\u0435
    \"\u043F\u043E\u0434\u0443\u0448\u043A\u0443 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438\"
    \u2013 \u043C\u0438\u043D\u0438\u043C\u0443\u043C \u043D\u0430 2\u20133 \u043C\u0435\u0441\u044F\u0446\u0430
    \u043F\u043B\u0430\u0442\u0435\u0436\u0435\u0439.\r\n\n\n\r\n\r"
