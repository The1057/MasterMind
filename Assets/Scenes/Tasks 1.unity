    \u0410\u043B\u043A\u043E\u0433\u043E\u043B\u044C\u043D\u0430\u044F \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u044F
    \u2013 \u0434\u043E 5 \u043B\u0435\u0442.\r\n\r\n> \u041B\u0438\u0446\u0435\u043D\u0437\u0438\u044F
    \u043D\u0430 \u0447\u0430\u0441\u0442\u043D\u0443\u044E \u043E\u0445\u0440\u0430\u043D\u043D\u0443\u044E
