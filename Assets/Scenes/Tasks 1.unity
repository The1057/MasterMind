    \u0434\u043B\u044F \u0443\u0434\u043E\u0432\u043B\u0435\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u044F
    \u043F\u043E\u0442\u0440\u0435\u0431\u043D\u043E\u0441\u0442\u0435\u0439. \n
    \u041E\u043D\u0430 \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u0435\u0442
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u043E, \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u0435
    \u0438 \u043F\u043E\u0442\u0440\u0435\u0431\u043B\u0435\u043D\u0438\u0435 \n\u0442\u043E\u0432\u0430\u0440\u043E\u0432
    \u0438 \u0443\u0441\u043B\u0443\u0433, \u0432\u043B\u0438\u044F\u044F \n\u043D\u0430
    \u043F\u043E\u0432\u0441\u0435\u0434\u043D\u0435\u0432\u043D\u0443\u044E \u0436\u0438\u0437\u043D\u044C.\r\n"
