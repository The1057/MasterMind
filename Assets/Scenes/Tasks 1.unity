      m_Calls: []
  m_text: "   \n\n>  \u0412\u044B\u0436\u0438\u0432\u0430\u043D\u0438\u0435 \u0431\u0438\u0437\u043D\u0435\u0441\u0430
    \u2013 \u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442
    \u0443\u0441\u043F\u0435\u0448\u043D\u044B\u0445 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439.\r\n> 
    \u041F\u0430\u0434\u0435\u043D\u0438\u0435 \u043C\u043E\u0440\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0434\u0443\u0445\u0430 \u2013 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0438
    \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B
    \u0441\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u0438\u044F\u043C\u0438 \u0438\u043B\u0438
    \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0435\u043C \u0443\u0441\u043B\u043E\u0432\u0438\u0439
    \u0440\u0430\u0431\u043E\u0442\u044B.\r\r\n>  \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0435
    \u0432\u043B\u0438\u044F\u043D\u0438\u0435 \u043D\u0430 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044E
    \u2013 \u0432\u043D\u0435\u0448\u043D\u0438\u0435 \u043F\u0430\u0440\u0442\u043D\u0435\u0440\u044B
    \u0438 \u043A\u043B\u0438\u0435\u043D\u0442\u044B \u043C\u043E\u0433\u0443\u0442
    \u043D\u0435\u0433\u0430\u0442\u0438\u0432\u043D\u043E \u043E\u0446\u0435\u043D\u0438\u0442\u044C
    \u0443\u0432\u043E\u043B\u044C\u043D\u0435\u043D\u0438\u044F, \u043D\u043E \u043F\u043E\u043D\u0438\u043C\u0430\u044E\u0442
    \u043C\u0435\u0440\u044B \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445
    \u043A\u0440\u0438\u0437\u0438\u0441\u0430.\r\n\n"
