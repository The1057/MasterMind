  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \u0420\u043E\u0431\u043E\u0442\u0438\u0437\u0430\u0446\u0438\u044F
    \u2013 \u044D\u0442\u043E \u0432\u043D\u0435\u0434\u0440\u0435\u043D\u0438\u0435
    \u043F\u0440\u043E\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u044B\u0445 \u0440\u043E\u0431\u043E\u0442\u043E\u0432
    \n\u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0441\u0438\u0441\u0442\u0435\u043C \n\u043D\u0430 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435.\n\r\n  
    \u0426\u0438\u0444\u0440\u043E\u0432\u0438\u0437\u0430\u0446\u0438\u044F \u2013
    \u044D\u0442\u043E \u043F\u0435\u0440\u0435\u0432\u043E\u0434 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0432
    \u0432 \u0446\u0438\u0444\u0440\u043E\u0432\u043E\u0439 \u0444\u043E\u0440\u043C\u0430\u0442:
    \u0443\u0447\u0451\u0442, \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435,
    \u043B\u043E\u0433\u0438\u0441\u0442\u0438\u043A\u0430, \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C
    \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430 \u0438 \u043F\u0440. \u0441
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435\u043C
    \n\u0418\u0422-\u0441\u0438\u0441\u0442\u0435\u043C, \u0434\u0430\u0442\u0447\u0438\u043A\u043E\u0432,
    \u043E\u0431\u043B\u0430\u0447\u043D\u044B\u0445 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C
    \u0438 \u0418\u0418.\r\n\r\n"
