  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \u041F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441 \u2013  \u044D\u0442\u043E \u0441\u043E\u0432\u043E\u043A\u0443\u043F\u043D\u043E\u0441\u0442\u044C
    \u0432\u0441\u0435\u0445 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439,\n\u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B\u0445
    \u0434\u043B\u044F \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F
    \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432 (\u0441\u044B\u0440\u044C\u044F,
    \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432, \u0442\u0440\u0443\u0434\u0430
    \n\u0438 \u044D\u043D\u0435\u0440\u0433\u0438\u0438) \u0432 \u0433\u043E\u0442\u043E\u0432\u0443\u044E
    \u043F\u0440\u043E\u0434\u0443\u043A\u0446\u0438\u044E \n\u0438\u043B\u0438 \u0443\u0441\u043B\u0443\u0433\u0438.
    \u041E\u043D \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0441\u0435\u0440\u0434\u0446\u0435\u043C
    \u043B\u044E\u0431\u043E\u0433\u043E \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u044F
    \u0438 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \n\u0447\u0451\u0442\u043A\u043E\u0433\u043E
    \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F, \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0446\u0438\u0438
    \n\u0438 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F.\r\n"
