    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[5].question
      value: " \u0412 \u0440\u0430\u043C\u043A\u0430\u0445 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0438
        \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u044B\u0445 \u0441\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432
        \u0431\u0438\u0437\u043D\u0435\u0441 \u043C\u043E\u0436\u0435\u0442 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0430\u0442\u044C
