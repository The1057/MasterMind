  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \n\n1. \u0410\u0432\u0442\u043E\u043D\u043E\u043C\u043D\u044B\u0435
    \u2013 \u0443\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F
    \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u043E\u043C \u0432
    \u043E\u0434\u043D\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0435\u043C
    \u043F\u043E\u0440\u044F\u0434\u043A\u0435.  \r\r\r\n2. \u041A\u043E\u043D\u0432\u0435\u043D\u0446\u0438\u043E\u043D\u043D\u044B\u0435
    (\u0434\u043E\u0433\u043E\u0432\u043E\u0440\u043D\u044B\u0435) \u2013 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u044E\u0442\u0441\u044F
    \u043C\u0435\u0436\u0434\u0443\u043D\u0430\u0440\u043E\u0434\u043D\u044B\u043C\u0438
    \u0441\u043E\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u044F\u043C\u0438 (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u0432 \u0440\u0430\u043C\u043A\u0430\u0445 \u0415\u0410\u042D\u0421 \u0438\u043B\u0438
    \u0412\u0422\u041E). \r\n\r\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6d9ad1c49cfdf504faddd7afd3ceae86, type: 2}
  m_sharedMaterial: {fileID: 7286569816844298882, guid: 6d9ad1c49cfdf504faddd7afd3ceae86, type: 2}
