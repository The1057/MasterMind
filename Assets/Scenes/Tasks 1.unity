  m_text: "   \n\r\n> \u042D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0440\u043E\u0441\u0442 \u2192 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u0441\u043F\u0440\u043E\u0441 \u043D\u0430 \u0430\u0440\u0435\u043D\u0434\u0443,
    \u0440\u0435\u043D\u0442\u0430 \u0440\u0430\u0441\u0442\u0451\u0442\r\r\n> \u042D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043A\u0440\u0438\u0437\u0438\u0441 \u2192 \u0430\u0440\u0435\u043D\u0434\u0430\u0442\u043E\u0440\u044B
    \u0441\u044A\u0435\u0437\u0436\u0430\u044E\u0442, \u0447\u0430\u0441\u0442\u044C
    \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0439 \u043F\u0443\u0441\u0442\u0443\u0435\u0442,
    \u0434\u043E\u0445\u043E\u0434 \u0441\u043D\u0438\u0436\u0430\u0435\u0442\u0441\u044F.\r\n\r\n\r\n\n"
