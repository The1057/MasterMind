  m_text: "   \u0414\u043E\u0445\u043E\u0434\u043D\u043E\u0441\u0442\u044C \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442,
    \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u0435\u043D\u0435\u0433 \u0432\u044B
    \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0438 (\u0438\u043B\u0438
    \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438) \u043F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E
