    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[0].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B\\n \u0422\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u0430\u044F \u043F\u043E\u0448\u043B\u0438\u043D\u0430
        - \u044D\u0442\u043E \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439
        \u043F\u043B\u0430\u0442\u0435\u0436, \u0432\u0437\u0438\u043C\u0430\u0435\u043C\u044B\u0439
        \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u043E\u043C
        \u043F\u0440\u0438 \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0438
        \u0442\u043E\u0432\u0430\u0440\u043E\u0432 \u0447\u0435\u0440\u0435\u0437
        \u0442\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u0443\u044E \u0433\u0440\u0430\u043D\u0438\u0446\u0443.
        \u041E\u043D\u0430 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u043C
        \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
        \u0432\u043D\u0435\u0448\u043D\u0435\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0438
        \u0438 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u043E\u043C \u0434\u043E\u0445\u043E\u0434\u043E\u0432
        \u0431\u044E\u0434\u0436\u0435\u0442\u0430. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[1].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        C \\n \u0420\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u044E\u0449\u0430\u044F
        \u0444\u0443\u043D\u043A\u0446\u0438\u044F \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0430
        \u043D\u0430 \u0437\u0430\u0449\u0438\u0442\u0443 \u043E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
        \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u0435\u0439
        \u043F\u0443\u0442\u0435\u043C \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u044F
        \u0432\u0432\u043E\u0437\u0430 \u0438\u043D\u043E\u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0445
        \u0442\u043E\u0432\u0430\u0440\u043E\u0432 \u0447\u0435\u0440\u0435\u0437
        \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435
        \u0432\u044B\u0441\u043E\u043A\u0438\u0445 \u043F\u043E\u0448\u043B\u0438\u043D.
        \u0424\u0438\u0441\u043A\u0430\u043B\u044C\u043D\u0430\u044F \u0444\u0443\u043D\u043A\u0446\u0438\u044F
        \u0441\u0432\u044F\u0437\u0430\u043D\u0430 \u0441 \u043F\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435\u043C
        \u0431\u044E\u0434\u0436\u0435\u0442\u0430. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[2].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        D \\n \u0418\u043C\u043F\u043E\u0440\u0442\u043D\u044B\u0435 \u043F\u043E\u0448\u043B\u0438\u043D\u044B
        \u0432\u0437\u0438\u043C\u0430\u044E\u0442\u0441\u044F \u043F\u0440\u0438
        \u0432\u0432\u043E\u0437\u0435 \u0442\u043E\u0432\u0430\u0440\u043E\u0432
        \u0432 \u0441\u0442\u0440\u0430\u043D\u0443 \u0438 \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
        \u043D\u0430\u0438\u0431\u043E\u043B\u0435\u0435 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u043D\u044B\u043C
