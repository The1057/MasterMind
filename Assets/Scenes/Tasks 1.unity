  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \u0426\u0435\u043F\u043E\u0447\u043A\u0430 \u043F\u043E\u0441\u0442\u0430\u0432\u043E\u043A
    (\u0438\u043B\u0438 \u0441\u043D\u0430\u0431\u0436\u0435\u043D\u0447\u0435\u0441\u043A\u0430\u044F
    \u0446\u0435\u043F\u044C) \u2013 \u044D\u0442\u043E \u043F\u0443\u0442\u044C,
    \n\u043F\u043E \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443 \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044F
    \u0441\u044B\u0440\u044C\u0451 \n\u0438 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B
    \u043E\u0442 \u043F\u043E\u0441\u0442\u0430\u0432\u0449\u0438\u043A\u0430 \u0434\u043E
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430, \u0430
    \u0437\u0430\u0442\u0435\u043C \u2013  \u0434\u043E \u0441\u043A\u043B\u0430\u0434\u0430
    \n\u0438 \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0433\u043E \u043F\u043E\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043B\u044F.
    \u042D\u0442\u043E \u043A\u043B\u044E\u0447\u0435\u0432\u043E\u0439 \u043F\u0440\u043E\u0446\u0435\u0441\u0441,
    \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u0439
    \u0431\u0435\u0441\u043F\u0435\u0440\u0435\u0431\u043E\u0439\u043D\u0443\u044E
    \u0440\u0430\u0431\u043E\u0442\u0443 \u043B\u044E\u0431\u043E\u0433\u043E \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u044F\r\n"
