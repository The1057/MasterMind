  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   \u041C\u043E\u0434\u0435\u043B\u044C \u043F\u0440\u043E\u0434\u0430\u0436
    \u2014 \u044D\u0442\u043E \u0441\u0438\u0441\u0442\u0435\u043C\u043D\u044B\u0439
    \u043F\u043E\u0434\u0445\u043E\u0434 \u043A \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0430 \u0440\u0435\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438
    \u0442\u043E\u0432\u0430\u0440\u043E\u0432/\u0443\u0441\u043B\u0443\u0433, \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u044E\u0449\u0438\u0439:\r\n\n>
    \u0426\u0435\u043B\u0435\u0432\u0443\u044E \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u044E\n\r\r>
    \u041A\u0430\u043D\u0430\u043B\u044B \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F\n>
    \u042D\u0442\u0430\u043F\u044B \u0441\u0434\u0435\u043B\u043A\u0438\n\r> \u041C\u0435\u0442\u043E\u0434\u044B
    \u043C\u043E\u043D\u0435\u0442\u0438\u0437\u0430\u0446\u0438\u0438\n\n  \u041F\u043E\u0447\u0435\u043C\u0443
    \u044D\u0442\u043E \u0432\u0430\u0436\u043D\u043E?  \n\r\n  \u0412\u044B\u0431\u043E\u0440
    \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0439 \u043C\u043E\u0434\u0435\u043B\u0438
    \u2014 \u043E\u0441\u043D\u043E\u0432\u043D\u0430\u044F \u043F\u0440\u0438\u0447\u0438\u043D\u0430
    82% \u043D\u0435\u0443\u0434\u0430\u0447 \u0441\u0442\u0430\u0440\u0442\u0430\u043F\u043E\u0432
    (\u043F\u043E \u0434\u0430\u043D\u043D\u044B\u043C CB Insights). \u041F\u0440\u0438\u043C\u0435\u0440:
    \u043F\u043E\u043F\u044B\u0442\u043A\u0430 \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u0442\u044C
    \u044D\u043B\u0438\u0442\u043D\u044B\u0439 B2B-\u0441\u043E\u0444\u0442 \u0447\u0435\u0440\u0435\u0437
    \u043C\u0430\u0441\u0441\u043E\u0432\u044B\u0435 B2C-\u043C\u0430\u0440\u043A\u0435\u0442\u043F\u043B\u0435\u0439\u0441\u044B.\r\n"
  m_isRightToLeft: 0
