--- !u!114 &1455214957
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1455214955}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\n\r\n> \u0414\u043B\u044F \u041E\u041E\u041E \u2014 \u0444\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438
    \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E, \u0434\u043B\u044F
    \u0418\u041F \u2014 \u0436\u0435\u043B\u0430\u0442\u0435\u043B\u044C\u043D\u043E.
    \u041E\u0442\u043A\u0440\u044B\u0442\u0438\u0435 \u0441\u0447\u0451\u0442\u0430
    \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u0434\u043B\u044F
    \u0431\u0435\u0437\u043D\u0430\u043B\u0438\u0447\u043D\u044B\u0445 \u0440\u0430\u0441\u0447\u0451\u0442\u043E\u0432,
    \u0443\u043F\u043B\u0430\u0442\u044B \u043D\u0430\u043B\u043E\u0433\u043E\u0432
    \u0438 \u0440\u0430\u0431\u043E\u0442\u044B \u0441 \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u0430\u043C\u0438.\n\n>
    \u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B: \u043F\u0430\u0441\u043F\u043E\u0440\u0442,
    \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u043E \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438, \u0443\u0441\u0442\u0430\u0432
    (\u0434\u043B\u044F \u041E\u041E\u041E), \u0431\u0430\u043D\u043A\u043E\u0432\u0441\u043A\u0430\u044F
    \u0444\u043E\u0440\u043C\u0430 \u043F\u043E\u0434\u043F\u0438\u0441\u0435\u0439
    \u0438\u043B\u0438 \u042D\u0426\u041F\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6d9ad1c49cfdf504faddd7afd3ceae86, type: 2}
