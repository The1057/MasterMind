        \u043A \u043F\u043E\u0434\u0430\u043A\u0446\u0438\u0437\u043D\u044B\u043C
        \u0442\u043E\u0432\u0430\u0440\u0430\u043C, \u0432\u043A\u043B\u044E\u0447\u0430\u044F
        \u0431\u0435\u043D\u0437\u0438\u043D, \u0430\u043B\u043A\u043E\u0433\u043E\u043B\u044C,
