  m_text: "   \n\n\u0417\u043E\u043B\u043E\u0442\u043E, \u0441\u0435\u0440\u0435\u0431\u0440\u043E,
    \u043F\u043B\u0430\u0442\u0438\u043D\u0430 \u0438 \u0434\u0440\u0443\u0433\u0438\u0435
    \u043C\u0435\u0442\u0430\u043B\u043B\u044B.\r\n> \u041F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0430
    \u2013 \u0437\u0430\u0449\u0438\u0442\u0430 \u043E\u0442 \u0438\u043D\u0444\u043B\u044F\u0446\u0438\u0438,
