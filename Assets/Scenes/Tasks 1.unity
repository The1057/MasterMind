      m_Calls: []
  m_text: "   \n\n1. \u041F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B
    \u2014 \u043E\u0431\u0441\u0443\u0436\u0434\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B
    \u0431\u0435\u0437 \u044D\u043C\u043E\u0446\u0438\u0439.  \r\r\r\r\n2. \u041C\u0435\u0434\u0438\u0430\u0446\u0438\u044F
    \u2014 \u043F\u0440\u0438\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0435 \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043F\u043E\u0441\u0440\u0435\u0434\u043D\u0438\u043A\u0430.\n3. \u041A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0435
    \u0442\u0440\u0435\u043D\u0438\u043D\u0433\u0438 \u2014 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435
    \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F. 
    \r\n\r4. \u0418\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u0440\u0430\u0431\u043E\u0447\u0438\u0445
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0432 \u2014 \u0435\u0441\u043B\u0438
    \u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442 \u0441\u0438\u0441\u0442\u0435\u043C\u043D\u044B\u0439.\n\r\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6d9ad1c49cfdf504faddd7afd3ceae86, type: 2}
