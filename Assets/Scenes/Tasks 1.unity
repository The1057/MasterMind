    \u0430 \u044D\u0442\u043E \u0437\u043D\u0430\u0447\u0438\u0442, \u0447\u0442\u043E
    \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F \u043F\u0440\u043E\u0441\u0438\u0434\u0435\u0442\u044C
    \u043D\u0430\u0434 \u043D\u0438\u043C\u0438 \u0434\u043E \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0439
    \u043D\u043E\u0447\u0438. \u0425\u043E\u0442\u044F \u043D\u0430\u0447\u0430\u043B\u044C\u0441\u0442\u0432\u043E
