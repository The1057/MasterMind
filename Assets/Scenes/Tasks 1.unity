  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "  \u0426\u0435\u043B\u0435\u0432\u043E\u0439 \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u0435\u0439
    (\u0426\u0410) \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u043B\u044E\u0434\u0435\u0439,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043C\u043E\u0433\u0443\u0442 \u043A\u0443\u043F\u0438\u0442\u044C
    \u0442\u043E\u0432\u0430\u0440. \u041C\u0435\u0442\u043E\u0434\u044B \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F
    \u0440\u044B\u043D\u043A\u0430 \u0432\u043A\u043B\u044E\u0447\u0430\u044E\u0442
    \u0430\u043D\u0430\u043B\u0438\u0437 \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u043E\u0432,
    \u043E\u043F\u0440\u043E\u0441\u044B, \u0442\u0435\u0441\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
    \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0430 \u0438 \u0430\u043D\u0430\u043B\u0438\u0437
    \u0434\u0430\u043D\u043D\u044B\u0445.\r\n"
