  m_text: "   \u0427\u0442\u043E \u0436\u0435 \u0434\u0430\u043B\u044C\u0448\u0435?
    \u0421\u043C\u043E\u0436\u0435\u0442\u0435 \u043B\u0438 \u0432\u044B \n\u0431\u0440\u043E\u0441\u0438\u0442\u044C
    \u0432\u044B\u0437\u043E\u0432 \u0433\u043E\u0440\u043E\u0434\u0443 \u043D\u0435\u043E\u043D\u043E\u0432\u044B\u0445
    \n\u043E\u0433\u043D\u0435\u0439 \u0438 \u0440\u0435\u0430\u043B\u0438\u0437\u043E\u0432\u0430\u0442\u044C
    \u043C\u0435\u0447\u0442\u0443? \n\n   \u041F\u0435\u0440\u0435\u0434 \u0432\u0430\u043C\u0438
    \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u0434\u0432\u0435\u0440\u0438
    \n\u0432 \u043C\u0438\u0440 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0435\u0439
    \u0438 \u0440\u0438\u0441\u043A\u043E\u0432, \u0433\u0434\u0435 \n\u043A\u0430\u0436\u0434\u044B\u0439
    \u0432\u0430\u0448 \u0448\u0430\u0433 \u0431\u0443\u0434\u0435\u0442 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0442\u044C
    \n\u0441\u0443\u0434\u044C\u0431\u0443 \u0433\u043E\u0440\u043E\u0434\u0430 \u0438
    \u0435\u0433\u043E \u0436\u0438\u0442\u0435\u043B\u0435\u0439. "
