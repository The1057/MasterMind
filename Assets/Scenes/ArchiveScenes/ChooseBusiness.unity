        \u043E\u0431\u044F\u0437\u0430\u043D\u0430 \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0442\u044C
        \u043E\u0442\u0447\u0451\u0442\u043D\u043E\u0441\u0442\u044C \u0434\u043B\u044F
        \u0430\u043A\u0446\u0438\u043E\u043D\u0435\u0440\u043E\u0432. "
