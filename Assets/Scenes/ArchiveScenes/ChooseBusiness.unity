        \u043D\u0430 \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u0435 \u0443\u0431\u044B\u0442\u043A\u043E\u0432
        \u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
        \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[1].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        A \\n  \u0423\u0432\u043E\u043B\u044C\u043D\u0435\u043D\u0438\u0435 \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442
        \u0437\u0430\u0442\u0440\u0430\u0442\u044B, \u043D\u043E \u043C\u043E\u0440\u0430\u043B\u044C
        \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0445\u0441\u044F \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432
        \u0441\u0442\u0440\u0430\u0434\u0430\u0435\u0442. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[2].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        D \\n \u0423\u0434\u0430\u043B\u0451\u043D\u043D\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430
        \u0441\u043D\u0438\u0436\u0430\u0435\u0442 \u0440\u0430\u0441\u0445\u043E\u0434\u044B,
        \u0445\u043E\u0442\u044F \u043C\u043E\u0440\u0430\u043B\u044C \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432
        \u043C\u043E\u0436\u0435\u0442 \u043D\u0435\u043C\u043D\u043E\u0433\u043E
        \u043F\u0430\u0434\u0430\u0442\u044C. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[3].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        A\\n   \u041E\u043F\u0442\u0438\u043C\u0438\u0437\u0430\u0446\u0438\u044F
        \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442 \u0442\u0440\u0430\u0442\u044B,
        \u043D\u0435 \u043D\u0430\u0440\u0443\u0448\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0443
        \u0431\u0438\u0437\u043D\u0435\u0441\u0430. . "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[4].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        C\\n \u041F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442
        \u0443\u043C\u0435\u043D\u044C\u0448\u0438\u0442\u044C \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u0443\u044E
        \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0443 \u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C
        \u0440\u0430\u0431\u043E\u0442\u0443 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[5].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n\u041F\u0435\u0440\u0435\u0432\u043E\u0434 \u0447\u0430\u0441\u0442\u0438
        \u0431\u0438\u0437\u043D\u0435\u0441\u0430 \u043D\u0430 \u043D\u043E\u0432\u044B\u0435
        \u0440\u044B\u043D\u043A\u0438 \u0438\u043B\u0438 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u044B
        \u0441\u043D\u0438\u0436\u0430\u0435\u0442 \u0440\u0438\u0441\u043A\u0438
        \u043F\u043E\u0442\u0435\u0440\u044C. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[6].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n\u0413\u043B\u0430\u0432\u043D\u0430\u044F \u0446\u0435\u043B\u044C
        \u043C\u0435\u0440 \u2013 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C
        \u0431\u0438\u0437\u043D\u0435\u0441 \u0436\u0438\u0432\u044B\u043C \u0432
        \u0441\u043B\u043E\u0436\u043D\u043E\u0439 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439
        \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[7].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n \u0421\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0438 \u043C\u043E\u0433\u0443\u0442
        \u0440\u0430\u0441\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0442\u044C\u0441\u044F
        \u0438\u0437-\u0437\u0430 \u0443\u0432\u043E\u043B\u044C\u043D\u0435\u043D\u0438\u0439
        \u0438\u043B\u0438 \u043D\u043E\u0432\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u0439
        \u0440\u0430\u0431\u043E\u0442\u044B. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[8].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        A \\n\u041A\u043B\u044E\u0447\u0435\u0432\u044B\u0435 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u044B
        \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0442
        \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u0443\u044E \u0440\u0430\u0431\u043E\u0442\u043E\u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C
