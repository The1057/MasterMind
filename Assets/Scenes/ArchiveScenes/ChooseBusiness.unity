    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[0].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B\\n  \u041F\u0430\u0441\u0441\u0438\u0432\u043D\u044B\u0439 \u0434\u043E\u0445\u043E\u0434
        \u043F\u043E\u0441\u0442\u0443\u043F\u0430\u0435\u0442 \u043E\u0442 \u0432\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0445
        \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u0438\u043B\u0438 \u0430\u043A\u0442\u0438\u0432\u043E\u0432,
        \u0430 \u043D\u0435 \u043E\u0442 \u0440\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u043E\u0439
        \u0440\u0430\u0431\u043E\u0442\u044B. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[1].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        C \\n\u0414\u0438\u0432\u0438\u0434\u0435\u043D\u0434\u044B \u0432\u044B\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F
        \u0440\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u043E \u0430\u043A\u0446\u0438\u043E\u043D\u0435\u0440\u0430\u043C
        \u0438 \u043E\u0442\u043D\u043E\u0441\u044F\u0442\u0441\u044F \u043A \u043F\u0430\u0441\u0441\u0438\u0432\u043D\u043E\u043C\u0443
        \u0434\u043E\u0445\u043E\u0434\u0443. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[2].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        A \\n ETF (Exchange Traded Fund) \u2014 \u044D\u0442\u043E \u0431\u0438\u0440\u0436\u0435\u0432\u043E\u0439
        \u0444\u043E\u043D\u0434, \u0432 \u043A\u043E\u0442\u043E\u0440\u044B\u0439
        \u0432\u0445\u043E\u0434\u044F\u0442 \u0430\u043A\u0446\u0438\u0438 \u0438\u043B\u0438
        \u043E\u0431\u043B\u0438\u0433\u0430\u0446\u0438\u0438. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[3].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        A\\n  free-float \u2013 \u044D\u0442\u043E \u0434\u043E\u043B\u044F \u0430\u043A\u0446\u0438\u0439,
        \u043D\u0430\u0445\u043E\u0434\u044F\u0449\u0438\u0445\u0441\u044F \u0432
        \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u043C \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u0438. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[4].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B\\n ETF \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C
        \u0440\u0438\u0441\u043A\u0438, \u0438\u043D\u0432\u0435\u0441\u0442\u0438\u0440\u0443\u044F
        \u0441\u0440\u0430\u0437\u0443 \u0432 \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E
        \u0430\u043A\u0442\u0438\u0432\u043E\u0432. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[5].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        C \\n \u0424\u043E\u043D\u0434\u044B \u0437\u0430\u0432\u0438\u0441\u044F\u0442
        \u043E\u0442 \u0440\u044B\u043D\u043E\u0447\u043D\u043E\u0439 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438,
        \u0438 \u043F\u0440\u0438 \u043F\u0430\u0434\u0435\u043D\u0438\u0438 \u0440\u044B\u043D\u043A\u0430
