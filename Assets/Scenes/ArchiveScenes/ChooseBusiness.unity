    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[0].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B\\n  \u0420\u0435\u043D\u0442\u0430 \u2013 \u044D\u0442\u043E \u0434\u043E\u0445\u043E\u0434,
        \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u043C\u044B\u0439 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A\u043E\u043C
        \u043D\u0435\u0434\u0432\u0438\u0436\u0438\u043C\u043E\u0441\u0442\u0438
        \u043E\u0442 \u0441\u0434\u0430\u0447\u0438 \u0435\u0451 \u0432 \u0430\u0440\u0435\u043D\u0434\u0443. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[1].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n\u041A\u043E\u043C\u043C\u0435\u0440\u0447\u0435\u0441\u043A\u0430\u044F
        \u043D\u0435\u0434\u0432\u0438\u0436\u0438\u043C\u043E\u0441\u0442\u044C
        \u2013 \u044D\u0442\u043E \u043E\u0431\u044A\u0435\u043A\u0442\u044B, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C\u044B\u0435
        \u0434\u043B\u044F \u0431\u0438\u0437\u043D\u0435\u0441\u0430: \u043E\u0444\u0438\u0441\u044B,
        \u0441\u043A\u043B\u0430\u0434\u044B, \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u044B. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[2].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n \u041A\u043E\u0433\u0434\u0430 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0430
        \u0440\u0430\u0441\u0442\u0451\u0442, \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438
        \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u0438
        \u0430\u0440\u0435\u043D\u0434\u0443\u044E\u0442 \u0431\u043E\u043B\u044C\u0448\u0435
        \u043F\u043B\u043E\u0449\u0430\u0434\u0435\u0439, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
        \u0430\u0440\u0435\u043D\u0434\u043D\u044B\u0435 \u0441\u0442\u0430\u0432\u043A\u0438
        \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[3].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        A\\n  \u041D\u0435\u0434\u0432\u0438\u0436\u0438\u043C\u043E\u0441\u0442\u044C
        \u0438\u043C\u0435\u0435\u0442 \u043D\u0438\u0437\u043A\u0443\u044E \u043B\u0438\u043A\u0432\u0438\u0434\u043D\u043E\u0441\u0442\u044C,
        \u043F\u0440\u043E\u0434\u0430\u0436\u0430 \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442
        \u043C\u043D\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[4].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B\\n \u0415\u0441\u043B\u0438 \u0430\u0440\u0435\u043D\u0434\u0430\u0442\u043E\u0440\u043E\u0432
