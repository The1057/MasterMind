    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[0].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        A\\n  \u041B\u043E\u043A\u0430\u043B\u044C\u043D\u044B\u0435 \u0441\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430
        \u2013 \u044D\u0442\u043E \u0436\u0438\u0442\u0435\u043B\u0438 \u0438 \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u044B
        \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E\u0439
        \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
        \u043C\u0438\u043A\u0440\u043E\u0440\u0430\u0439\u043E\u043D\u0430 \u0438\u043B\u0438
        \u0440\u0430\u0439\u043E\u043D\u0430. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[1].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        C \\n  \u041D\u0430\u0439\u043C \u0436\u0438\u0442\u0435\u043B\u0435\u0439
        \u0438\u0437 \u043D\u0435\u0431\u043B\u0430\u0433\u043E\u043F\u043E\u043B\u0443\u0447\u043D\u044B\u0445
        \u0440\u0430\u0439\u043E\u043D\u043E\u0432 \u2013 \u043F\u0440\u044F\u043C\u0430\u044F
        \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u0430\u044F \u043F\u043E\u043C\u043E\u0449\u044C
        \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[2].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n \u0413\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u043E
        \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
        \u0441\u0443\u0431\u0441\u0438\u0434\u0438\u0438 \u0440\u0430\u0431\u043E\u0442\u043E\u0434\u0430\u0442\u0435\u043B\u044F\u043C
        \u0437\u0430 \u0442\u0440\u0443\u0434\u043E\u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E
        \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0445 \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u0439
        \u0433\u0440\u0430\u0436\u0434\u0430\u043D. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[3].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
