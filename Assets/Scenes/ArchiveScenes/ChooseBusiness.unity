    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[8].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        A \\n \u0411\u0435\u0437 \u043E\u0442\u0447\u0451\u0442\u043D\u043E\u0441\u0442\u0438
        \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u043C\u043E\u0433\u0443\u0442
        \u0431\u044B\u0442\u044C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u044B
        \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E, \u0441\u043D\u0438\u0437\u0438\u0442\u0441\u044F
        \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C
        \u0438 \u0434\u043E\u0432\u0435\u0440\u0438\u0435 \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u044F. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[9].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n  \u0417\u0430 \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u0443\u044E
        \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C \u0431\u0438\u0437\u043D\u0435\u0441
        \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 \u043F\u0440\u0435\u0444\u0435\u0440\u0435\u043D\u0446\u0438\u0438
        \u0438 \u0443\u043A\u0440\u0435\u043F\u043B\u044F\u0435\u0442 \u0434\u043E\u0432\u0435\u0440\u0438\u0435
        \u043D\u0430 \u043C\u0435\u0441\u0442\u0430\u0445. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[0].question
      value: "\u0427\u0442\u043E \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442
        \xAB\u043B\u043E\u043A\u0430\u043B\u044C\u043D\u044B\u0435 \u0441\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430\xBB
