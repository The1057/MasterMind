    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[6].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        C \\n\u0427\u0430\u0441\u0442\u043E \u0441\u0443\u0431\u0441\u0438\u0434\u0438\u0438
        \u0432\u044B\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F
        \u043F\u043E\u044D\u0442\u0430\u043F\u043D\u043E \u043F\u043E\u0441\u043B\u0435
        \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u044F,
        \u0447\u0442\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
        \u043D\u0430 \u043F\u0440\u043E\u0442\u044F\u0436\u0435\u043D\u0438\u0438
        \u0437\u0430\u0434\u0430\u043D\u043D\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[7].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n\u0421\u0443\u0431\u0441\u0438\u0434\u0438\u0438 \u0432\u044B\u0434\u0430\u044E\u0442\u0441\u044F
        \u0440\u0430\u0431\u043E\u0442\u043E\u0434\u0430\u0442\u0435\u043B\u044F\u043C
        (\u044E\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043B\u0438\u0446\u0430\u043C
        \u0438 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u044F\u043C),
        \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043D\u0430\u043D\u0438\u043C\u0430\u044E\u0442
        \u0433\u0440\u0430\u0436\u0434\u0430\u043D \u0438\u0437 \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445
