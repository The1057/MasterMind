    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[0].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        D \\n4P (\u043C\u0430\u0440\u043A\u0435\u0442\u0438\u043D\u0433\u043E\u0432\u044B\u0439
        \u043C\u0438\u043A\u0441) \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442:
        \\nProduct (\u041F\u0440\u043E\u0434\u0443\u043A\u0442) \u2013 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E,
        \u0443\u043F\u0430\u043A\u043E\u0432\u043A\u0430, \u0431\u0440\u0435\u043D\u0434.  
        \\nPrice (\u0426\u0435\u043D\u0430) \u2013 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0438
        \u0446\u0435\u043D\u043E\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044F.  
        \\nPlace (\u041C\u0435\u0441\u0442\u043E \u043F\u0440\u043E\u0434\u0430\u0436)
        \u2013 \u0433\u0434\u0435 \u043F\u0440\u043E\u0434\u0430\u0451\u0442\u0441\u044F
        \u0442\u043E\u0432\u0430\u0440 (\u043C\u0430\u0433\u0430\u0437\u0438\u043D\u044B,
        \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442).   \\nPromotion (\u041F\u0440\u043E\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435)
        \u2013 \u0440\u0435\u043A\u043B\u0430\u043C\u0430, \u0430\u043A\u0446\u0438\u0438,
        PR."
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[1].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        A \\n\u041C\u043E\u0434\u0435\u043B\u044C 7P \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
        \u0432 \u0441\u0435\u0440\u0432\u0438\u0441\u043D\u043E\u043C \u043C\u0430\u0440\u043A\u0435\u0442\u0438\u043D\u0433\u0435:
        \\nPeople (\u041B\u044E\u0434\u0438) \u2013 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B,
        \u043A\u043B\u0438\u0435\u043D\u0442\u0441\u043A\u0438\u0439 \u0441\u0435\u0440\u0432\u0438\u0441.  
        \\nProcess (\u041F\u0440\u043E\u0446\u0435\u0441\u0441) \u2013 \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
        \u0441 \u043A\u043B\u0438\u0435\u043D\u0442\u0430\u043C\u0438.   \\nPhysical
        Evidence (\u0424\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u0435)
        \u2013 \u043E\u0444\u043E\u0440\u043C\u043B\u0435\u043D\u0438\u0435 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u043E\u0432,
        \u0443\u043F\u0430\u043A\u043E\u0432\u043A\u0430, \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0430. "
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[2].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n\u041E\u043F\u0440\u043E\u0441\u044B \u0438 \u0438\u043D\u0442\u0435\u0440\u0432\u044C\u044E
        \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442 \u0443\u0437\u043D\u0430\u0442\u044C
        \u043C\u043D\u0435\u043D\u0438\u044F \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432
        \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E, \u0432 \u043E\u0442\u043B\u0438\u0447\u0438\u0435
        \u043E\u0442 \u0430\u043D\u0430\u043B\u0438\u0437\u0430 \u0434\u0430\u043D\u043D\u044B\u0445
        \u0438\u043B\u0438 \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0439"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[3].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B\\n\u041C\u0430\u0441\u0441\u043E\u0432\u044B\u0439 \u043C\u0430\u0440\u043A\u0435\u0442\u0438\u043D\u0433
        \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u0439
        \u043F\u0440\u043E\u0434\u0443\u043A\u0442 \u0431\u0435\u0437 \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u043E\u0433\u043E
        \u043F\u043E\u0434\u0445\u043E\u0434\u0430 (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
        Coca-Cola, McDonald's)"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[4].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        A \\n\u041D\u0430\u0442\u0438\u0432\u043D\u0430\u044F \u0440\u0435\u043A\u043B\u0430\u043C\u0430
        \u043C\u0430\u0441\u043A\u0438\u0440\u0443\u0435\u0442\u0441\u044F \u043F\u043E\u0434
        \u043E\u0440\u0433\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439
        \u043A\u043E\u043D\u0442\u0435\u043D\u0442 (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
        \u0440\u0435\u043A\u043B\u0430\u043C\u043D\u044B\u0435 \u0441\u0442\u0430\u0442\u044C\u0438,
        \u0438\u043D\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u0438 \u0443 \u0431\u043B\u043E\u0433\u0435\u0440\u043E\u0432)"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[5].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\n\u041A\u043E\u043D\u0442\u0435\u043A\u0441\u0442\u043D\u0430\u044F \u0440\u0435\u043A\u043B\u0430\u043C\u0430
        (Google Ads, \u042F\u043D\u0434\u0435\u043A\u0441.\u0414\u0438\u0440\u0435\u043A\u0442)
        \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
        \u043F\u043E \u0440\u0435\u043B\u0435\u0432\u0430\u043D\u0442\u043D\u044B\u043C
        \u0437\u0430\u043F\u0440\u043E\u0441\u0430\u043C \u0432 \u043F\u043E\u0438\u0441\u043A\u043E\u0432\u044B\u0445
        \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0445"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[6].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        C \\nCTR (Click-Through Rate) = (\u0427\u0438\u0441\u043B\u043E \u043A\u043B\u0438\u043A\u043E\u0432
        / \u0427\u0438\u0441\u043B\u043E \u043F\u043E\u043A\u0430\u0437\u043E\u0432)
        \xD7 100%"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[7].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        C \\n\u041D\u0438\u0448\u0435\u0432\u043E\u0439 \u043C\u0430\u0440\u043A\u0435\u0442\u0438\u043D\u0433
        \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D
        \u043D\u0430 \u0441\u043F\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043A\u0443\u044E
        \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u044E, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
        \u0442\u043E\u0432\u0430\u0440\u044B \u0434\u043B\u044F \u0432\u0435\u0433\u0430\u043D\u043E\u0432
        \u0438\u043B\u0438 \u043B\u044E\u043A\u0441\u043E\u0432\u044B\u0435 \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u0438"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[8].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        C \\nEmail-\u043C\u0430\u0440\u043A\u0435\u0442\u0438\u043D\u0433 \u2013
        \u044D\u0442\u043E \u0440\u0430\u0441\u0441\u044B\u043B\u043A\u0438 \u0441
        \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C\u0438
        \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F\u043C\u0438,
        \u043D\u043E\u0432\u043E\u0441\u0442\u044F\u043C\u0438 \u0438 \u0430\u043A\u0446\u0438\u044F\u043C\u0438"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[9].comment
      value: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
        B \\nSEO (Search Engine Optimization) \u2013 \u044D\u0442\u043E \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435
        \u0441\u0430\u0439\u0442\u0430 \u0434\u043B\u044F \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u044F
        \u0435\u0433\u043E \u043F\u043E\u0437\u0438\u0446\u0438\u0439 \u0432 \u043F\u043E\u0438\u0441\u043A\u043E\u0432\u043E\u0439
        \u0432\u044B\u0434\u0430\u0447\u0435 \u0431\u0435\u0437 \u043F\u043B\u0430\u0442\u043D\u043E\u0439
        \u0440\u0435\u043A\u043B\u0430\u043C\u044B"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[0].question
      value: "\u0427\u0442\u043E \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
        \u0441\u043E\u0431\u043E\u0439 \u043A\u043E\u043D\u0446\u0435\u043F\u0446\u0438\u044F
        4P \u0432 \u043C\u0430\u0440\u043A\u0435\u0442\u0438\u043D\u0433\u0435?"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[1].question
      value: "\u041A\u0430\u043A\u0430\u044F \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
        \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0449\u0430\u044F
        \u0431\u044B\u043B\u0430 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0430
        \u0432 \u043C\u043E\u0434\u0435\u043B\u044C 4P, \u0447\u0442\u043E\u0431\u044B
        \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C 7P?"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[2].question
      value: "\u041A\u0430\u043A\u043E\u0439 \u043C\u0435\u0442\u043E\u0434 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F
        \u0440\u044B\u043D\u043A\u0430 \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442
        \u0432 \u0441\u0435\u0431\u044F \u0441\u0431\u043E\u0440 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438
        \u043E \u043F\u043E\u0442\u0440\u0435\u0431\u043D\u043E\u0441\u0442\u044F\u0445
        \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432 \u0447\u0435\u0440\u0435\u0437
        \u0432\u043E\u043F\u0440\u043E\u0441\u044B?"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[3].question
      value: "\u041A\u0430\u043A\u043E\u0439 \u0442\u0438\u043F \u043C\u0430\u0440\u043A\u0435\u0442\u0438\u043D\u0433\u0430
        \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442
        \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u043E\u0434\u043D\u043E\u0433\u043E
        \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0430 \u0434\u043B\u044F \u0432\u0441\u0435\u0445
        \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432?"
      objectReference: {fileID: 0}
    - target: {fileID: 6781455834936813664, guid: bc7180ca5052fba4ebb672319aa3bce8, type: 3}
      propertyPath: questions.Array.data[4].question
      value: "\u0427\u0442\u043E \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
        \u0441\u043E\u0431\u043E\u0439 \u043D\u0430\u0442\u0438\u0432\u043D\u0430\u044F
