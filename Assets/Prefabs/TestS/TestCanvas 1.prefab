      \u043D\u0430\u043B\u043E\u0433 \u043D\u0430 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439
      \u0434\u043E\u0445\u043E\u0434 (\u041D\u041F\u0414) \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438
      \u043E\u0442 \u0432\u0438\u0434\u0430 \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
      \u0438 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044F
      \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u043C"
    isAnswered: 0
    playerSelectedIndices: 
  - question: "\u0427\u0442\u043E \u0442\u0430\u043A\u043E\u0435 \u044E\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043A\u043E\u0435
      \u043B\u0438\u0446\u043E"
    type: 0
    answers:
    - "A. \u041E\u0431\u044B\u0447\u043D\u044B\u0439 \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0438\u043D,
      \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440 \u0441\u0442\u0443\u0434\u0435\u043D\u0442
      \u0438\u043B\u0438 \u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A"
    - "B. \u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u044F, \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0430\u044F
      \u043A\u0430\u043A \u0435\u0434\u0438\u043D\u044B\u0439 \u0441\u0443\u0431\u044A\u0435\u043A\u0442
      \u043F\u0440\u0430\u0432\u0430"
    - "C. \u0413\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
      \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0430"
    - "D. \u0427\u0430\u0441\u0442\u043D\u044B\u0439 \u0438\u043D\u0432\u0435\u0441\u0442\u043E\u0440"
    correctAnswerIndex: 01000000
    correctAnswer: B
    comment: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
      B \\n\u042E\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u043B\u0438\u0446\u043E
      \u2014 \u044D\u0442\u043E \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u044F,
      \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F
      \u0432 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u043E\u043C
      \u043F\u043E\u0440\u044F\u0434\u043A\u0435 \u0438 \u0438\u043C\u0435\u044E\u0449\u0430\u044F
      \u043F\u0440\u0430\u0432\u043E \u0432\u0435\u0441\u0442\u0438 \u0431\u0438\u0437\u043D\u0435\u0441,
      \u0437\u0430\u043A\u043B\u044E\u0447\u0430\u0442\u044C \u0441\u0434\u0435\u043B\u043A\u0438
      \u0438 \u043D\u0435\u0441\u0442\u0438 \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C
      \u043F\u043E \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430\u043C"
    isAnswered: 0
    playerSelectedIndices: 
  - question: "\u041A\u0430\u043A \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0444\u043E\u0440\u043C\u0430 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438
      \u0431\u0438\u0437\u043D\u0435\u0441\u0430, \u043F\u0440\u0438 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C
      \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u043E\u0432 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0430
      \u0441\u0443\u043C\u043C\u043E\u0439 \u0432\u043B\u043E\u0436\u0435\u043D\u043D\u043E\u0433\u043E
      \u043A\u0430\u043F\u0438\u0442\u0430\u043B\u0430?"
    type: 0
    answers:
    - "A. \u041F\u043E\u043B\u043D\u043E\u0435 \u0442\u043E\u0432\u0430\u0440\u0438\u0449\u0435\u0441\u0442\u0432\u043E"
    - "B. \u041A\u043E\u043C\u043C\u0430\u043D\u0434\u0438\u0442\u043D\u043E\u0435
      \u0442\u043E\u0432\u0430\u0440\u0438\u0449\u0435\u0441\u0442\u0432\u043E"
    - "C. \u0410\u043A\u0446\u0438\u043E\u043D\u0435\u0440\u043D\u043E\u0435 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u043E"
    - "D. \u041E\u0431\u0449\u0435\u0441\u0442\u0432\u043E \u0441 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u043E\u0439
      \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C\u044E"
    correctAnswerIndex: 03000000
    correctAnswer: D
    comment: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
      D \\n\u0412 \u041E\u041E\u041E \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C
      \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u043E\u0432 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0438\u0445 \u0432\u043A\u043B\u0430\u0434\u043E\u043C \u0432 \u0443\u0441\u0442\u0430\u0432\u043D\u044B\u0439
      \u043A\u0430\u043F\u0438\u0442\u0430\u043B, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u043E\u043D\u0438 \u043D\u0435 \u0440\u0438\u0441\u043A\u0443\u044E\u0442
      \u043B\u0438\u0447\u043D\u044B\u043C \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u043C,
      \u043A\u0430\u043A \u0432 \u0441\u043B\u0443\u0447\u0430\u0435 \u0441 \u0418\u041F"
    isAnswered: 0
    playerSelectedIndices: 
  - question: "\u0427\u0442\u043E \u0438\u0437 \u043F\u0435\u0440\u0435\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u043E\u0433\u043E
      \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u043A \u043F\u0440\u0438\u0437\u043D\u0430\u043A\u0430\u043C
      \u044E\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u043B\u0438\u0446\u0430?"
    type: 0
    answers:
    - "A. \u041D\u0430\u043B\u0438\u0447\u0438\u0435 \u043E\u0431\u043E\u0441\u043E\u0431\u043B\u0435\u043D\u043D\u043E\u0433\u043E
      \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0430"
    - "B. \u041D\u0430\u043B\u0438\u0447\u0438\u0435 \u0431\u0430\u043D\u043A\u043E\u0432\u0441\u043A\u043E\u0433\u043E
      \u0441\u0447\u0435\u0442\u0430"
    - "C. \u041D\u0430\u043B\u0438\u0447\u0438\u0435 \u0442\u0440\u0443\u0434\u043E\u0432\u043E\u0433\u043E
      \u0441\u0442\u0430\u0436\u0430"
    - "D. \u041D\u0430\u043B\u0438\u0447\u0438\u0435 \u0432\u044B\u0441\u0448\u0435\u0433\u043E
      \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044F"
    correctAnswerIndex: 00000000
    correctAnswer: A
    comment: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
      A \\n\u041A \u043F\u0440\u0438\u0437\u043D\u0430\u043A\u0430\u043C \u044E\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
      \u043B\u0438\u0446\u0430 \u043E\u0442\u043D\u043E\u0441\u044F\u0442\u0441\u044F
      \u043D\u0430\u043B\u0438\u0447\u0438\u0435 \u043E\u0431\u043E\u0441\u043E\u0431\u043B\u0435\u043D\u043D\u043E\u0433\u043E
      \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0430, \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0435
      \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u043E (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
      \u0443\u0441\u0442\u0430\u0432), \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C
      \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u0442\u044C \u043E\u0442 \u0441\u0432\u043E\u0435\u0433\u043E
      \u0438\u043C\u0435\u043D\u0438 \u0438 \u043D\u0435\u0441\u0442\u0438 \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C
      \u043F\u043E \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430\u043C
      (\u0441\u0442. 48 \u0413\u041A \u0420\u0424)"
    isAnswered: 0
