--- !u!114 &5385328094639426557
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5786852055866148578}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d55f5c518853ddf46b250b913986e217, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sessionScore:
    score: 0
    errorCount: 0
  questions:
  - question: "\u041A\u0430\u043A\u043E\u0435 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u0435
      \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442
      \u043F\u043E\u043D\u044F\u0442\u0438\u044E \"\u043F\u0440\u0435\u0434\u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E\"?"
    type: 0
    answers:
    - "A. \u0417\u0430\u043D\u044F\u0442\u0438\u0435 \u0431\u0438\u0437\u043D\u0435\u0441\u043E\u043C
      \u0440\u0430\u0434\u0438 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F
      \u0434\u043E\u0445\u043E\u0434\u0430"
    - "B. \u0421\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u0430\u044F
      \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C, \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u0430\u044F
      \u0441 \u043F\u0440\u0438\u043D\u044F\u0442\u0438\u0435\u043C \u0440\u0438\u0441\u043A\u043E\u0432
      \u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u0430\u044F
      \u043D\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435
      \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0435 \u043F\u0440\u0438\u0431\u044B\u043B\u0438"
    - "C. \u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043A\u0440\u0443\u043F\u043D\u043E\u0439
      \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0435\u0439"
    - "D. \u041E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u0430\u044F \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044F
      \u0431\u0438\u0437\u043D\u0435\u0441\u0430"
    correctAnswerIndex: 
    correctAnswer: B
    comment: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
      B \\n\u041F\u0440\u0435\u0434\u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
      \u2014 \u044D\u0442\u043E \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C,
      \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u0430\u044F \u0441 \u0432\u0435\u0434\u0435\u043D\u0438\u0435\u043C
      \u0431\u0438\u0437\u043D\u0435\u0441\u0430, \u0432\u043A\u043B\u044E\u0447\u0430\u044E\u0449\u0430\u044F
      \u0440\u0438\u0441\u043A\u0438 \u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u0430\u044F
      \u043D\u0430 \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u0435 \u043F\u0440\u0438\u0431\u044B\u043B\u0438
      \u0438 \u0440\u043E\u0441\u0442\u0430. \u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0435\u0439 \u043D\u0435
      \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0441\u0438\u043D\u043E\u043D\u0438\u043C\u043E\u043C
      \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430,
      \u0442\u0430\u043A \u043A\u0430\u043A \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C
      \u043C\u043E\u0436\u0435\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
      \u0438 \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0443"
  - question: "\u041A\u0442\u043E \u0442\u0430\u043A\u043E\u0439 \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u044B\u0439
      \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C
      (\u0418\u041F)?"
    type: 0
    answers:
    - "A. \u0427\u0435\u043B\u043E\u0432\u0435\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442 \u043A\u0440\u0443\u043F\u043D\u044B\u043C
      \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u0435\u043C"
    - "B. \u041B\u0438\u0446\u043E, \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0432\u0435\u0434\u0435\u0442
      \u0431\u0438\u0437\u043D\u0435\u0441 \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E,
      \u043E\u0442\u0432\u0435\u0447\u0430\u044F \u0441\u0432\u043E\u0438\u043C \u043B\u0438\u0447\u043D\u044B\u043C
      \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u043C"
    - "C. \u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u044F, \u0438\u043C\u0435\u044E\u0449\u0430\u044F
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0435\u0432"
    - "D. \u0420\u0430\u0431\u043E\u0442\u043D\u0438\u043A, \u043D\u0430\u043D\u044F\u0442\u044B\u0439
      \u0434\u0440\u0443\u0433\u0438\u043C \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u0435\u043C"
    correctAnswerIndex: 
    correctAnswer: B
    comment: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
      B \\n\u0418\u041F \u2014 \u044D\u0442\u043E \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0435
      \u043B\u0438\u0446\u043E, \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0435
      \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044F.
      \u041E\u043D \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u0431\u0435\u0437
      \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u044E\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
      \u043B\u0438\u0446\u0430 \u0438 \u043D\u0435\u0441\u0435\u0442 \u043F\u043E\u043B\u043D\u0443\u044E
      \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E
      \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C"
  - question: "\u041A\u0430\u043A\u0438\u0435 \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0435
      \u043E\u0442\u043B\u0438\u0447\u0438\u044F \u043C\u0435\u0436\u0434\u0443 \u0418\u041F
      \u0438 \u041E\u041E\u041E \u0432 \u0447\u0430\u0441\u0442\u0438 \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u0438?"
    type: 0
    answers:
    - "A. \u0418\u041F \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0443\u0441\u0442\u0430\u0432\u043D\u044B\u043C \u043A\u0430\u043F\u0438\u0442\u0430\u043B\u043E\u043C,
      \u0430 \u041E\u041E\u041E - \u0441\u0432\u043E\u0438\u043C \u043B\u0438\u0447\u043D\u044B\u043C
      \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u043C"
    - "B. \u0418\u041F \u0438 \u041E\u041E\u041E \u043D\u0435\u0441\u0443\u0442 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u0443\u044E
      \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C
      \u0437\u0430 \u0434\u043E\u043B\u0433\u0438 \u0438 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
      \u0431\u0438\u0437\u043D\u0435\u0441\u0430"
    - "C. \u0418\u041F \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u0441\u0432\u043E\u0438\u043C
      \u043B\u0438\u0447\u043D\u044B\u043C \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u043C,
      \u0430 \u041E\u041E\u041E - \u0442\u043E\u043B\u044C\u043A\u043E \u0443\u0441\u0442\u0430\u0432\u043D\u044B\u043C
      \u043A\u0430\u043F\u0438\u0442\u0430\u043B\u043E\u043C"
    - "D. \u041E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C
      \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442\u0441\u044F \u0438\u0441\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u043E\u043C \u0430\u0440\u0435\u043D\u0434\u044B
      \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F"
    correctAnswerIndex: 
    correctAnswer: C
    comment: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442:
      C\\n\u0418\u041F \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u0432\u0441\u0435\u043C
      \u0441\u0432\u043E\u0438\u043C \u043B\u0438\u0447\u043D\u044B\u043C \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u043C,
      \u0430 \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u0438 \u041E\u041E\u041E,
      \u043A\u0430\u043A \u043F\u0440\u0430\u0432\u0438\u043B\u043E, \u043D\u0435\u0441\u0443\u0442
      \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C
      \u0432 \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u0445 \u0441\u0432\u043E\u0438\u0445
      \u0432\u043A\u043B\u0430\u0434\u043E\u0432 \u0432 \u0443\u0441\u0442\u0430\u0432\u043D\u044B\u0439
      \u043A\u0430\u043F\u0438\u0442\u0430\u043B, \u0437\u0430 \u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435\u043C
      \u0441\u043B\u0443\u0447\u0430\u0435\u0432 \u0441\u0443\u0431\u0441\u0438\u0434\u0438\u0430\u0440\u043D\u043E\u0439
      \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u0438
      \u043F\u0440\u0438 \u0431\u0430\u043D\u043A\u0440\u043E\u0442\u0441\u0442\u0432\u0435"
  - question: "\u041A\u0430\u043A\u043E\u0439 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442
      \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C \u0434\u043B\u044F \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438
