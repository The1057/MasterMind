--- !u!114 &1054811569972987870
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 557964122734769325}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c5db3f12ed0865b41a5bc78e8b17ca1b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Notes: "\u041F\u043E\u043C\u0435\u0441\u0442\u0438\u0442\u044C \u043D\u0430 \u043F\u043E\u043B\u043E\u0442\u043D\u043E.\n\u0412
    \u043F\u0440\u0435\u0444\u0430\u0431\u0435 \u0441\u0435\u0442\u043A\u0430 11\u04454
    \u0438\u0437 \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u043E\u0432
    200\u0445200, \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u044B \u043C\u043E\u0436\u043D\u043E
    \u0443\u0431\u0440\u0430\u0442\u044C, \u043D\u043E\u0432\u044B\u0435 \u043F\u043E\u043C\u0435\u0449\u0430\u0442\u044C
    \u043A\u0430\u043A \u0434\u043E\u0447\u0435\u0440\u043D\u0438\u0435 \u043E\u0431\u044A\u0435\u043A\u0442\u044B
    Card Manager.\n\u0427\u0442\u043E\u0431\u044B \u043C\u0435\u043D\u044F\u0442\u044C
    \u0448\u0438\u0440\u0438\u043D\u0443 \u0441\u0435\u0442\u043A\u0438 - \u043C\u0435\u043D\u044F\u0442\u044C
    \u0448\u0438\u0440\u0438\u043D\u0443 Rect Transform, \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B
    \u044F\u0447\u0435\u0439\u043A\u0438 \u0432 Grid Layout.\n\u0427\u0442\u043E\u0431\u044B
    \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u044B
    \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E \u0441\u0442\u043E\u044F\u0449\u0438\u043C\u0438
    - \u0443\u0431\u0440\u0430\u0442\u044C \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442
    Grid Layout Group."
