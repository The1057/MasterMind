  m_Script: {fileID: 11500000, guid: c5db3f12ed0865b41a5bc78e8b17ca1b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Notes: "\u041F\u043E\u043C\u0435\u0441\u0442\u0438\u0442\u044C \u043D\u0430 \u043F\u043E\u043B\u043E\u0442\u043D\u043E
    \u043A\u0430\u043A \u0434\u043E\u0447\u0435\u0440\u043D\u0438\u0439 \u043E\u0431\u044A\u0435\u043A\u0442
    Card Manager.\n\u0412\u043C\u0435\u0441\u0442\u0435 \u0441 \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u043C
    \u043C\u0435\u043D\u044F\u0442\u044C \u0440\u0430\u0437\u043C\u0435\u0440 Grid
    Layout Group.\n\u041D\u0438 \u0432 \u043A\u043E\u0435\u043C \u0441\u043B\u0443\u0447\u0430\u0435
    \u043D\u0435 \u0432\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0443 Image
    Raycast Target, \u0435\u0441\u043B\u0438 \u043D\u0430\u0434\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C
    \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0443 \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u043E\u0439
    - \u043C\u0435\u043D\u044F\u0442\u044C \u0430\u043B\u044C\u0444\u0430 \u043A\u0430\u043D\u0430\u043B
    \u0446\u0432\u0435\u0442\u0430.\n\u0414\u043B\u044F \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F
    \u0441\u043F\u0430\u0432\u043D\u044F\u0449\u0435\u0439\u0441\u044F \u043A\u0430\u0440\u0442\u044B
    \u043C\u0435\u043D\u044F\u0442\u044C Spawn Card."
